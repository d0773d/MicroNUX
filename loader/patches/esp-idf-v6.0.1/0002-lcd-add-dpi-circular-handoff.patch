From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MicroNUX <micronux@example.invalid>
Date: Sun, 9 Aug 2026 00:00:00 -0700
Subject: [PATCH] esp_lcd: add circular-ring DPI ownership handoff

Allow a boot loader to quiesce the interrupt-restarted DSI transfer, replace
it with a four-descriptor circular ring, and publish its resources before
transferring ownership to an operating system. The returned addresses let the
next owner program a narrow DMA-PMS policy instead of granting the channel
access to all memory.

This API is intentionally carried as an exact-version MicroNUX integration
patch; it is not presented as an upstream ESP-IDF interface.

Signed-off-by: MicroNUX <micronux@example.invalid>
---
 components/esp_lcd/dsi/esp_lcd_panel_dpi.c     | 80 +++++++++++++++++++++++
 .../dsi/include/esp_lcd_mipi_dsi.h             | 35 +++++++++++
 2 files changed, 115 insertions(+)

diff --git a/components/esp_lcd/dsi/esp_lcd_panel_dpi.c b/components/esp_lcd/dsi/esp_lcd_panel_dpi.c
index cba926b0..706a74fe 100644
--- a/components/esp_lcd/dsi/esp_lcd_panel_dpi.c
+++ b/components/esp_lcd/dsi/esp_lcd_panel_dpi.c
@@ -12,8 +12,10 @@
 #include "mipi_dsi_priv.h"
 #include "esp_async_fbcpy.h"
 #include "esp_memory_utils.h"
+#include "esp_rom_sys.h"
 #include "esp_private/dw_gdma.h"
 #include "hal/color_hal.h"
+#include "hal/dw_gdma_ll.h"
 
 typedef struct esp_lcd_dpi_panel_t esp_lcd_dpi_panel_t;
 
@@ -711,6 +713,84 @@ esp_err_t esp_lcd_dpi_panel_set_pattern(esp_lcd_panel_handle_t panel, mipi_dsi_p
     return ESP_OK;
 }
 
+esp_err_t esp_lcd_dpi_panel_prepare_handoff(esp_lcd_panel_handle_t panel,
+                                             esp_lcd_dpi_panel_handoff_t *handoff)
+{
+    ESP_RETURN_ON_FALSE(panel && handoff, ESP_ERR_INVALID_ARG, TAG, "invalid argument");
+    esp_lcd_dpi_panel_t *dpi_panel = __containerof(panel, esp_lcd_dpi_panel_t, base);
+    ESP_RETURN_ON_FALSE(dpi_panel->num_fbs == 1 && dpi_panel->dma_chan &&
+                        dpi_panel->link_lists[0], ESP_ERR_INVALID_STATE, TAG,
+                        "DPI handoff requires one framebuffer and one DMA list");
+
+    dw_gdma_channel_handle_t chan = dpi_panel->dma_chan;
+    dw_gdma_link_list_handle_t link_list = dpi_panel->link_lists[0];
+    dw_gdma_link_list_handle_t handoff_list = NULL;
+    dw_gdma_lli_handle_t lli = dw_gdma_link_list_get_item(link_list, 0);
+    const dw_gdma_link_list_config_t handoff_list_config = {
+        .num_items = 4,
+        .link_type = DW_GDMA_LINKED_LIST_TYPE_SINGLY,
+    };
+    int channel_id = -1;
+
+    ESP_RETURN_ON_ERROR(dw_gdma_channel_get_id(chan, &channel_id), TAG,
+                        "get DPI DMA channel");
+
+    /* Prevent the one-shot completion ISR from restarting the channel. */
+    dw_gdma_event_callbacks_t no_callbacks = {0};
+    ESP_RETURN_ON_ERROR(
+        dw_gdma_channel_register_event_callbacks(chan, &no_callbacks, NULL),
+        TAG, "detach DPI DMA restart callback");
+    mipi_dsi_brg_ll_enable_interrupt(dpi_panel->bus->hal.bridge,
+                                     UINT32_MAX, false);
+
+    ESP_RETURN_ON_ERROR(dw_gdma_channel_enable_ctrl(chan, false), TAG,
+                        "stop DPI DMA channel for handoff");
+    dw_gdma_dev_t *dma = DW_GDMA_LL_GET_HW(0);
+    uint32_t retries = 1000;
+    while ((dma->chen0.val & BIT(channel_id)) && retries-- > 0) {
+        esp_rom_delay_us(1);
+    }
+    if (dma->chen0.val & BIT(channel_id)) {
+        /* The diagnostic pattern disconnects DPI, so no AXI beat is active. */
+        ESP_RETURN_ON_ERROR(dw_gdma_channel_abort(chan), TAG,
+                            "abort stalled DPI DMA channel for handoff");
+    }
+    ESP_RETURN_ON_FALSE(!(dma->chen0.val & BIT(channel_id)), ESP_ERR_TIMEOUT,
+                        TAG, "DPI DMA channel did not quiesce");
+    dw_gdma_ll_channel_clear_intr(dma, channel_id, UINT32_MAX);
+
+    const dw_gdma_block_markers_t markers = {
+        .en_trans_done_intr = false,
+        .is_valid = true,
+        .is_last = false,
+    };
+    ESP_RETURN_ON_ERROR(dw_gdma_new_link_list(&handoff_list_config,
+                                               &handoff_list), TAG,
+                        "allocate DPI handoff descriptor ring");
+    for (size_t i = 0; i < handoff_list_config.num_items; i++) {
+        dw_gdma_lli_handle_t item =
+            dw_gdma_link_list_get_item(handoff_list, i);
+        dw_gdma_lli_handle_t next = dw_gdma_link_list_get_item(
+            handoff_list, (i + 1) % handoff_list_config.num_items);
+
+        memcpy(item, lli, 64);
+        ESP_RETURN_ON_ERROR(dw_gdma_lli_set_next(item, next), TAG,
+                            "link DPI handoff descriptor ring");
+        ESP_RETURN_ON_ERROR(dw_gdma_lli_set_block_markers(item, markers), TAG,
+                            "mark DPI handoff ring descriptor");
+    }
+    ESP_RETURN_ON_ERROR(dw_gdma_channel_use_link_list(chan, handoff_list), TAG,
+                        "install DPI handoff descriptor ring");
+    *handoff = (esp_lcd_dpi_panel_handoff_t) {
+        .frame_buffer = dpi_panel->fbs[0],
+        .frame_buffer_size = dpi_panel->fb_size,
+        .dma_descriptor = dw_gdma_link_list_get_item(handoff_list, 0),
+        .dma_descriptor_size = handoff_list_config.num_items * 64,
+        .dma_channel = channel_id,
+    };
+    return ESP_OK;
+}
+
 esp_err_t esp_lcd_dpi_panel_register_event_callbacks(esp_lcd_panel_handle_t panel, const esp_lcd_dpi_panel_event_callbacks_t *cbs, void *user_ctx)
 {
     ESP_RETURN_ON_FALSE(panel && cbs, ESP_ERR_INVALID_ARG, TAG, "invalid argument");
diff --git a/components/esp_lcd/dsi/include/esp_lcd_mipi_dsi.h b/components/esp_lcd/dsi/include/esp_lcd_mipi_dsi.h
index 99887f93..4ad996c1 100644
--- a/components/esp_lcd/dsi/include/esp_lcd_mipi_dsi.h
+++ b/components/esp_lcd/dsi/include/esp_lcd_mipi_dsi.h
@@ -141,6 +141,41 @@ esp_err_t esp_lcd_dpi_panel_get_frame_buffer(esp_lcd_panel_handle_t dpi_panel, u
  */
 esp_err_t esp_lcd_dpi_panel_set_pattern(esp_lcd_panel_handle_t dpi_panel, mipi_dsi_pattern_type_t pattern);
 
+/**
+ * @brief Resources transferred by a circular DMA-ring DPI handoff
+ *
+ * @note This exact-version extension is intended for a boot loader which
+ *       transfers a running display to an operating system. The caller must
+ *       preserve the framebuffer and descriptor memory after this call.
+ */
+typedef struct {
+    void *frame_buffer;          /*!< DMA-visible framebuffer address */
+    size_t frame_buffer_size;    /*!< Framebuffer length in bytes */
+    void *dma_descriptor;        /*!< Non-cacheable DMA descriptor address */
+    size_t dma_descriptor_size;  /*!< DMA descriptor length in bytes */
+    int dma_channel;             /*!< DW-GDMA channel number */
+} esp_lcd_dpi_panel_handoff_t;
+
+/**
+ * @brief Prepare one DPI framebuffer for operating-system ownership
+ *
+ * Stops the current transfer, constructs a valid no-interrupt descriptor ring
+ * whose entries repeat the framebuffer, and returns the resources needed to
+ * start it. The DSI host pattern state is not changed, so the operating system
+ * can claim the registers before selecting framebuffer scanout.
+ *
+ * @param[in] dpi_panel MIPI DPI panel handle
+ * @param[out] handoff Resources which must remain reserved for the new owner
+ * @return
+ *      - ESP_OK: Handoff prepared successfully
+ *      - ESP_ERR_INVALID_ARG: Invalid panel or output pointer
+ *      - ESP_ERR_INVALID_STATE: Panel is not a one-framebuffer DPI panel
+ *      - ESP_FAIL: DMA handoff failed
+ */
+esp_err_t esp_lcd_dpi_panel_prepare_handoff(
+    esp_lcd_panel_handle_t dpi_panel,
+    esp_lcd_dpi_panel_handoff_t *handoff);
+
 /**
  * @brief Set color conversion (YUV<->RGB) configuration for DPI panel
  *
