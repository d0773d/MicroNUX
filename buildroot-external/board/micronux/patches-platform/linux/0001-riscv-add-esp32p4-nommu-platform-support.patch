diff --git a/drivers/power/reset/esp32p4-restart.c b/drivers/power/reset/esp32p4-restart.c
new file mode 100644
index 000000000000..275f4462ef23
--- /dev/null
+++ b/drivers/power/reset/esp32p4-restart.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal ESP32-P4 restart support for MicroNUX.
+ *
+ * The ROM entry is taken from the ESP32-P4 revision 1.3 ROM interface
+ * shipped with ESP-IDF v6.0.1.
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/reboot.h>
+#include <linux/types.h>
+
+#define ESP32P4_ROM_SOFTWARE_RESET	0x4fc00094UL
+
+typedef void (*esp32p4_rom_reset_fn)(void);
+
+static int esp32p4_restart(struct notifier_block *this, unsigned long mode,
+			   void *cmd)
+{
+	esp32p4_rom_reset_fn reset =
+		(esp32p4_rom_reset_fn)ESP32P4_ROM_SOFTWARE_RESET;
+
+	local_irq_disable();
+	pr_emerg("Restarting through ESP32-P4 ROM\n");
+	asm volatile("fence rw, rw\n\tfence.i" : : : "memory");
+	reset();
+
+	for (;;)
+		asm volatile("wfi");
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block esp32p4_restart_nb = {
+	.notifier_call = esp32p4_restart,
+	.priority = 255,
+};
+
+static int __init esp32p4_restart_init(void)
+{
+	int ret;
+
+	if (!of_machine_is_compatible("espressif,esp32p4"))
+		return -ENODEV;
+
+	ret = register_restart_handler(&esp32p4_restart_nb);
+	if (ret)
+		pr_err("ESP32-P4 restart handler registration failed: %d\n", ret);
+	else
+		pr_info("ESP32-P4 ROM restart handler registered\n");
+
+	return ret;
+}
+device_initcall(esp32p4_restart_init);
