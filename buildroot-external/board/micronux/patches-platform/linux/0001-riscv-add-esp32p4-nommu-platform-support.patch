diff --git a/drivers/irqchip/irq-riscv-intc.c b/drivers/irqchip/irq-riscv-intc.c
index 9e71c4428814..eb813b10f96c 100644
--- a/drivers/irqchip/irq-riscv-intc.c
+++ b/drivers/irqchip/irq-riscv-intc.c
@@ -17,18 +17,34 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/smp.h>
+#include <linux/io.h>
 #include <linux/soc/andes/irq.h>
 
 #include <asm/hwcap.h>
 
+#define ESP32P4_CLIC_CFG		0x20800000
+#define ESP32P4_CLIC_THRESHOLD		0x20800008
+#define ESP32P4_CLIC_INT_BASE		0x20801000
+#define ESP32P4_CLIC_INT_STRIDE		4
+#define ESP32P4_CLIC_INT_IE		1
+#define ESP32P4_CLIC_INT_ATTR		2
+#define ESP32P4_CLIC_INT_CTL		3
+#define ESP32P4_CLIC_NLBITS		GENMASK(4, 1)
+#define ESP32P4_CLIC_NLBITS_3		(3 << 1)
+#define ESP32P4_CLIC_LEVEL_1		BIT(5)
+#define ESP32P4_MCAUSE_CODE		GENMASK(5, 0)
+
 static struct irq_domain *intc_domain;
 static unsigned int riscv_intc_nr_irqs __ro_after_init = BITS_PER_LONG;
 static unsigned int riscv_intc_custom_base __ro_after_init = BITS_PER_LONG;
 static unsigned int riscv_intc_custom_nr_irqs __ro_after_init;
+static bool esp32p4_clic __ro_after_init;
 
 static void riscv_intc_irq(struct pt_regs *regs)
 {
-	unsigned long cause = regs->cause & ~CAUSE_IRQ_FLAG;
+	unsigned long cause = esp32p4_clic ?
+		(regs->cause & ESP32P4_MCAUSE_CODE) :
+		(regs->cause & ~CAUSE_IRQ_FLAG);
 
 	if (generic_handle_domain_irq(intc_domain, cause))
 		pr_warn_ratelimited("Failed to handle interrupt (cause: %ld)\n", cause);
@@ -53,4 +70,12 @@ static void riscv_intc_irq_mask(struct irq_data *d)
 {
+	if (esp32p4_clic) {
+		void __iomem *ie = (void __iomem *)(ESP32P4_CLIC_INT_BASE +
+			d->hwirq * ESP32P4_CLIC_INT_STRIDE + ESP32P4_CLIC_INT_IE);
+
+		writeb(0, ie);
+		readb(ie);
+		return;
+	}
 	if (IS_ENABLED(CONFIG_32BIT) && d->hwirq >= BITS_PER_LONG)
 		csr_clear(CSR_IEH, BIT(d->hwirq - BITS_PER_LONG));
 	else
@@ -62,4 +87,12 @@ static void riscv_intc_irq_unmask(struct irq_data *d)
 {
+	if (esp32p4_clic) {
+		void __iomem *ie = (void __iomem *)(ESP32P4_CLIC_INT_BASE +
+			d->hwirq * ESP32P4_CLIC_INT_STRIDE + ESP32P4_CLIC_INT_IE);
+
+		writeb(1, ie);
+		readb(ie);
+		return;
+	}
 	if (IS_ENABLED(CONFIG_32BIT) && d->hwirq >= BITS_PER_LONG)
 		csr_set(CSR_IEH, BIT(d->hwirq - BITS_PER_LONG));
 	else
@@ -123,6 +150,16 @@ static int riscv_intc_domain_map(struct irq_domain *d, unsigned int irq,
 {
 	struct irq_chip *chip = d->host_data;
 
+	if (esp32p4_clic) {
+		void __iomem *base = (void __iomem *)(ESP32P4_CLIC_INT_BASE +
+				     hwirq * ESP32P4_CLIC_INT_STRIDE);
+
+		writeb(0, base + ESP32P4_CLIC_INT_IE);
+		writeb(0, base + ESP32P4_CLIC_INT_ATTR);
+		writeb(ESP32P4_CLIC_LEVEL_1,
+		       base + ESP32P4_CLIC_INT_CTL);
+	}
+
 	irq_set_percpu_devid(irq);
 	irq_domain_set_info(d, irq, hwirq, chip, NULL, handle_percpu_devid_irq,
 			    NULL, NULL);
@@ -248,6 +285,15 @@ static int __init riscv_intc_init(struct device_node *node,
 		chip = &andes_intc_chip;
 	}
 
+	if (of_device_is_compatible(node, "espressif,esp32p4-clic")) {
+		void __iomem *cfg = (void __iomem *)ESP32P4_CLIC_CFG;
+
+		esp32p4_clic = true;
+		writel((readl(cfg) & ~ESP32P4_CLIC_NLBITS) |
+		       ESP32P4_CLIC_NLBITS_3, cfg);
+		writel(0, (void __iomem *)ESP32P4_CLIC_THRESHOLD);
+	}
+
 	return riscv_intc_init_common(of_node_to_fwnode(node), chip);
 }
 
@@ -255,5 +301,7 @@ static int __init riscv_intc_init(struct device_node *node,
 IRQCHIP_DECLARE(riscv, "riscv,cpu-intc", riscv_intc_init);
 IRQCHIP_DECLARE(andes, "andestech,cpu-intc", riscv_intc_init);
+IRQCHIP_DECLARE(esp32p4, "espressif,esp32p4-clic",
+		riscv_intc_init);
 
 #ifdef CONFIG_ACPI
 
