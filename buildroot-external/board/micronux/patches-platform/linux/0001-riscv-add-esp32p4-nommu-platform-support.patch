--- /dev/null
+++ b/drivers/tty/serial/earlycon-esp32p4.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Polling early console for the ESP32-P4 USB Serial/JTAG endpoint inherited
+ * from the loader.
+ */
+
+#include <linux/bits.h>
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/serial_core.h>
+
+#define ESP32P4_USB_SERIAL_FIFO		0x00
+#define ESP32P4_USB_SERIAL_CONF		0x04
+#define ESP32P4_USB_SERIAL_WR_DONE	BIT(0)
+#define ESP32P4_USB_SERIAL_DATA_FREE	BIT(1)
+
+static void esp32p4_earlycon_putc(struct uart_port *port, unsigned char ch)
+{
+	while (!(readl_relaxed(port->membase + ESP32P4_USB_SERIAL_CONF) &
+		 ESP32P4_USB_SERIAL_DATA_FREE))
+		cpu_relax();
+
+	writel_relaxed(ch, port->membase + ESP32P4_USB_SERIAL_FIFO);
+	if (ch == '\n')
+		writel_relaxed(ESP32P4_USB_SERIAL_WR_DONE,
+			       port->membase + ESP32P4_USB_SERIAL_CONF);
+}
+
+static void esp32p4_earlycon_write(struct console *con, const char *s,
+				   unsigned int count)
+{
+	struct earlycon_device *device = con->data;
+
+	uart_console_write(&device->port, s, count, esp32p4_earlycon_putc);
+}
+
+static int __init esp32p4_earlycon_setup(struct earlycon_device *device,
+					 const char *options)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	device->con->write = esp32p4_earlycon_write;
+	return 0;
+}
+
+EARLYCON_DECLARE(esp32p4usb, esp32p4_earlycon_setup);
+OF_EARLYCON_DECLARE(esp32p4_usj,
+		    "espressif,esp32p4-usb-serial-jtag",
+		    esp32p4_earlycon_setup);
