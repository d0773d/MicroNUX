diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
index 9d4c38b8d11f..7b53f3986c69 100644
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -94,6 +94,7 @@ new_vmalloc_check:
 .endm
 
 
+.balign 64
 SYM_CODE_START(handle_exception)
 	/*
 	 * If coming from userspace, preserve the user thread pointer and load
@@ -145,6 +146,16 @@ SYM_CODE_START(handle_exception)
 	csrr s2, CSR_EPC
 	csrr s3, CSR_TVAL
 	csrr s4, CSR_CAUSE
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * CLIC adds MPP, MPIE, MPIL and MINHV state to mcause.  Preserve the
+	 * complete value for mret, while exposing only INT and CODE through
+	 * pt_regs to the generic RISC-V exception and signal code.
+	 */
+	REG_S s4, PT_CLIC_CAUSE(sp)
+	li t0, 0x8000003f
+	and s4, s4, t0
+#endif
 	csrr s5, CSR_SCRATCH
 	REG_S s0, PT_SP(sp)
 	REG_S s1, PT_STATUS(sp)
@@ -257,6 +266,48 @@ SYM_CODE_START_NOALIGN(ret_from_exception)
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * ESP32-P4 CLIC mret consumes privilege and interrupt state from
+	 * mcause as well as mstatus. Keep the two saved views coherent before
+	 * either CSR becomes live.
+	 */
+	REG_L a1, PT_CLIC_CAUSE(sp)
+	li t0, 0x1800
+	and t1, a0, t0
+	li t0, 0xcfffffff
+	and a1, a1, t0
+	slli t1, t1, 17
+	or a1, a1, t1
+	bnez t1, .Lesp32p4_clic_direct_return
+	bgez a1, .Lesp32p4_clic_direct_return
+
+	/*
+	 * Revision 1 ESP32-P4 cores restore the CLIC level only for an
+	 * interrupt-form mret, but that form cannot return directly to U-mode.
+	 * First unwind the CLIC state into an M-mode trampoline with interrupts
+	 * disabled. The trampoline then performs the exception-form U return.
+	 */
+	li t0, 0xf7ffffff
+	and t1, a1, t0
+	li t0, 0x30000000
+	or t1, t1, t0
+	csrw CSR_CAUSE, t1
+	li t0, SR_MPP
+	or t1, a0, t0
+	andi t1, t1, -129
+	csrw CSR_STATUS, t1
+	la t0, .Lesp32p4_clic_user_return
+	csrw CSR_EPC, t0
+	mret
+
+.Lesp32p4_clic_user_return:
+	li t0, 0x7fffffff
+	and a1, a1, t0
+.Lesp32p4_clic_direct_return:
+	csrw CSR_CAUSE, a1
+#endif
+
 	csrw CSR_STATUS, a0
 	csrw CSR_EPC, a2
 
 	REG_L x1,  PT_RA(sp)
 	REG_L x3,  PT_GP(sp)
 	REG_L x4,  PT_TP(sp)
