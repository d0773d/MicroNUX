-	csrw CSR_TVEC, a3
+	set_trap_vector a3
 
 	/* a0 contains the hartid & a1 contains boot data */
 	li a2, SBI_HART_BOOT_TASK_PTR_OFFSET
@@ -160,6 +167,7 @@ secondary_start_sbi:
 	call smp_callin
 #endif /* CONFIG_SMP */
 
+.balign 64
 .align 2
 .Lsecondary_park:
 	/*
@@ -183,7 +191,7 @@ secondary_start_sbi:
 .Lsetup_trap_vector:
 	/* Set trap vector to exception handler */
 	la a0, handle_exception
-	csrw CSR_TVEC, a0
+	set_trap_vector a0
 
 	/*
 	 * Set sup0 scratch register to 0, indicating to exception vector that
@@ -212,11 +220,12 @@ SYM_CODE_START(_start_kernel)
 	 */
 	la a0, .Lpmp_done
-	csrw CSR_TVEC, a0
+	set_trap_vector a0
 
 	li a0, -1
 	csrw CSR_PMPADDR0, a0
 	li a0, (PMP_A_NAPOT | PMP_R | PMP_W | PMP_X)
 	csrw CSR_PMPCFG0, a0
+.balign 64
 .align 2
 .Lpmp_done:
 
@@ -307,7 +316,7 @@ SYM_CODE_START(_start_kernel)
 #endif /* CONFIG_BUILTIN_DTB */
 	/* Set trap vector to spin forever to help debug */
 	la a3, .Lsecondary_park
-	csrw CSR_TVEC, a3
+	set_trap_vector a3
 	call setup_vm
 #ifdef CONFIG_MMU
 	la a0, early_pg_dir
@@ -333,7 +342,7 @@ SYM_CODE_START(_start_kernel)
