From b8bc9344d630dfa5cd786223ddf0d06c97deed99 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sun, 9 Aug 2026 04:45:00 -0700
Subject: [PATCH 6/8] riscv: fix ESP32-P4 CLIC level across user task switches

ESP32-P4 revision 1 only restores mintstatus.MIL from mcause.MPIL for
an interrupt-form mret.  The existing workaround used such an mret
before returning an interrupt frame to user mode.

That is insufficient when the scheduler switches tasks while exiting
an interrupt.  The CPU still has the interrupt's active level, but the
new task can carry an exception-form frame from an earlier system call.
Using the frame's interrupt bit to select the workaround then skips the
level restore and leaves MIL at level 1, masking every MicroNUX IRQ.

Run the M-mode unwind trampoline for every user-mode return.  Construct
its interrupt cause with an explicit idle previous level rather than
using task-owned CLIC state, then use a clean exception-form cause for
the final return to user mode.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 arch/riscv/kernel/entry.S | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
index 7b53f3986c69..2c8c643e0f14 100644
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -278,18 +278,20 @@ SYM_CODE_START_NOALIGN(ret_from_exception)
 	and a1, a1, t0
 	slli t1, t1, 17
 	or a1, a1, t1
+	/* Machine-mode returns can restore their own saved CLIC context. */
 	bnez t1, .Lesp32p4_clic_direct_return
-	bgez a1, .Lesp32p4_clic_direct_return
 
 	/*
 	 * Revision 1 ESP32-P4 cores restore the CLIC level only for an
-	 * interrupt-form mret, but that form cannot return directly to U-mode.
-	 * First unwind the CLIC state into an M-mode trampoline with interrupts
-	 * disabled. The trampoline then performs the exception-form U return.
+	 * interrupt-form mret, but that form cannot return directly to U-mode.
+	 * A task switch while exiting an interrupt can select an exception-form
+	 * frame from another task while the CPU still has the interrupt level
+	 * active, so the saved frame's interrupt bit cannot select this path.
+	 * Unwind every U-mode return through M-mode with an explicit idle MPIL.
 	 */
-	li t0, 0xf7ffffff
+	li t0, 0x00000fff
 	and t1, a1, t0
-	li t0, 0x30000000
+	li t0, 0xb0000000
 	or t1, t1, t0
 	csrw CSR_CAUSE, t1
 	li t0, SR_MPP
@@ -302,7 +304,7 @@ SYM_CODE_START_NOALIGN(ret_from_exception)
 	mret
 
 .Lesp32p4_clic_user_return:
-	li t0, 0x7fffffff
+	li t0, 0x08000fff
 	and a1, a1, t0
 .Lesp32p4_clic_direct_return:
 	csrw CSR_CAUSE, a1
-- 
