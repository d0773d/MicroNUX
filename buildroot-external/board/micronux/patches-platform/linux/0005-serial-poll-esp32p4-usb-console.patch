From 8b9cb9712d20730371498b579ae0bcc9b0fdc11b Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sat, 8 Aug 2026 05:10:00 -0700
Subject: [PATCH 5/8] serial: poll ESP32-P4 USB console status

ESP32-P4 revision 1.3 does not reliably re-arm this peripheral source
through the current Linux CLIC IRQ path.  Poll the USB Serial/JTAG status
once per kernel tick instead.  The normal status handler still acknowledges
and services RX and TX events, so polling does not read stale FIFO contents
or alter the tty data path.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 drivers/tty/serial/esp32_acm.c | 39 ++++++++++++++++++++++++++++++----
 1 file changed, 35 insertions(+), 4 deletions(-)

diff --git a/drivers/tty/serial/esp32_acm.c b/drivers/tty/serial/esp32_acm.c
--- a/drivers/tty/serial/esp32_acm.c
+++ b/drivers/tty/serial/esp32_acm.c
@@ -11,6 +11,7 @@
 #include <linux/platform_device.h>
 #include <linux/serial_core.h>
 #include <linux/slab.h>
+#include <linux/timer.h>
 #include <linux/tty_flip.h>
 #include <asm/serial.h>
 
@@ -47,6 +48,14 @@ MODULE_DEVICE_TABLE(of, esp32s3_acm_dt_ids);
 
 static struct uart_port *esp32s3_acm_ports[UART_NR];
 
+struct esp32s3_acm_poll {
+	struct timer_list timer;
+	struct uart_port *port;
+	bool active;
+};
+
+static struct esp32s3_acm_poll esp32s3_acm_polls[UART_NR];
+
 static void esp32s3_acm_write(struct uart_port *port, unsigned long reg, u32 v)
 {
 	writel(v, port->membase + reg);
@@ -207,6 +216,21 @@ static irqreturn_t esp32s3_acm_int(int irq, void *dev_id)
 	return IRQ_RETVAL(status);
 }
 
+static void esp32s3_acm_poll(struct timer_list *timer)
+{
+	struct esp32s3_acm_poll *poll = from_timer(poll, timer, timer);
+	struct uart_port *port = poll->port;
+
+	if (!READ_ONCE(poll->active))
+		return;
+
+	esp32s3_acm_int(port->irq, port);
+	esp32s3_acm_transmit_buffer(port);
+
+	if (READ_ONCE(poll->active))
+		mod_timer(&poll->timer, jiffies + 1);
+}
+
 static void esp32s3_acm_start_tx(struct uart_port *port)
 {
 	esp32s3_acm_transmit_buffer(port);
@@ -223,21 +247,23 @@ static void esp32s3_acm_stop_rx(struct uart_port *port)
 
 static int esp32s3_acm_startup(struct uart_port *port)
 {
-	int ret;
+	struct esp32s3_acm_poll *poll = &esp32s3_acm_polls[port->line];
 
-	ret = request_irq(port->irq, esp32s3_acm_int, 0, DRIVER_NAME, port);
-	if (ret)
-		return ret;
 	esp32s3_acm_write(port, USB_SERIAL_JTAG_INT_ENA_REG,
 			  USB_SERIAL_JTAG_SERIAL_OUT_RECV_PKT_INT_ENA);
+	WRITE_ONCE(poll->active, true);
+	mod_timer(&poll->timer, jiffies + 1);
 
 	return 0;
 }
 
 static void esp32s3_acm_shutdown(struct uart_port *port)
 {
+	struct esp32s3_acm_poll *poll = &esp32s3_acm_polls[port->line];
+
+	WRITE_ONCE(poll->active, false);
+	del_timer_sync(&poll->timer);
 	esp32s3_acm_write(port, USB_SERIAL_JTAG_INT_ENA_REG, 0);
-	free_irq(port->irq, port);
 }
 
 static void esp32s3_acm_set_termios(struct uart_port *port,
@@ -422,6 +448,9 @@ static int esp32s3_acm_probe(struct platform_device *pdev)
 	port->fifosize = ESP32S3_ACM_TX_FIFO_SIZE;
 
 	esp32s3_acm_ports[port->line] = port;
+	esp32s3_acm_polls[port->line].port = port;
+	timer_setup(&esp32s3_acm_polls[port->line].timer,
+		    esp32s3_acm_poll, 0);
 
 	platform_set_drvdata(pdev, port);
 
-- 
