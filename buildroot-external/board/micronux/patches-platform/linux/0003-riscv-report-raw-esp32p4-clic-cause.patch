From 208b631640b917d0b60ec67e19af2e807a2dc780 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Fri, 7 Aug 2026 17:00:00 -0700
Subject: [PATCH 3/6] riscv: report raw ESP32-P4 CLIC cause

The P4 CLIC extends mcause with saved interrupt state that generic RISC-V
diagnostics intentionally do not expose.  Include the preserved raw value in
register dumps so platform faults and interrupt-routing errors remain
diagnosable.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 arch/riscv/kernel/process.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/riscv/kernel/process.c b/arch/riscv/kernel/process.c
index 6cdf8e1cb148..40481df998c2 100644
--- a/arch/riscv/kernel/process.c
+++ b/arch/riscv/kernel/process.c
@@ -93,6 +93,9 @@ void __show_regs(struct pt_regs *regs)
 
 	pr_cont("status: " REG_FMT " badaddr: " REG_FMT " cause: " REG_FMT "\n",
 		regs->status, regs->badaddr, regs->cause);
+#ifdef CONFIG_SOC_ESP32P4
+	pr_cont("esp32p4 clic_cause: " REG_FMT "\n", regs->clic_cause);
+#endif
 }
 void show_regs(struct pt_regs *regs)
 {
