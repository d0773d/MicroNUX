--- a/arch/riscv/mm/micronux_user_pool.c
+++ b/arch/riscv/mm/micronux_user_pool.c
@@ -1,31 +1,46 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/* Dedicated U-mode mapping pool for the MicroNUX ESP32-P4 NOMMU profile. */
+/* Per-mm U-mode arenas for the MicroNUX ESP32-P4 NOMMU profile. */
 
 #include <linux/bitmap.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
+#include <linux/mm.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/overflow.h>
 #include <linux/proc_fs.h>
 #include <linux/sched.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <linux/string.h>
 
 #include <asm/page.h>
+#include <asm/micronux_user_isolation.h>
 #include <asm/micronux_user_pool.h>
 
 #define MICRONUX_USER_POOL_SIZE		(MICRONUX_USER_POOL_END - \
 					 MICRONUX_USER_POOL_START)
 #define MICRONUX_USER_POOL_MAX_PAGES	(MICRONUX_USER_POOL_SIZE / PAGE_SIZE)
 
-static DECLARE_BITMAP(micronux_user_bitmap,
+struct micronux_user_arena {
+	struct mm_struct *mm;
+	unsigned long first;
+	unsigned long reserved_pages;
+	unsigned long mapped_pages;
+	DECLARE_BITMAP(mapped, MICRONUX_USER_POOL_MAX_PAGES);
+};
+
+static DECLARE_BITMAP(micronux_user_reserved,
 			      MICRONUX_USER_POOL_MAX_PAGES);
+static struct micronux_user_arena
+	*micronux_user_owner[MICRONUX_USER_POOL_MAX_PAGES];
 static DEFINE_SPINLOCK(micronux_user_pool_lock);
 static unsigned long micronux_user_start;
 static unsigned long micronux_user_end;
 static unsigned long micronux_user_pages;
-static unsigned long micronux_user_used_pages;
+static unsigned long micronux_user_reserved_pages;
+static unsigned long micronux_user_mapped_pages;
+static unsigned long micronux_user_arenas;
 static bool micronux_pool_is_ready;
 
 static int __init micronux_user_pool_init(struct reserved_mem *rmem)
@@ -46,10 +61,11 @@ static int __init micronux_user_pool_init(struct reserved_mem *rmem)
 	micronux_user_start = (unsigned long)rmem->base;
 	micronux_user_end = (unsigned long)end;
 	micronux_user_pages = rmem->size >> PAGE_SHIFT;
-	bitmap_zero(micronux_user_bitmap, MICRONUX_USER_POOL_MAX_PAGES);
+	bitmap_zero(micronux_user_reserved, MICRONUX_USER_POOL_MAX_PAGES);
+	memset(micronux_user_owner, 0, sizeof(micronux_user_owner));
 	micronux_pool_is_ready = true;
 
-	pr_info("MICRONUX:M7:POOL state=ready range=[%08lx,%08lx) pages=%lu zero=on-allocate\n",
+	pr_info("MICRONUX:M7:POOL state=ready range=[%08lx,%08lx) pages=%lu zero=on-arena+allocate ownership=per-mm\n",
 		micronux_user_start, micronux_user_end,
 		micronux_user_pages);
 	return 0;
@@ -102,76 +118,238 @@ unsigned long micronux_user_pool_free_pages(void)
