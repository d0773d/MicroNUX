-void *micronux_user_pool_alloc(unsigned long nr_pages)
+int micronux_user_arena_prepare(struct mm_struct *mm, unsigned long bytes)
 {
+	struct micronux_user_arena *arena;
 	unsigned long flags;
+	unsigned long rounded;
+	unsigned long nr_pages;
 	unsigned long index;
-	void *result;
+	unsigned long page;
+	unsigned long start;
 
-	if (!micronux_user_pool_ready() || !nr_pages ||
-	    nr_pages > micronux_user_pages)
-		return NULL;
+	if (!mm || !micronux_user_pool_ready() || !bytes ||
+	    check_add_overflow(bytes, PAGE_SIZE - 1, &rounded))
+		return -EINVAL;
+	nr_pages = rounded >> PAGE_SHIFT;
+	if (!nr_pages || nr_pages > micronux_user_pages)
+		return -ENOMEM;
+
+	arena = kzalloc(sizeof(*arena), GFP_KERNEL);
+	if (!arena)
+		return -ENOMEM;
+	arena->mm = mm;
 
 	spin_lock_irqsave(&micronux_user_pool_lock, flags);
-	index = bitmap_find_next_zero_area(micronux_user_bitmap,
-					  micronux_user_pages, 0,
-					  nr_pages, 0);
+	if (READ_ONCE(mm->context.user_arena) ||
+	    READ_ONCE(mm->context.user_bounds_valid)) {
+		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+		kfree(arena);
+		return -EBUSY;
+	}
+	index = bitmap_find_next_zero_area(micronux_user_reserved,
+					   micronux_user_pages, 0,
+					   nr_pages, 0);
 	if (index >= micronux_user_pages ||
 	    nr_pages > micronux_user_pages - index) {
 		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+		kfree(arena);
+		return -ENOMEM;
+	}
+
+	arena->first = index;
+	arena->reserved_pages = nr_pages;
+	bitmap_set(micronux_user_reserved, index, nr_pages);
+	for (page = index; page < index + nr_pages; ++page)
+		micronux_user_owner[page] = arena;
+	micronux_user_reserved_pages += nr_pages;
+	++micronux_user_arenas;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+
+	start = micronux_user_start + (index << PAGE_SHIFT);
+	memset((void *)start, 0, nr_pages << PAGE_SHIFT);
+	WRITE_ONCE(mm->context.user_arena, arena);
+	WRITE_ONCE(mm->context.user_lo, start);
+	WRITE_ONCE(mm->context.user_hi, start + (nr_pages << PAGE_SHIFT));
+	/* Publish valid bounds only after the arena has been fully zeroed. */
+	smp_wmb();
+	WRITE_ONCE(mm->context.user_bounds_valid, true);
+	return 0;
+}
+
+void *micronux_user_arena_alloc(struct mm_struct *mm,
+				unsigned long nr_pages)
+{
+	struct micronux_user_arena *arena;
+	unsigned long flags;
+	unsigned long index;
+	unsigned long page;
+	unsigned long start;
+	unsigned long old_reserved;
+	bool expanded = false;
+
+	if (!mm || !nr_pages || nr_pages > micronux_user_pages ||
+	    !READ_ONCE(mm->context.user_bounds_valid))
+		return NULL;
+	arena = READ_ONCE(mm->context.user_arena);
+	if (!arena || arena->mm != mm)
 		return NULL;
+
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	index = bitmap_find_next_zero_area(arena->mapped,
+					   arena->reserved_pages, 0,
+					   nr_pages, 0);
+	if (index >= arena->reserved_pages ||
+	    nr_pages > arena->reserved_pages - index) {
+		index = arena->reserved_pages;
+		old_reserved = arena->reserved_pages;
+		page = arena->first + old_reserved;
+		if (page > micronux_user_pages ||
+		    nr_pages > micronux_user_pages - page ||
+		    find_next_bit(micronux_user_reserved, page + nr_pages,
+				  page) < page + nr_pages) {
+			spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+			return NULL;
+		}
+		bitmap_set(micronux_user_reserved, page, nr_pages);
+		while (page < arena->first + old_reserved + nr_pages) {
+			micronux_user_owner[page] = arena;
+			++page;
+		}
+		arena->reserved_pages += nr_pages;
+		micronux_user_reserved_pages += nr_pages;
+		expanded = true;
 	}
-	bitmap_set(micronux_user_bitmap, index, nr_pages);
-	micronux_user_used_pages += nr_pages;
+	bitmap_set(arena->mapped, index, nr_pages);
+	arena->mapped_pages += nr_pages;
+	micronux_user_mapped_pages += nr_pages;
+	start = micronux_user_start +
+		((arena->first + index) << PAGE_SHIFT);
 	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
 
-	result = (void *)(micronux_user_start + (index << PAGE_SHIFT));
-	memset(result, 0, nr_pages << PAGE_SHIFT);
-	return result;
+	memset((void *)start, 0, nr_pages << PAGE_SHIFT);
+	if (expanded) {
+		/* Do not expose newly reserved pages until zeroing is visible. */
+		smp_wmb();
+		WRITE_ONCE(mm->context.user_hi,
+			   micronux_user_start +
+			   ((arena->first + arena->reserved_pages) << PAGE_SHIFT));
+	}
+	return (void *)start;
 }
 
-bool micronux_user_pool_free(unsigned long start, unsigned long end)
+bool micronux_user_arena_free(unsigned long start, unsigned long end)
 {
+	struct micronux_user_arena *arena;
 	unsigned long flags;
 	unsigned long first;
+	unsigned long relative;
 	unsigned long nr_pages;
-	unsigned long clear;
+	unsigned long page;
 
 	if (!micronux_user_pool_contains(start, end) || start == end ||
 	    !IS_ALIGNED(start, PAGE_SIZE) || !IS_ALIGNED(end, PAGE_SIZE))
 		return false;
-
 	first = (start - micronux_user_start) >> PAGE_SHIFT;
 	nr_pages = (end - start) >> PAGE_SHIFT;
 
 	spin_lock_irqsave(&micronux_user_pool_lock, flags);
-	clear = find_next_zero_bit(micronux_user_bitmap,
-				   first + nr_pages, first);
-	if (clear < first + nr_pages ||
-	    nr_pages > micronux_user_used_pages) {
-		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
-		return false;
+	arena = micronux_user_owner[first];
+	if (!arena || first < arena->first ||
+	    nr_pages > arena->reserved_pages - (first - arena->first))
+		goto invalid;
+	for (page = first; page < first + nr_pages; ++page) {
+		if (micronux_user_owner[page] != arena)
+			goto invalid;
 	}
-	bitmap_clear(micronux_user_bitmap, first, nr_pages);
-	micronux_user_used_pages -= nr_pages;
+	relative = first - arena->first;
+	if (find_next_zero_bit(arena->mapped, relative + nr_pages,
+			       relative) < relative + nr_pages ||
+	    nr_pages > arena->mapped_pages ||
+	    nr_pages > micronux_user_mapped_pages)
+		goto invalid;
+	bitmap_clear(arena->mapped, relative, nr_pages);
+	arena->mapped_pages -= nr_pages;
+	micronux_user_mapped_pages -= nr_pages;
 	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
 	return true;
+
+invalid:
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+	return false;
+}
+
+void micronux_user_arena_release(struct mm_struct *mm)
+{
+	struct micronux_user_arena *arena;
+	unsigned long flags;
+	unsigned long page;
+
+	if (!mm)
+		return;
+	arena = READ_ONCE(mm->context.user_arena);
+	WRITE_ONCE(mm->context.user_bounds_valid, false);
+	/* Revoke U-mode access before clearing and releasing the arena. */
+	smp_wmb();
+	WRITE_ONCE(mm->context.user_lo, 0);
+	WRITE_ONCE(mm->context.user_hi, 0);
+	WRITE_ONCE(mm->context.user_arena, NULL);
+	if (!arena)
+		return;
+
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	if (WARN_ON_ONCE(arena->mm != mm || !arena->reserved_pages ||
+			 arena->first >= micronux_user_pages ||
+			 arena->reserved_pages >
+			 micronux_user_pages - arena->first ||
+			 arena->reserved_pages > micronux_user_reserved_pages ||
+			 arena->mapped_pages > micronux_user_mapped_pages ||
+			 !micronux_user_arenas)) {
+		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+		return;
+	}
+	WARN_ON_ONCE(arena->mapped_pages != 0);
+	for (page = arena->first;
+	     page < arena->first + arena->reserved_pages; ++page) {
+		if (WARN_ON_ONCE(micronux_user_owner[page] != arena ||
+				 !test_bit(page, micronux_user_reserved))) {
+			spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+			return;
+		}
+	}
+	for (page = arena->first;
+	     page < arena->first + arena->reserved_pages; ++page)
+		micronux_user_owner[page] = NULL;
+	bitmap_clear(micronux_user_reserved, arena->first,
+		     arena->reserved_pages);
+	micronux_user_reserved_pages -= arena->reserved_pages;
+	micronux_user_mapped_pages -= arena->mapped_pages;
+	--micronux_user_arenas;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+	kfree(arena);
 }
 
 static int micronux_user_pool_proc_show(struct seq_file *file, void *unused)
 {
-	unsigned long free_pages;
+	unsigned long flags;
+	unsigned long reserved;
+	unsigned long mapped;
+	unsigned long arenas;
 
-	free_pages = micronux_user_pool_free_pages();
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	reserved = micronux_user_reserved_pages;
+	mapped = micronux_user_mapped_pages;
+	arenas = micronux_user_arenas;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
 	seq_printf(file,
-		   "MICRONUX:M7:POOL range=[%08lx,%08lx) pages=%lu used=%lu free=%lu\n",
+		   "MICRONUX:M7:POOL range=[%08lx,%08lx) pages=%lu reserved=%lu mapped=%lu free=%lu arenas=%lu\n",
 		   micronux_user_start, micronux_user_end, micronux_user_pages,
-		   micronux_user_pages - free_pages, free_pages);
+		   reserved, mapped, micronux_user_pages - reserved, arenas);
 	return 0;
 }
 
