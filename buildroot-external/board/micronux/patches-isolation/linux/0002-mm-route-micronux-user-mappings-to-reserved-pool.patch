From 3f14f87237857058192871fcd2dc0d6f113337b4 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sun, 9 Aug 2026 09:05:00 -0700
Subject: [PATCH 02/10] mm: route MicroNUX user mappings to reserved pool

Under the ESP32-P4 isolation profile, make every copied NOMMU mapping come from
the dedicated U-mode pool.  Reject file-backed shared and direct mappings,
preserve the NOMMU private implementation of anonymous MAP_SHARED used by
libc, never fall back to the buddy allocator, and return partial unmaps and
teardown ranges to the same bitmap allocator while preserving accounting.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 mm/nommu.c | 40 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/mm/nommu.c b/mm/nommu.c
index b315b644dbe5..c35262e256b9 100644
--- a/mm/nommu.c
+++ b/mm/nommu.c
@@ -38,6 +38,9 @@
 #include <asm/tlb.h>
 #include <asm/tlbflush.h>
 #include <asm/mmu_context.h>
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+#include <asm/micronux_user_pool.h>
+#endif
 #include "internal.h"
 
 void *high_memory;
@@ -486,6 +489,18 @@ static void delete_nommu_region(struct vm_region *region)
  */
 static void free_page_series(unsigned long from, unsigned long to)
 {
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	unsigned long nr_pages;
+
+	if (WARN_ON_ONCE(!micronux_user_pool_free(from, to)))
+		return;
+
+	nr_pages = (to - from) >> PAGE_SHIFT;
+	atomic_long_sub(nr_pages, &mmap_pages_allocated);
+	return;
+#endif
+
+#ifndef CONFIG_MICRONUX_ESP32P4_ISOLATION
 	for (; from < to; from += PAGE_SIZE) {
 		struct page *page = virt_to_page((void *)from);
 
@@ -493,5 +509,6 @@ static void free_page_series(unsigned long from, unsigned long to)
 		put_page(page);
 	}
+#endif
 }
 
 /*
@@ -830,6 +847,20 @@ static int validate_mmap_request(struct file *file,
 		    (current->personality & READ_IMPLIES_EXEC))
 			prot |= PROT_EXEC;
 	}
+
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	/*
+	 * A direct or shared NOMMU mapping would make storage owned by a
+	 * device, filesystem, or another process visible through the U-mode
+	 * PMP window.  Anonymous MAP_SHARED is the NOMMU libc heap convention;
+	 * Linux implements that case as a private copied mapping because NOMMU
+	 * has no fork().
+	 */
+	if ((file && (flags & MAP_TYPE) == MAP_SHARED) ||
+	    !(capabilities & NOMMU_MAP_COPY))
+		return -EACCES;
+	capabilities &= ~NOMMU_MAP_DIRECT;
+#endif
 
 	/* allow the security API to have its say */
 	ret = security_mmap_addr(addr);
@@ -946,7 +976,11 @@ static int do_mmap_private(struct vm_area_struct *vma,
 	if (sysctl_nr_trim_pages && total - point >= sysctl_nr_trim_pages)
 		total = point;
 
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	base = micronux_user_pool_alloc(total);
+#else
 	base = alloc_pages_exact(total << PAGE_SHIFT, GFP_KERNEL);
+#endif
 	if (!base)
 		goto enomem;
 
@@ -999,5 +1035,10 @@ enomem:
 	pr_err("Allocation of length %lu from process %d (%s) failed\n",
 	       len, current->pid, current->comm);
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	pr_err("MICRONUX:M7:POOL state=exhausted request_pages=%lu free_pages=%lu\n",
+	       total, micronux_user_pool_free_pages());
+#else
 	show_mem();
+#endif
 	return -ENOMEM;
 }
