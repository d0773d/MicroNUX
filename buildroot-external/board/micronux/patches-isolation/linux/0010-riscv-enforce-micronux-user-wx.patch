+	    sizeof(__user_rt_sigreturn) >
+		READ_ONCE(current->mm->context.user_exec_hi) - addr)
+		return -EFAULT;
+	regs->ra = addr;
 #else
 	/*
 	 * For the nommu case we don't have a VDSO.  Instead we push two
@@ -353,6 +367,7 @@ static int setup_rt_frame(struct ksignal *ksig, sigset_t *set,
 	flush_icache_range(addr, addr + sizeof(frame->sigreturn_code));
 
 	regs->ra = addr;
+#endif
 #endif /* CONFIG_MMU */
 
 	/*
diff --git a/arch/riscv/mm/micronux_user_pool.c b/arch/riscv/mm/micronux_user_pool.c
index a882103..424dd80 100644
--- a/arch/riscv/mm/micronux_user_pool.c
+++ b/arch/riscv/mm/micronux_user_pool.c
@@ -112,6 +112,57 @@ bool micronux_user_access_ok(unsigned long addr, unsigned long size)
 	return size <= hi - addr;
 }
 
+bool micronux_user_write_ok(unsigned long addr, unsigned long size)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long exec_hi;
+	unsigned long lo;
+	unsigned long hi;
+
+	if (!mm || !READ_ONCE(mm->context.user_bounds_valid))
+		return false;
+	lo = READ_ONCE(mm->context.user_lo);
+	hi = READ_ONCE(mm->context.user_hi);
+	if (lo < MICRONUX_USER_POOL_START || hi > MICRONUX_USER_POOL_END ||
+	    lo >= hi || addr < lo || addr > hi || size > hi - addr)
+		return false;
+
+	if (!READ_ONCE(mm->context.user_wx_valid) || !size)
+		return true;
+	exec_hi = READ_ONCE(mm->context.user_exec_hi);
+	return exec_hi > lo && exec_hi < hi && addr >= exec_hi;
+}
+
+int micronux_user_wx_finalize(struct mm_struct *mm,
+			      unsigned long exec_hi,
+			      unsigned long sigreturn,
+			      unsigned long sigreturn_size)
+{
+	unsigned long lo;
+	unsigned long hi;
+
+	if (!mm || !READ_ONCE(mm->context.user_bounds_valid) ||
+	    READ_ONCE(mm->context.user_wx_valid))
+		return -EINVAL;
+	lo = READ_ONCE(mm->context.user_lo);
+	hi = READ_ONCE(mm->context.user_hi);
+	if (lo < MICRONUX_USER_POOL_START || hi > MICRONUX_USER_POOL_END ||
+	    lo >= exec_hi || exec_hi >= hi ||
+	    !IS_ALIGNED(lo, MICRONUX_PMP_GRANULARITY) ||
+	    !IS_ALIGNED(exec_hi, MICRONUX_PMP_GRANULARITY) ||
+	    !IS_ALIGNED(hi, MICRONUX_PMP_GRANULARITY) ||
+	    sigreturn != lo || !sigreturn_size ||
+	    sigreturn_size > exec_hi - sigreturn)
+		return -EINVAL;
+
+	WRITE_ONCE(mm->context.user_exec_hi, exec_hi);
+	WRITE_ONCE(mm->context.user_sigreturn, sigreturn);
+	/* Publish the immutable split only after both bounds are visible. */
+	smp_wmb();
+	WRITE_ONCE(mm->context.user_wx_valid, true);
+	return 0;
+}
+
 unsigned long micronux_user_addr_limit(void)
 {
 	struct mm_struct *mm = current->mm;
@@ -210,7 +261,10 @@ int micronux_user_arena_prepare(struct mm_struct *mm, unsigned long bytes)
 	memset((void *)start, 0, nr_pages << PAGE_SHIFT);
 	WRITE_ONCE(mm->context.user_arena, arena);
 	WRITE_ONCE(mm->context.user_lo, start);
+	WRITE_ONCE(mm->context.user_exec_hi, 0);
 	WRITE_ONCE(mm->context.user_hi, start + (nr_pages << PAGE_SHIFT));
+	WRITE_ONCE(mm->context.user_sigreturn, 0);
+	WRITE_ONCE(mm->context.user_wx_valid, false);
 	/* Publish valid bounds only after the arena has been fully zeroed. */
 	smp_wmb();
 	WRITE_ONCE(mm->context.user_bounds_valid, true);
@@ -329,10 +383,13 @@ void micronux_user_arena_release(struct mm_struct *mm)
 		return;
 	arena = READ_ONCE(mm->context.user_arena);
 	WRITE_ONCE(mm->context.user_bounds_valid, false);
+	WRITE_ONCE(mm->context.user_wx_valid, false);
 	/* Revoke U-mode access before clearing and releasing the arena. */
 	smp_wmb();
 	WRITE_ONCE(mm->context.user_lo, 0);
+	WRITE_ONCE(mm->context.user_exec_hi, 0);
 	WRITE_ONCE(mm->context.user_hi, 0);
+	WRITE_ONCE(mm->context.user_sigreturn, 0);
 	WRITE_ONCE(mm->context.user_arena, NULL);
 	if (!arena)
 		return;
diff --git a/fs/binfmt_flat.c b/fs/binfmt_flat.c
index 4e69e91..2dae5cd 100644
--- a/fs/binfmt_flat.c
+++ b/fs/binfmt_flat.c
@@ -42,7 +42,9 @@
 
 #include <asm/byteorder.h>
 #ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+#include <asm/micronux_user_isolation.h>
 #include <asm/micronux_user_pool.h>
+extern u32 __user_rt_sigreturn[2];
 #endif
 #include <linux/unaligned.h>
 #include <asm/cacheflush.h>
@@ -505,7 +507,8 @@ static int load_flat_file(struct linux_binprm *bprm,
 
 	if (entry < sizeof(*hdr) || entry >= text_len ||
 	    text_len < sizeof(*hdr) || data_end < text_len ||
-	    bss_end < data_end || reloc_start != data_end) {
+	    bss_end < data_end || reloc_start != data_end ||
+	    !IS_ALIGNED(text_len, MICRONUX_PMP_GRANULARITY)) {
 		pr_err("MicroNUX rejected non-monotonic bFLT bounds\n");
 		ret = -ENOEXEC;
 		goto err;
@@ -918,6 +921,24 @@ static int load_flat_file(struct linux_binprm *bprm,
 		       stack_len))
 		return -EFAULT;
 
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	if (textpos != READ_ONCE(current->mm->context.user_lo) ||
+	    realdatastart != textpos + text_len + sizeof(struct flat_hdr)) {
+		pr_err("MicroNUX rejected a non-contiguous W^X image\n");
+		return -ENOEXEC;
+	}
+	if (copy_to_user((void __user *)textpos, __user_rt_sigreturn,
+			 sizeof(__user_rt_sigreturn)))
+		return -EFAULT;
+	flush_icache_range(textpos, textpos + sizeof(__user_rt_sigreturn));
+	ret = micronux_user_wx_finalize(current->mm, realdatastart, textpos,
+				       sizeof(__user_rt_sigreturn));
+	if (ret) {
+		pr_err("MicroNUX could not finalize W^X: %d\n", ret);
+		return ret;
+	}
+#endif
+
 	return 0;
 err:
 	return ret;
