From 6d886f6adcaabbb7ba2ce001148f9410f18c4fc1 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sun, 9 Aug 2026 18:00:00 -0700
Subject: [PATCH 10/10] riscv: enforce MicroNUX user W^X

Split each isolated NOMMU address space into an immutable executable range
and a writable non-executable range.  Place the signal-return sequence in a
fixed read-only trampoline, reject post-exec executable mappings, and make
all kernel-to-user copies honor the writable boundary.  Program and verify
a four-entry PMP TOR ladder before every U-mode return so code writes and
data or stack execution fault in hardware.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
diff --git a/arch/riscv/include/asm/micronux_user_isolation.h b/arch/riscv/include/asm/micronux_user_isolation.h
index 614d488..a3f5b37 100644
--- a/arch/riscv/include/asm/micronux_user_isolation.h
+++ b/arch/riscv/include/asm/micronux_user_isolation.h
@@ -11,6 +11,7 @@
 #define MICRONUX_PMP_GRANULARITY	128UL
 
 bool micronux_user_access_ok(unsigned long addr, unsigned long size);
+bool micronux_user_write_ok(unsigned long addr, unsigned long size);
 unsigned long micronux_user_addr_limit(void);
 void micronux_user_pmp_prepare_return(void);
 
diff --git a/arch/riscv/include/asm/micronux_user_pool.h b/arch/riscv/include/asm/micronux_user_pool.h
--- a/arch/riscv/include/asm/micronux_user_pool.h
+++ b/arch/riscv/include/asm/micronux_user_pool.h
@@ -7,6 +7,10 @@ struct mm_struct;
 struct micronux_user_arena;
 
 int micronux_user_arena_prepare(struct mm_struct *mm, unsigned long bytes);
+int micronux_user_wx_finalize(struct mm_struct *mm,
+			      unsigned long exec_hi,
+			      unsigned long sigreturn,
+			      unsigned long sigreturn_size);
 void *micronux_user_arena_alloc(struct mm_struct *mm,
 				unsigned long nr_pages);
 bool micronux_user_arena_free(unsigned long start, unsigned long end);
