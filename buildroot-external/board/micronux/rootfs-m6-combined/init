#!/bin/sh

if ! /bin/busybox mount -t devtmpfs devtmpfs /dev; then
	echo 'MICRONUX:M6:COMBINED:FAIL devtmpfs-mount'
	exit 1
fi
if ! /bin/busybox mount -t proc proc /proc; then
	echo 'MICRONUX:M6:COMBINED:FAIL proc-mount'
	exit 1
fi
if ! /bin/busybox mount -t sysfs sysfs /sys; then
	echo 'MICRONUX:M6:COMBINED:FAIL sysfs-mount'
	exit 1
fi

export HOME=/root
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PS1='micronux# '

/usr/sbin/micronux-deviced-supervise &
device_supervisor_pid=$!
for attempt in 1 2 3; do
	if [ -S /run/micronux/device-v1.sock ]; then
		break
	fi
	/bin/busybox sleep 1
done
if [ ! -S /run/micronux/device-v1.sock ]; then
	echo 'MICRONUX:M8:SERVICE:FAIL socket-missing'
	exit 1
fi
echo 'MICRONUX:M8:SERVICE state=ready abi=1.0 socket=/run/micronux/device-v1.sock'

if [ -x /usr/sbin/micronux-run ]; then
	if ! /usr/sbin/micronux-run --check; then
		echo 'MICRONUX:M7:JOB-SUPERVISOR:FAIL policy-installation'
		exit 1
	fi
fi

echo 'MICRONUX:M6:COMBINED:DRIVER storage=microsd-slot0 network=c6-sdio-slot1 arbitration=serialized'
/bin/busybox sleep 5
if [ -b /dev/mmcblk0 ]; then
	echo 'MICRONUX:M6:COMBINED:STORAGE state=ready name=mmcblk0'
else
	echo 'MICRONUX:M6:COMBINED:STORAGE state=missing name=mmcblk0'
fi
if [ -d /sys/class/net/ethsta0 ]; then
	echo 'MICRONUX:M6:COMBINED:IFACE state=ready name=ethsta0'
	/bin/busybox ip link show ethsta0
else
	echo 'MICRONUX:M6:COMBINED:IFACE state=missing name=ethsta0'
fi

echo 'MICRONUX:M6:COMBINED:SHELL ready console=ttyGS0 network=nonblocking device_api=1.0'
/bin/busybox setsid /bin/busybox cttyhack /bin/busybox sh -i \
	</dev/ttyGS0 >/dev/ttyGS0 2>&1 &
console_shell_pid=$!
wait "$console_shell_pid"
console_status=$?
/bin/busybox kill "$device_supervisor_pid" 2>/dev/null
wait "$device_supervisor_pid" 2>/dev/null
exit "$console_status"
