+static int micronux_native_initialize_memory(struct micronux_dsi *dsi)
+{
+	void __iomem *descriptor_page = dsi->descriptor[0];
+	u32 index, offset;
+
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		memset_io(dsi->framebuffer[index], 0,
+			  dsi->handoff.framebuffer_size);
+		for (offset = 0; offset < dsi->handoff.framebuffer_size;
+		     offset += sizeof(u32)) {
+			if (readl(dsi->framebuffer[index] + offset))
+				return -EIO;
+			if (!(offset & (MICRONUX_COLD_PAGE_SIZE - 1)))
+				cond_resched();
+		}
+	}
+
+	memset_io(descriptor_page, 0, MICRONUX_COLD_PAGE_SIZE);
+	for (offset = 0; offset < MICRONUX_COLD_PAGE_SIZE;
+	     offset += sizeof(u32))
+		if (readl(descriptor_page + offset))
+			return -EIO;
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		void __iomem *descriptor = dsi->descriptor[index];
+
+		writel(dsi->handoff.framebuffer_address[index],
+		       descriptor + DMA_LLI_SAR);
+		writel(0, descriptor + DMA_LLI_SAR_HI);
+		writel(dsi->handoff.dsi_fifo_address,
+		       descriptor + DMA_LLI_DAR);
+		writel(0, descriptor + DMA_LLI_DAR_HI);
+		writel(MICRONUX_DMA_BLOCK_TRANSFER_SIZE,
+		       descriptor + DMA_LLI_BLOCK_TS);
+		writel(DW_GDMA_LLP_MEMORY_PORT, descriptor + DMA_LLI_LLP);
+		writel(0, descriptor + DMA_LLI_LLP_HI);
+		writel(MICRONUX_DMA_DESCRIPTOR_CTRL_LO,
+		       descriptor + DMA_LLI_CTRL_LO);
+		writel(MICRONUX_NATIVE_DMA_DESCRIPTOR_CTRL_HI,
+		       descriptor + DMA_LLI_CTRL_HI);
+	}
+	/* Publish every descriptor word before validating the backing page. */
+	wmb();
+
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		void __iomem *descriptor = dsi->descriptor[index];
+
+		for (offset = 0; offset < MICRONUX_DMA_DESCRIPTOR_SIZE;
+		     offset += sizeof(u32)) {
+			u32 expected = 0;
+
+			switch (offset) {
+			case DMA_LLI_SAR:
+				expected = dsi->handoff.framebuffer_address[index];
+				break;
+			case DMA_LLI_DAR:
+				expected = dsi->handoff.dsi_fifo_address;
+				break;
+			case DMA_LLI_BLOCK_TS:
+				expected = MICRONUX_DMA_BLOCK_TRANSFER_SIZE;
+				break;
+			case DMA_LLI_LLP:
+				expected = DW_GDMA_LLP_MEMORY_PORT;
+				break;
+			case DMA_LLI_CTRL_LO:
+				expected = MICRONUX_DMA_DESCRIPTOR_CTRL_LO;
+				break;
+			case DMA_LLI_CTRL_HI:
+				expected = MICRONUX_NATIVE_DMA_DESCRIPTOR_CTRL_HI;
+				break;
+			default:
+				break;
+			}
+			if (readl(descriptor + offset) != expected)
+				return -EIO;
+		}
+	}
+	for (offset = dsi->handoff.dma_descriptor_size;
+	     offset < MICRONUX_COLD_PAGE_SIZE; offset += sizeof(u32))
+		if (readl(descriptor_page + offset))
+			return -EIO;
+
+	dsi->front_index = 0;
+	dsi->render_index = 1;
+	dsi->queued_index = -1;
+	dsi->render_needs_sync = false;
+	dsi->render_dirty = false;
+	micronux_initialize_pool_guards(dsi);
+	if (!micronux_pool_guards_valid(dsi, true))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=memory state=READY frames=3 fill=black verified=full descriptor-page=4096 descriptor-bytes=192 trailing-zero=verified ctrl-hi=40108840 armed=c0108840 front=0 render=1 spare=2 render-gate=closed\n");
+	return 0;
+}
