+	       dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+	writel(DW_GDMA_INT_COMMON_VALID_MASK |
+	       DW_GDMA_INT_COMMON_RO_MASK,
+	       dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+	writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR);
+	writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
+	writel(DW_GDMA_INT_COMMON_VALID_MASK,
+	       dsi->gdma + DW_GDMA_INT_CLEAR);
+	if (readl(dsi->gdma + DW_GDMA_CFG) != 1 ||
+	    readl(dsi->channel + DW_GDMA_CH_CFG_LO) !=
+		MICRONUX_DMA_CHANNEL_CFG_LO ||
+	    readl(dsi->channel + DW_GDMA_CH_CFG_HI) !=
+		MICRONUX_DMA_CHANNEL_CFG_HI ||
+	    readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA) !=
