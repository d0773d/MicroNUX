+static void micronux_bind_cold_runtime_profile(struct micronux_dsi *dsi)
+{
+	struct micronux_display_handoff_v3 *cold = &dsi->cold_handoff;
+	struct micronux_display_handoff_v2 *runtime = &dsi->handoff;
+	u8 index;
+
+	memset(runtime, 0, sizeof(*runtime));
+	runtime->magic = cold->magic;
+	runtime->abi_version = cold->abi_version;
+	runtime->struct_size = sizeof(*runtime);
+	runtime->flags = MICRONUX_DISPLAY_RGB565 |
+			 MICRONUX_DISPLAY_DMA_IRQ_REARM |
+			 MICRONUX_DISPLAY_TRIPLE_BUFFER;
+	runtime->width = cold->width;
+	runtime->height = cold->height;
+	runtime->stride = cold->stride;
+	runtime->pixel_clock_hz = cold->pixel_clock_hz;
+	runtime->lane_bit_rate_mbps = cold->lane_bit_rate_mbps;
+	runtime->data_lanes = cold->data_lanes;
+	runtime->buffer_count = cold->buffer_count;
+	runtime->ownership_state = cold->ownership_state;
+	runtime->hsync_pulse_width = cold->hsync_pulse_width;
+	runtime->hsync_back_porch = cold->hsync_back_porch;
+	runtime->hsync_front_porch = cold->hsync_front_porch;
+	runtime->vsync_pulse_width = cold->vsync_pulse_width;
+	runtime->vsync_back_porch = cold->vsync_back_porch;
+	runtime->vsync_front_porch = cold->vsync_front_porch;
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++)
+		runtime->framebuffer_address[index] =
+			cold->framebuffer_address[index];
+	runtime->framebuffer_size = cold->framebuffer_size;
+	runtime->dma_descriptor_address = cold->dma_descriptor_address;
+	runtime->dma_descriptor_size = cold->dma_descriptor_size;
+	runtime->dma_descriptor_count = cold->dma_descriptor_count;
+	runtime->dma_channel = cold->dma_channel;
+	runtime->dsi_fifo_address = cold->dsi_fifo_address;
+	runtime->i2c_address = cold->i2c_address;
+	runtime->display_control_register = cold->display_control_register;
+	runtime->backlight_register = cold->backlight_register;
+	runtime->backlight_brightness = cold->backlight_brightness;
+
+	dsi->channel = dsi->gdma + DW_GDMA_CH_BASE(runtime->dma_channel);
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		dsi->descriptor[index] = (void __iomem *)(uintptr_t)
+			(runtime->dma_descriptor_address +
+			 index * MICRONUX_DMA_DESCRIPTOR_SIZE +
+			 dsi->uncached_offset);
+		dsi->framebuffer[index] = (void __iomem *)(uintptr_t)
+			(runtime->framebuffer_address[index] +
+			 dsi->uncached_offset);
+	}
+}
