+	writel(DSI_BRG_NATIVE_BURST_LEN,
+	       dsi->bridge + DSI_BRG_BURST_LEN);
+	writel(DSI_BRG_NATIVE_RAW_NUM | DSI_BRG_RAW_NUM_TOTAL_SET,
+	       dsi->bridge + DSI_BRG_RAW_NUM_CONFIG);
+	writel(DSI_BRG_NATIVE_CREDIT,
+	       dsi->bridge + DSI_BRG_CREDIT_CONFIG);
+	writel(DSI_BRG_NATIVE_PIXEL_TYPE,
+	       dsi->bridge + DSI_BRG_PIXEL_TYPE);
+	writel(DSI_BRG_NATIVE_BLOCK_INTERVAL,
+	       dsi->bridge + DSI_BRG_DMA_BLOCK_INTERVAL);
+	writel(DSI_BRG_NATIVE_REQUEST_INTERVAL,
+	       dsi->bridge + DSI_BRG_DMA_REQUEST_INTERVAL);
+	writel(DSI_BRG_NATIVE_V_TIMING0,
+	       dsi->bridge + DSI_BRG_V_TIMING0);
+	writel(DSI_BRG_NATIVE_V_TIMING1,
+	       dsi->bridge + DSI_BRG_V_TIMING1);
+	writel(DSI_BRG_NATIVE_H_TIMING0,
+	       dsi->bridge + DSI_BRG_H_TIMING0);
+	writel(DSI_BRG_NATIVE_H_TIMING1,
