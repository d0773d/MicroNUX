+	writel(10, dsi->host + DSI_HOST_VID_VBP_LINES);
+	writel(30, dsi->host + DSI_HOST_VID_VFP_LINES);
+	writel(1280, dsi->host + DSI_HOST_VID_VACTIVE_LINES);
+	writel(DSI_HOST_CLOCK_LANE_AUTO, dsi->host + DSI_HOST_LPCLK_CTRL);
