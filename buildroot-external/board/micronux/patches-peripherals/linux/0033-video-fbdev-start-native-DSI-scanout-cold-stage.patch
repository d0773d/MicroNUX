+	writel(DSI_BRG_NATIVE_MISC_OFF,
+	       dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+	writel(DSI_BRG_NATIVE_FRAME_INTERVAL,
+	       dsi->bridge + DSI_BRG_FRAME_INTERVAL);
+	writel(DSI_BRG_NATIVE_HOST_CTRL,
