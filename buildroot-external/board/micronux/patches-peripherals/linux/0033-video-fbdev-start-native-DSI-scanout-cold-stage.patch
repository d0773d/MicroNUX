+			    HP_CLKRST_DSI_DPI_CLK_SRC_F240M) |
+		 FIELD_PREP(HP_CLKRST_DSI_DPI_CLK_DIV,
+			    HP_CLKRST_DSI_DPI_CLK_DIV_VALUE) |
+		 HP_CLKRST_DSI_DPI_CLK_EN;
