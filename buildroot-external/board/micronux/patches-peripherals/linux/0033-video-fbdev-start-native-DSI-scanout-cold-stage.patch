+	dsi->cold_dpi_enabled = true;
+	if ((readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03) & mask) !=
+	    HP_CLKRST_DSI_DPI_CLOCK_VALUE)
+		return -EIO;
