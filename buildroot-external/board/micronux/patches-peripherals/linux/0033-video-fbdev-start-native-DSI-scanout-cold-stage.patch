+static irqreturn_t micronux_native_dma_irq(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+	u32 common, status0, status1, top;
+	u8 next_index;
+	bool faulted, rearm_failed = false;
+
+	top = readl(dsi->gdma + DW_GDMA_INT_STATUS);
+	status0 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS);
+	status1 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS1);
+	common = readl(dsi->gdma + DW_GDMA_INT_COMMON_STATUS);
+	if (!(top | status0 | status1 | common))
+		return IRQ_NONE;
+
+	/* Clear every underlying W1C source before deciding whether to rearm. */
+	writel(status0, dsi->channel + DW_GDMA_CH_INT_CLEAR);
+	writel(status1, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
+	writel(common, dsi->gdma + DW_GDMA_INT_CLEAR);
+	if (top & ~DW_GDMA_INT_TOP_ALLOWED) {
+		/* Stop an immutable inactive-channel level source from retriggering. */
+		writel(1, dsi->gdma + DW_GDMA_CFG);
+		readl(dsi->gdma + DW_GDMA_CFG);
+	}
+	if ((top & ~DW_GDMA_INT_TOP_ALLOWED) ||
+	    (status0 & DW_GDMA_INT_ERROR_MASK) ||
+	    (status1 & DW_GDMA_INT_ECC_ERROR_MASK) ||
+	    (common & DW_GDMA_INT_COMMON_VALID_MASK)) {
+		WRITE_ONCE(dsi->last_dma_error,
+			   (status0 & DW_GDMA_INT_ERROR_MASK) |
+			   ((status1 || common ||
+			     (top & ~DW_GDMA_INT_TOP_ALLOWED)) ? BIT(31) : 0));
+		micronux_latch_fault(dsi, MICRONUX_FAULT_DMA);
+		return IRQ_HANDLED;
+	}
+
+	if (!(status0 & DW_GDMA_INT_DMA_TFR_DONE))
+		return IRQ_HANDLED;
+	WRITE_ONCE(dsi->scanout_frames,
+		   READ_ONCE(dsi->scanout_frames) + 1);
+	WRITE_ONCE(dsi->last_frame_jiffies, jiffies);
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	if (dsi->scanout_active) {
+		faulted = READ_ONCE(dsi->fault_bits);
+		next_index = !faulted && dsi->queued_index >= 0 ?
+			dsi->queued_index : dsi->front_index;
+		if (faulted || micronux_native_dma_arm_frame(dsi, next_index)) {
+			rearm_failed = !faulted;
+		} else {
+			if (dsi->queued_index >= 0) {
+				dsi->front_index = dsi->queued_index;
+				dsi->queued_index = -1;
+				dsi->flip_completions++;
+			}
+			dsi->source_generation++;
+		}
+	}
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+	if (rearm_failed) {
+		WRITE_ONCE(dsi->last_dma_error, BIT(30));
+		micronux_latch_fault(dsi, MICRONUX_FAULT_DMA);
+	}
+	return IRQ_HANDLED;
+}
