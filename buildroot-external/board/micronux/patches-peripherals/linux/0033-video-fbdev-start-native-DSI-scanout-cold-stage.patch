+		DW_GDMA_INT_ECC_ERROR_MASK ||
+	    readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA) !=
+		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
+		 DW_GDMA_INT_STATUS0_RO_MASK) ||
+	    readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1) !=
+		DW_GDMA_INT_ECC_ERROR_MASK ||
+	    readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA) !=
+		DW_GDMA_INT_COMMON_VALID_MASK ||
+	    readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA) !=
+		DW_GDMA_INT_COMMON_VALID_MASK ||
+	    (readl(dsi->gdma + DW_GDMA_CHEN) & GENMASK(3, 0)))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=gdma-irq state=CONFIGURED controller=enabled irq-master=masked ch=0 cfg=0000000f:0a020001 completion=full-transfer errors=status0-ecc-common irq-route=24:18 descriptors=one-frame-last irq=registered source=stopped immutable-enables=ch0-bit25,ch1-bits0-3,common-bit7-bits9-20\n");
+	return 0;
+}
+
+static bool micronux_native_pms_route_valid(struct micronux_dsi *dsi)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	u32 front_end = handoff->framebuffer_address[0] +
+			handoff->framebuffer_size;
+	u32 descriptor_end = handoff->dma_descriptor_address +
+			     MICRONUX_COLD_PAGE_SIZE;
+	u32 route = readl(dsi->intr_matrix +
+			  INTR_MATRIX_ROUTE(handoff->gdma_irq_source));
+
+	return (route & INTR_MATRIX_ROUTE_MASK) == handoff->gdma_clic_irq &&
+	       micronux_pms_region_matches(dsi, 1,
+					   handoff->framebuffer_address[0],
+					   front_end) &&
+	       micronux_pms_region_matches(dsi, 2,
+					   ESP32P4_DISPLAY_POOL_START,
+					   ESP32P4_DISPLAY_POOL_END) &&
+	       micronux_pms_region_matches(dsi, 3,
+					   handoff->dma_descriptor_address,
+					   descriptor_end) &&
+	       micronux_pms_region_matches(dsi, 4,
+					   ESP32P4_DSI_FIFO_ADDRESS,
+					   ESP32P4_DSI_FIFO_WINDOW_END) &&
+	       readl(dsi->dma_pms + DMA_PMS_GDMA_CH0_R) ==
+		(DMA_PMS_REGION1_MASK | DMA_PMS_REGION2_MASK |
+		 DMA_PMS_REGION3_MASK) &&
+	       readl(dsi->dma_pms + DMA_PMS_GDMA_CH0_W) ==
+		(DMA_PMS_REGION3_MASK | DMA_PMS_REGION4_MASK);
+}
+
+static bool micronux_native_runtime_policy_valid(struct micronux_dsi *dsi)
+{
+	u32 clocks0, clocks1, index, peri03, reset, sar;
+	bool source_valid = false;
+
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	clocks0 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+	clocks1 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	sar = readl(dsi->channel + DW_GDMA_CH_SAR);
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		u32 start = dsi->handoff.framebuffer_address[index];
+
+		/* A completed one-shot can expose the exact end before ISR rearm. */
+		if (sar >= start && sar <= start + dsi->handoff.framebuffer_size)
+			source_valid = true;
+	}
+
+	return !(reset & (HP_CLKRST_GDMA_RESET |
+			   HP_CLKRST_DSI_BRIDGE_RESET)) &&
+	       (clocks0 & HP_CLKRST_GDMA_CPU_CLK_EN) &&
+	       (clocks1 & (HP_CLKRST_GDMA_SYS_CLK_EN |
+			    HP_CLKRST_DSI_SYS_CLK_EN)) ==
+		(HP_CLKRST_GDMA_SYS_CLK_EN | HP_CLKRST_DSI_SYS_CLK_EN) &&
+	       (peri03 & (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+			  HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+			  HP_CLKRST_DSI_DPI_CLK_EN |
+			  HP_CLKRST_DSI_DPI_CLK_SRC |
+			  HP_CLKRST_DSI_DPI_CLK_DIV)) ==
+		HP_CLKRST_DSI_DPI_CLOCK_VALUE &&
+	       micronux_cold_ldo_matches(dsi) &&
+	       micronux_cold_i2c_released(dsi) &&
+	       micronux_native_pms_route_valid(dsi) &&
+	       !(readl(dsi->host + DSI_HOST_MODE_CFG) & BIT(0)) &&
+	       readl(dsi->host + DSI_HOST_VID_MODE_CFG) ==
+		DSI_HOST_NATIVE_VIDEO_POLICY &&
+	       readl(dsi->host + DSI_HOST_VID_MODE_CFG_ACT) ==
+		DSI_HOST_NATIVE_VIDEO_POLICY_ACT &&
+	       readl(dsi->host + DSI_HOST_LPCLK_CTRL) ==
+		DSI_HOST_CLOCK_LANE_AUTO &&
+	       !(readl(dsi->host + DSI_HOST_VID_MODE_CFG) &
+		 DSI_HOST_VPG_MASK) &&
+	       readl(dsi->bridge + DSI_BRG_CLK_EN) == 0 &&
+	       readl(dsi->bridge + DSI_BRG_EN) == DSI_BRG_MODULE_EN &&
+	       readl(dsi->bridge + DSI_BRG_BURST_LEN) ==
+		DSI_BRG_NATIVE_BURST_LEN &&
+	       (readl(dsi->bridge + DSI_BRG_RAW_NUM_CONFIG) &
+		GENMASK(22, 0)) == DSI_BRG_NATIVE_RAW_NUM &&
+	       readl(dsi->bridge + DSI_BRG_CREDIT_CONFIG) ==
+		DSI_BRG_NATIVE_CREDIT &&
+	       readl(dsi->bridge + DSI_BRG_PIXEL_TYPE) ==
+		DSI_BRG_NATIVE_PIXEL_TYPE &&
+	       readl(dsi->bridge + DSI_BRG_DMA_BLOCK_INTERVAL) ==
+		DSI_BRG_NATIVE_BLOCK_INTERVAL &&
+	       readl(dsi->bridge + DSI_BRG_DMA_REQUEST_INTERVAL) ==
+		DSI_BRG_NATIVE_REQUEST_INTERVAL &&
+	       readl(dsi->bridge + DSI_BRG_V_TIMING0) ==
+		DSI_BRG_NATIVE_V_TIMING0 &&
+	       readl(dsi->bridge + DSI_BRG_V_TIMING1) ==
+		DSI_BRG_NATIVE_V_TIMING1 &&
+	       readl(dsi->bridge + DSI_BRG_H_TIMING0) ==
+		DSI_BRG_NATIVE_H_TIMING0 &&
+	       readl(dsi->bridge + DSI_BRG_H_TIMING1) ==
+		DSI_BRG_NATIVE_H_TIMING1 &&
+	       readl(dsi->bridge + DSI_BRG_DPI_MISC_CONFIG) ==
+		DSI_BRG_NATIVE_MISC_ON &&
+	       readl(dsi->bridge + DSI_BRG_FRAME_INTERVAL) ==
+		DSI_BRG_NATIVE_FRAME_INTERVAL &&
+	       readl(dsi->bridge + DSI_BRG_HOST_CTRL) ==
+		DSI_BRG_NATIVE_HOST_CTRL &&
+	       readl(dsi->bridge + DSI_BRG_MEM_CLK_CTRL) == 0 &&
+	       readl(dsi->bridge + DSI_BRG_DMA_FLOW_CTRL) ==
+		DSI_BRG_NATIVE_DMA_FLOW &&
+	       readl(dsi->bridge + DSI_BRG_FIFO_EMPTY_THRESHOLD) ==
+		DSI_BRG_NATIVE_FIFO_THRESHOLD &&
+	       readl(dsi->gdma + DW_GDMA_CFG) == 3 &&
+	       !(readl(dsi->gdma + DW_GDMA_CHEN) & GENMASK(3, 1)) &&
+	       readl(dsi->channel + DW_GDMA_CH_CFG_LO) ==
+		MICRONUX_DMA_CHANNEL_CFG_LO &&
+	       readl(dsi->channel + DW_GDMA_CH_CFG_HI) ==
+		MICRONUX_DMA_CHANNEL_CFG_HI &&
+	       readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA) ==
+		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
+		 DW_GDMA_INT_STATUS0_RO_MASK) &&
+	       readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1) ==
+		DW_GDMA_INT_ECC_ERROR_MASK &&
+	       readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA) ==
+		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
+		 DW_GDMA_INT_STATUS0_RO_MASK) &&
+	       readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1) ==
+		DW_GDMA_INT_ECC_ERROR_MASK &&
+	       readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA) ==
+		DW_GDMA_INT_COMMON_VALID_MASK &&
+	       readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA) ==
+		DW_GDMA_INT_COMMON_VALID_MASK &&
+	       source_valid &&
+	       micronux_pool_guards_valid(dsi, false);
+}
+
+static int micronux_native_start_scanout(struct micronux_dsi *dsi)
+{
+	u32 common, initial_generation, status, status0, status1, top, window;
+	int ret;
+
+	dsi->front_index = 0;
+	dsi->render_index = 1;
+	dsi->queued_index = -1;
+	/* The global IRQ master stays masked across this final clean snapshot. */
+	if (readl(dsi->gdma + DW_GDMA_CFG) != 1)
+		return -EIO;
+	top = readl(dsi->gdma + DW_GDMA_INT_STATUS);
+	status0 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS);
+	status1 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS1);
+	common = readl(dsi->gdma + DW_GDMA_INT_COMMON_STATUS);
+	if (micronux_sample_host_status(dsi, 0) ||
+	    !micronux_host_status_clean(dsi) ||
+	    READ_ONCE(dsi->last_dma_error) || READ_ONCE(dsi->fault_bits) ||
+	    (readl(dsi->bridge + DSI_BRG_INT_RAW) & DSI_BRG_INT_UNDERRUN) ||
+	    (top & ~DW_GDMA_INT_TOP_ALLOWED) ||
+	    (status0 & DW_GDMA_INT_NATIVE_SCANOUT_MASK) ||
+	    (status1 & DW_GDMA_INT_ECC_ERROR_MASK) ||
+	    (common & DW_GDMA_INT_COMMON_VALID_MASK))
+		return -EIO;
+	dsi->scanout_active = true;
+	/* From this point every new source is delivered; never clear it blindly. */
+	writel(3, dsi->gdma + DW_GDMA_CFG);
+	if (readl(dsi->gdma + DW_GDMA_CFG) != 3 ||
+	    READ_ONCE(dsi->last_dma_error) || READ_ONCE(dsi->fault_bits))
+		return -EIO;
+	ret = micronux_native_dma_arm_frame(dsi, dsi->front_index);
+	if (ret)
+		return ret;
+	writel(0, dsi->host + DSI_HOST_MODE_CFG);
+	writel(DSI_BRG_NATIVE_MISC_ON,
+	       dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+	writel(1, dsi->bridge + DSI_BRG_DPI_CONFIG_UPDATE);
+	readl(dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+
+	for (window = 0; window < MICRONUX_NATIVE_QUALIFICATION_WINDOWS;
+	     window++) {
+		initial_generation = READ_ONCE(dsi->source_generation);
+		ret = read_poll_timeout(READ_ONCE, status,
+					(u32)(status - initial_generation) >=
+						MICRONUX_SCANOUT_STABLE_FRAMES,
+					1000,
+					MICRONUX_SCANOUT_START_TIMEOUT_MS * 1000,
+					false, dsi->source_generation);
+		if (ret ||
+		    micronux_sample_host_status(dsi, 0) ||
+		    !micronux_host_status_clean(dsi) ||
+		    READ_ONCE(dsi->last_dma_error) ||
+		    READ_ONCE(dsi->fault_bits) ||
+		    (readl(dsi->bridge + DSI_BRG_INT_RAW) &
+		     DSI_BRG_INT_UNDERRUN) ||
+		    !micronux_pool_guards_valid(dsi, true) ||
+		    !micronux_native_runtime_policy_valid(dsi))
+			return ret ? ret : -EIO;
+	}
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=scanout-qualification state=PASSED windows=2 frames-per-window=4 completions=8 source-generation=8 host-errors=0 gdma-errors=0 ecc-errors=0 common-errors=0 bridge-underruns=0 guards=verified source=black\n");
+	return 0;
+}
+
+static bool micronux_native_final_status_clean(struct micronux_dsi *dsi)
+{
+	return !micronux_sample_host_status(dsi, 0) &&
+	       micronux_host_status_clean(dsi) &&
+	       !(readl(dsi->bridge + DSI_BRG_INT_RAW) &
+		 DSI_BRG_INT_UNDERRUN) &&
+	       !(readl(dsi->channel + DW_GDMA_CH_INT_STATUS) &
+		 DW_GDMA_INT_ERROR_MASK) &&
+	       !(readl(dsi->channel + DW_GDMA_CH_INT_STATUS1) &
+		 DW_GDMA_INT_ECC_ERROR_MASK) &&
+	       !(readl(dsi->gdma + DW_GDMA_INT_COMMON_STATUS) &
+		 DW_GDMA_INT_COMMON_VALID_MASK) &&
+	       !READ_ONCE(dsi->last_dma_error) &&
+	       !READ_ONCE(dsi->fault_bits) &&
+	       micronux_pool_guards_valid(dsi, true) &&
+	       micronux_native_runtime_policy_valid(dsi);
+}
+
+static bool micronux_cold_runtime_teardown(struct micronux_dsi *dsi)
+{
+	u32 abort_mask, channel, peri03, reset, state, value;
+	bool registers_contained = true, stopped = true;
+
+	WRITE_ONCE(dsi->render_enabled, false);
+	/* Close the render gate before revoking published scanout readiness. */
+	smp_wmb();
+	WRITE_ONCE(dsi->scanout_ready, false);
+	WRITE_ONCE(dsi->boot_display_ready, false);
+	WRITE_ONCE(dsi->scanout_active, false);
+	if (dsi->cold_timer_initialized) {
+		hrtimer_cancel(&dsi->scanout_timer);
+		dsi->cold_timer_initialized = false;
+	}
+	/* Drain a renderer that passed the gate before it was closed. */
+	mutex_lock(&dsi->render_lock);
+	dsi->render_dirty = false;
+	mutex_unlock(&dsi->render_lock);
+	/* A drained renderer may have queued this work before releasing lock. */
+	cancel_delayed_work_sync(&dsi->render_work);
+
+	if (dsi->cold_bridge_active || dsi->cold_dpi_enabled) {
+		writel(DSI_BRG_NATIVE_MISC_OFF,
+		       dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+		writel(1, dsi->bridge + DSI_BRG_DPI_CONFIG_UPDATE);
+		writel(0, dsi->bridge + DSI_BRG_EN);
+		writel(1, dsi->host + DSI_HOST_MODE_CFG);
+	}
+	if (dsi->cold_gdma_active) {
+		writel(0, dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+		writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR);
+		writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
+		writel(DW_GDMA_INT_COMMON_VALID_MASK,
+		       dsi->gdma + DW_GDMA_INT_CLEAR);
+		channel = BIT(dsi->handoff.dma_channel);
+		abort_mask = channel | (channel << 8);
+		writel(channel << 8, dsi->gdma + DW_GDMA_CHEN);
+		if (readl_poll_timeout_atomic(dsi->gdma + DW_GDMA_CHEN,
+					      state, !(state & channel), 1,
+					      1000)) {
+			/* Abort is only the bounded fallback for a hung channel. */
+			writel(abort_mask, dsi->gdma + DW_GDMA_CHABORT);
+			if (readl_poll_timeout_atomic(dsi->gdma + DW_GDMA_CHABORT,
+						      state,
+						      !(state & abort_mask), 1,
+						      1000) ||
+			    (readl(dsi->gdma + DW_GDMA_CHEN) & channel))
+				stopped = false;
+		}
+		/* Disable the global interrupt master before releasing the IRQ. */
+		writel(0, dsi->channel + DW_GDMA_CH_INT_STATUS_ENA);
+		writel(0, dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_STATUS_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_CFG);
+		if (readl(dsi->gdma + DW_GDMA_CFG))
+			stopped = false;
+	}
+	if (dsi->cold_irq_registered) {
+		devm_free_irq(dsi->dev, dsi->irq, dsi);
+		dsi->cold_irq_registered = false;
+	}
+	if (dsi->cold_gdma_active) {
+		writel(0, dsi->channel + DW_GDMA_CH_INT_STATUS_ENA);
+		writel(0, dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_STATUS_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_CFG);
+		writel(1, dsi->gdma + DW_GDMA_RESET);
+		if (readl_poll_timeout(dsi->gdma + DW_GDMA_RESET, value,
+				       !(value & BIT(0)), 1, 1000))
+			stopped = false;
+		writel(0, dsi->channel + DW_GDMA_CH_INT_STATUS_ENA);
+		writel(0, dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_STATUS_ENA);
+		writel(0, dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+		writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR);
+		writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
+		writel(DW_GDMA_INT_COMMON_VALID_MASK,
+		       dsi->gdma + DW_GDMA_INT_CLEAR);
+		/* P4 hw_ver3 retains the documented RO-one interrupt residues. */
+		registers_contained =
+			readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA) ==
+				DW_GDMA_INT_STATUS0_RO_MASK &&
+			readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1) ==
+				DW_GDMA_INT_ECC_ERROR_MASK &&
+			readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA) ==
+				DW_GDMA_INT_STATUS0_RO_MASK &&
+			readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1) ==
+				DW_GDMA_INT_ECC_ERROR_MASK &&
+			readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA) ==
+				DW_GDMA_INT_COMMON_RO_MASK &&
+			readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA) ==
+				DW_GDMA_INT_COMMON_RO_MASK &&
+			!readl(dsi->gdma + DW_GDMA_CFG) &&
+			!(readl(dsi->gdma + DW_GDMA_CHEN) & GENMASK(3, 0));
+		dsi->cold_gdma_active = false;
+	}
+	if (dsi->cold_gdma_hp_mutated) {
+		/* HP clock/reset containment is safe even if GDMA was inaccessible. */
+		reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+		writel(reset | HP_CLKRST_GDMA_RESET,
+		       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+		value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+		writel(value & ~HP_CLKRST_GDMA_CPU_CLK_EN,
+		       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+		value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+		writel(value & ~HP_CLKRST_GDMA_SYS_CLK_EN,
+		       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+		dsi->cold_gdma_hp_mutated = false;
+	}
+	if (dsi->cold_dpi_enabled) {
+		peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+		writel(peri03 & ~HP_CLKRST_DSI_DPI_CLK_EN,
+		       dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+		dsi->cold_dpi_enabled = false;
+	}
+	dsi->cold_bridge_active = false;
+	if (dsi->cold_fb_registered) {
+		unregister_framebuffer(dsi->info);
+		dsi->cold_fb_registered = false;
+	}
+
+	return stopped && registers_contained && !dsi->cold_irq_registered &&
+	       !dsi->cold_fb_registered &&
+	       !(readl(dsi->bridge + DSI_BRG_EN) & DSI_BRG_MODULE_EN) &&
+	       !(readl(dsi->bridge + DSI_BRG_DPI_MISC_CONFIG) &
+		 DSI_BRG_DPI_EN) &&
+	       (readl(dsi->host + DSI_HOST_MODE_CFG) & BIT(0)) &&
+	       (readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0) &
+		 HP_CLKRST_GDMA_RESET) &&
+	       !(readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0) &
+		 HP_CLKRST_GDMA_CPU_CLK_EN) &&
+	       !(readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1) &
+		 HP_CLKRST_GDMA_SYS_CLK_EN) &&
+	       !(readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03) &
+		 HP_CLKRST_DSI_DPI_CLK_EN);
+}
+
+static void micronux_cold_runtime_fail_quiescent(struct micronux_dsi *dsi,
+						 const char *stage, int error)
+{
+	bool runtime_off;
+
+	runtime_off = micronux_cold_runtime_teardown(dsi);
+	WRITE_ONCE(dsi->cold_runtime_unverified, !runtime_off);
+	micronux_cold_fail_quiescent(dsi, stage, error);
+}
+
+static int micronux_cold_initialize_scanout_stage(struct micronux_dsi *dsi)
+{
+	int ret;
+
+	if (dsi->display_state !=
+		MICRONUX_DISPLAY_STATE_PANEL_PROGRAMMED_QUIESCENT ||
+	    !micronux_cold_stage_c_matches(dsi) ||
+	    !micronux_native_pms_route_valid(dsi)) {
+		ret = -EIO;
+		goto fail_precondition;
+	}
+	dsi->display_state = MICRONUX_DISPLAY_STATE_SCANOUT_INITIALIZING;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT state=SCANOUT_INITIALIZING stage=native-dpi-gdma-fb source=none render-gate=closed external-command-history=pwm0-control13-acked physical-panel-state=unobserved\n");
+	micronux_bind_cold_runtime_profile(dsi);
+	/* Establish the software baseline before any native interrupt is live. */
+	WRITE_ONCE(dsi->scanout_frames, 0);
+	WRITE_ONCE(dsi->source_generation, 0);
+	WRITE_ONCE(dsi->last_dma_error, 0);
+	WRITE_ONCE(dsi->host_error0, 0);
+	WRITE_ONCE(dsi->host_error1, 0);
+	WRITE_ONCE(dsi->bridge_underruns, 0);
+	WRITE_ONCE(dsi->fault_bits, 0);
+	ret = micronux_native_initialize_memory(dsi);
+	if (ret)
+		goto fail_memory;
