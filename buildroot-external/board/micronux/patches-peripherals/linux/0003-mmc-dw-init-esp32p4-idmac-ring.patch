From 02cd28961e472ca385cc51a9eea58d0d94753056 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sat, 8 Aug 2026 04:42:00 -0700
Subject: [PATCH 03/16] mmc: dw: initialize the ESP32-P4 IDMAC ring

Reserve the correct number of 64-byte descriptors and clear the internal-SRAM
ring before the ESP32-P4 controller starts.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 drivers/mmc/host/dw_mmc.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -586,3 +586,6 @@ static int dw_mci_idmac_init(struct dw_mci *host)
 
-	if (host->dma_64bit_address == 1) {
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+		host->ring_size = DESC_RING_BUF_SZ / ESP32P4_IDMAC_DESC_SIZE;
+		memset(host->sg_cpu, 0, DESC_RING_BUF_SZ);
+	} else if (host->dma_64bit_address == 1) {
 		struct idmac_desc_64addr *p;
