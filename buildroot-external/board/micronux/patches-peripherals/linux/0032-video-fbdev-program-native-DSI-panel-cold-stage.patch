+static int micronux_cold_dcs_write(struct micronux_dsi *dsi, u8 command,
+				   const u8 *parameters,
+				   size_t parameter_count)
+{
+	size_t byte_index, payload_size = parameter_count + 1;
+	u32 header, status, status0, status1;
+	int ret;
+
+	if (parameter_count > MICRONUX_DSI_MAX_PARAMETERS ||
+	    (parameter_count && !parameters))
+		return -EINVAL;
+	micronux_discard_host_status(dsi);
+	if (payload_size > 2) {
+		for (byte_index = 0; byte_index < payload_size;
+		     byte_index += sizeof(u32)) {
+			u32 byte, word = 0;
+
+			for (byte = 0; byte < sizeof(u32) &&
+			     byte_index + byte < payload_size; byte++) {
+				u8 value = byte_index + byte ?
+					parameters[byte_index + byte - 1] : command;
+
+				word |= (u32)value << (byte * 8);
+			}
+			ret = readl_poll_timeout(dsi->host +
+						 DSI_HOST_CMD_PKT_STATUS,
+					 status,
+					 !(status &
+					   DSI_HOST_CMD_PKT_GEN_PLD_W_FULL),
+					 10,
+					 MICRONUX_DISPLAY_COLD_PACKET_TIMEOUT_US);
+			if (ret)
+				return ret;
+			writel(word, dsi->host + DSI_HOST_GEN_PLD_DATA);
+		}
+		header = MIPI_DSI_DT_DCS_LONG_WRITE |
+			 (payload_size << 8);
+	} else if (payload_size == 2) {
+		header = MIPI_DSI_DT_DCS_SHORT_WRITE_1 |
+			 ((u32)command << 8) | ((u32)parameters[0] << 16);
+	} else {
+		header = MIPI_DSI_DT_DCS_SHORT_WRITE_0 |
+			 ((u32)command << 8);
+	}
+	ret = readl_poll_timeout(dsi->host + DSI_HOST_CMD_PKT_STATUS,
+				 status,
+				 !(status & DSI_HOST_CMD_PKT_GEN_CMD_FULL), 10,
+				 MICRONUX_DISPLAY_COLD_PACKET_TIMEOUT_US);
+	if (ret)
+		return ret;
+	writel(header, dsi->host + DSI_HOST_GEN_HDR);
+	ret = readl_poll_timeout(dsi->host + DSI_HOST_CMD_PKT_STATUS,
+				 status,
+				 (status & DSI_HOST_CMD_PKT_ALL_EMPTY) ==
+				 DSI_HOST_CMD_PKT_ALL_EMPTY, 10,
+				 MICRONUX_DISPLAY_COLD_PACKET_TIMEOUT_US);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(dsi->host + DSI_HOST_PHY_STATUS, status,
+				 (status & DSI_HOST_PHY_READY_MASK) ==
+				 DSI_HOST_PHY_READY_MASK, 10,
+				 MICRONUX_DISPLAY_COLD_PACKET_TIMEOUT_US);
+	if (ret)
+		return ret;
+	if (micronux_cold_host_status(dsi, &status0, &status1)) {
+		dev_err(dsi->dev,
+			"DSI command 0x%02x completed with errors: st0=%08x st1=%08x\n",
+			command, status0, status1);
+		return -EIO;
+	}
+	return 0;
+}
