+static int micronux_cold_release_panel(struct micronux_dsi *dsi)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	int ret;
+
+	ret = micronux_cold_i2c_initialize(dsi);
+	if (ret)
+		return ret;
+	ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+				      handoff->backlight_register, 0);
+	if (ret)
+		return ret;
+	ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+				      handoff->display_control_register,
+				      handoff->display_control_reset_prepare_command);
+	if (ret)
+		return ret;
+	msleep(MICRONUX_DISPLAY_COLD_PANEL_RELEASE_MS);
+	if (!micronux_cold_i2c_gate(dsi) ||
+	    !micronux_cold_i2c_released(dsi))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=panel-release state=READY pwm-zero-command=acked control-command=0x13 control-transaction=acked settle-ms=130 i2c0=released-gated physical-panel-state=unobserved\n");
+	return 0;
+}
