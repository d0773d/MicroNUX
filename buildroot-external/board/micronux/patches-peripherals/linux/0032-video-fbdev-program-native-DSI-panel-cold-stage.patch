 struct micronux_dsi {
 	struct device *dev;
 	void __iomem *host;
@@ -584,6 +662,8 @@ struct micronux_dsi {
 	bool touch_down;
 	bool cold_i2c_active;
 	bool cold_ldo_enabled;
+	bool cold_dsi_active;
+	bool cold_ref20_enabled_by_linux;
 	struct hrtimer scanout_timer;
 	struct work_struct fault_work;
 };
@@ -2801,6 +2881,175 @@ static int micronux_cold_ldo_enable(struct micronux_dsi *dsi,
 	return 0;
 }
 
+static bool micronux_cold_ldo_matches(struct micronux_dsi *dsi)
+{
+	struct micronux_ldo_calibration cal = { };
+	u32 ana, control;
+
+	if (!dsi->cold_ldo_enabled)
+		return false;
+	micronux_cold_ldo_calculate(dsi, &cal);
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	ana = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	return (control & (PMU_EXT_LDO_FORCE_TIEH_SEL | PMU_EXT_LDO_XPD |
+			   PMU_EXT_LDO_TIEH_SEL | PMU_EXT_LDO_TIEH)) ==
+		       (PMU_EXT_LDO_FORCE_TIEH_SEL | PMU_EXT_LDO_XPD) &&
+	       (ana & (PMU_EXT_LDO_DREF | PMU_EXT_LDO_MUL |
+		       PMU_EXT_LDO_EN_VDET)) ==
+		       (FIELD_PREP(PMU_EXT_LDO_DREF, cal.dref) |
+			FIELD_PREP(PMU_EXT_LDO_MUL, cal.mul) |
+			PMU_EXT_LDO_EN_VDET);
+}
+
+static bool micronux_cold_i2c_released(struct micronux_dsi *dsi)
+{
+	u32 pins = BIT(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO) |
+		   BIT(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO);
+	u32 scl, sda;
+
+	if (dsi->cold_i2c_active ||
+	    (readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10) &
+	     HP_CLKRST_I2C0_CLK_EN) ||
+	    (readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2) &
+	     HP_CLKRST_I2C0_APB_CLK_EN) ||
+	    (readl(dsi->gpio + GPIO_ENABLE) & pins) ||
+	    (readl(dsi->gpio +
+		   GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO)) &
+	     GPIO_PIN_PAD_DRIVER) ||
+	    (readl(dsi->gpio +
+		   GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO)) &
+	     GPIO_PIN_PAD_DRIVER))
+		return false;
+	sda = readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SDA_SIGNAL));
+	scl = readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SCL_SIGNAL));
+	return (sda & (GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT |
+		       GPIO_FUNC_IN_MATRIX)) ==
+		       (FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+				   GPIO_MATRIX_CONST_ZERO_INPUT) |
+			GPIO_FUNC_IN_MATRIX) &&
+	       (scl & (GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT |
+		       GPIO_FUNC_IN_MATRIX)) ==
+		       (FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+				   GPIO_MATRIX_CONST_ZERO_INPUT) |
+			GPIO_FUNC_IN_MATRIX);
+}
+
+static int
+micronux_panel_firmware_validate(struct micronux_dsi *dsi,
+				 const struct firmware *firmware,
+				 struct micronux_panel_firmware *panel)
+{
+	static const u8 prelude_commands[] = { 0xe0, 0x36, 0x3a, 0x80 };
+	static const u8 prelude_parameters[] = { 0x00, 0x00, 0x55, 0x01 };
+	const u8 *cursor, *end, *payload;
+	u16 actual_max_delay = 0;
+	u8 actual_max_parameters = 0;
+	u32 crc, payload_bytes, payload_crc;
+	u16 index, record_count;
+
+	if (firmware->size != MICRONUX_PANEL_FIRMWARE_TOTAL_BYTES)
+		return -EINVAL;
+	if (memcmp(firmware->data, "MNJD9365", 8) ||
+	    get_unaligned_le16(firmware->data + 8) !=
+		    MICRONUX_PANEL_FIRMWARE_VERSION ||
+	    get_unaligned_le16(firmware->data + 10) !=
+		    MICRONUX_PANEL_FIRMWARE_HEADER_BYTES)
+		return -EINVAL;
+	record_count = get_unaligned_le16(firmware->data + 12);
+	if (record_count != MICRONUX_PANEL_FIRMWARE_RECORDS ||
+	    get_unaligned_le16(firmware->data + 14) !=
+		    MICRONUX_PANEL_FIRMWARE_PRELUDE_RECORDS)
+		return -EINVAL;
+	payload_bytes = get_unaligned_le32(firmware->data + 16);
+	payload_crc = get_unaligned_le32(firmware->data + 20);
+	if (payload_bytes != MICRONUX_PANEL_FIRMWARE_PAYLOAD_BYTES ||
+	    payload_crc != MICRONUX_DISPLAY_COLD_PANEL_PAYLOAD_CRC32 ||
+	    payload_crc != dsi->cold_handoff.panel_payload_crc32 ||
+	    get_unaligned_le32(firmware->data + 24) !=
+		    MICRONUX_PANEL_FIRMWARE_FLAGS ||
+	    get_unaligned_le16(firmware->data + 28) !=
+		    MICRONUX_PANEL_FIRMWARE_MAX_PARAMETERS ||
+	    get_unaligned_le16(firmware->data + 30) !=
+		    MICRONUX_PANEL_FIRMWARE_MAX_DELAY_MS ||
+	    firmware->size != MICRONUX_PANEL_FIRMWARE_HEADER_BYTES +
+			      payload_bytes)
+		return -EINVAL;
+	payload = firmware->data + MICRONUX_PANEL_FIRMWARE_HEADER_BYTES;
+	crc = crc32_le(~0U, payload, payload_bytes) ^ ~0U;
+	if (crc != payload_crc)
+		return -EBADMSG;
+
+	cursor = payload;
+	end = payload + payload_bytes;
+	for (index = 0; index < record_count; index++) {
+		u16 delay;
+		u8 command, parameters;
+
+		if (end - cursor < 4)
+			return -EINVAL;
+		command = cursor[0];
+		parameters = cursor[1];
+		delay = get_unaligned_le16(cursor + 2);
+		cursor += 4;
+		if (parameters > MICRONUX_PANEL_FIRMWARE_MAX_PARAMETERS ||
+		    end - cursor < parameters ||
+		    delay > MICRONUX_PANEL_FIRMWARE_MAX_DELAY_MS)
+			return -EINVAL;
+		if (index < ARRAY_SIZE(prelude_commands) &&
+		    (command != prelude_commands[index] || parameters != 1 ||
+		     cursor[0] != prelude_parameters[index] || delay))
+			return -EINVAL;
+		if (index == record_count - 2 &&
+		    (command != 0x11 || parameters != 1 || cursor[0] ||
+		     delay != 120))
+			return -EINVAL;
+		if (index == record_count - 1 &&
+		    (command != 0x29 || parameters != 1 || cursor[0] ||
+		     delay != 20))
+			return -EINVAL;
+		actual_max_parameters = max(actual_max_parameters, parameters);
+		actual_max_delay = max(actual_max_delay, delay);
+		cursor += parameters;
+	}
+	if (cursor != end ||
+	    actual_max_parameters != MICRONUX_PANEL_FIRMWARE_MAX_PARAMETERS ||
+	    actual_max_delay != MICRONUX_PANEL_FIRMWARE_MAX_DELAY_MS)
+		return -EINVAL;
+
+	panel->firmware = firmware;
+	panel->payload = payload;
+	panel->payload_bytes = payload_bytes;
+	panel->record_count = record_count;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=firmware state=VALIDATED format=1 bytes=1052 payload-bytes=1020 records=204 prelude=4 flags=00000007 payload-crc=cea07f9b max-parameters=1 max-delay-ms=120 display-writes=0\n");
+	return 0;
+}
+
+static int
+micronux_panel_firmware_request(struct micronux_dsi *dsi,
+				struct micronux_panel_firmware *panel)
+{
+	const struct firmware *firmware;
+	int ret;
+
+	ret = request_firmware(&firmware, MICRONUX_DISPLAY_COLD_FIRMWARE,
+			       dsi->dev);
+	if (ret)
+		return ret;
+	ret = micronux_panel_firmware_validate(dsi, firmware, panel);
+	if (ret)
+		release_firmware(firmware);
+	return ret;
+}
+
+static void
+micronux_panel_firmware_release(struct micronux_panel_firmware *panel)
+{
+	if (panel->firmware)
+		release_firmware(panel->firmware);
+	memset(panel, 0, sizeof(*panel));
+}
+
 static bool micronux_cold_display_blocks_quiescent(struct micronux_dsi *dsi)
 {
 	u32 clocks0, clocks1, peri03, reset;
@@ -2820,6 +3069,406 @@ static bool micronux_cold_display_blocks_quiescent(struct micronux_dsi *dsi)
 			    HP_CLKRST_DSI_DPI_CLK_EN));
 }
 
+static int micronux_cold_stage_c_precondition(struct micronux_dsi *dsi)
+{
+	u32 ref1;
+
+	ref1 = readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL1);
+	if (dsi->display_state != MICRONUX_DISPLAY_STATE_LDO_READY ||
+	    !micronux_cold_ldo_matches(dsi) ||
+	    !micronux_cold_i2c_released(dsi) ||
+	    !micronux_cold_display_blocks_quiescent(dsi) ||
+	    FIELD_GET(HP_CLKRST_REF20_DIV, ref1) !=
+		    HP_CLKRST_REF20_DIV_VALUE)
+		return -EIO;
+	return 0;
+}
+
+static void micronux_cold_phy_write(struct micronux_dsi *dsi, u8 address,
+				    u8 value)
+{
+	writel(0, dsi->host + DSI_HOST_PHY_TST_CTRL0);
+	writel(BIT(16) | address, dsi->host + DSI_HOST_PHY_TST_CTRL1);
+	writel(BIT(1), dsi->host + DSI_HOST_PHY_TST_CTRL0);
+	writel(0, dsi->host + DSI_HOST_PHY_TST_CTRL0);
+	writel(value, dsi->host + DSI_HOST_PHY_TST_CTRL1);
+	writel(BIT(1), dsi->host + DSI_HOST_PHY_TST_CTRL0);
+	writel(0, dsi->host + DSI_HOST_PHY_TST_CTRL0);
+}
+
+static bool micronux_cold_dsi_matches(struct micronux_dsi *dsi)
+{
+	u32 clocks0, clocks1, peri03, reset;
+
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	clocks0 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+	clocks1 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	return !(reset & HP_CLKRST_DSI_BRIDGE_RESET) &&
+	       (reset & HP_CLKRST_GDMA_RESET) &&
+	       !(clocks0 & HP_CLKRST_GDMA_CPU_CLK_EN) &&
+	       (clocks1 & (HP_CLKRST_GDMA_SYS_CLK_EN |
+			   HP_CLKRST_DSI_SYS_CLK_EN)) ==
+			   HP_CLKRST_DSI_SYS_CLK_EN &&
+	       (peri03 & (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+			  HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+			  HP_CLKRST_DSI_DPI_CLK_EN)) ==
+		       (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+			HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN) &&
+	       FIELD_GET(HP_CLKRST_DSI_DPHY_CLK_SRC,
+			 readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL02)) == 0 &&
+	       (readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2) &
+		HP_CLKRST_REF20_CLK_EN) &&
+	       (readl(dsi->host + DSI_HOST_PWR_UP) & BIT(0)) &&
+	       (readl(dsi->host + DSI_HOST_PHY_RSTZ) &
+		DSI_HOST_PHY_RSTZ_READY) == DSI_HOST_PHY_RSTZ_READY &&
+	       readl(dsi->host + DSI_HOST_PHY_IF_CFG) ==
+		DSI_HOST_PHY_IF_TWO_LANES &&
+	       (readl(dsi->host + DSI_HOST_PHY_STATUS) &
+		DSI_HOST_PHY_READY_MASK) == DSI_HOST_PHY_READY_MASK &&
+	       (readl(dsi->host + DSI_HOST_MODE_CFG) & BIT(0)) &&
+	       readl(dsi->host + DSI_HOST_LPCLK_CTRL) ==
+		DSI_HOST_CLOCK_LANE_AUTO &&
+	       readl(dsi->host + DSI_HOST_PHY_TMR_CFG) ==
+		DSI_HOST_PHY_TMR_VALUE &&
