+	writel(1, dsi->host + DSI_HOST_MODE_CFG);
+	writel(DSI_HOST_CLOCK_LANE_AUTO,
+	       dsi->host + DSI_HOST_LPCLK_CTRL);
+	writel(DSI_HOST_PHY_TMR_VALUE,
+	       dsi->host + DSI_HOST_PHY_TMR_CFG);
+	writel(DSI_HOST_PHY_TMR_LPCLK_VALUE,
+	       dsi->host + DSI_HOST_PHY_TMR_LPCLK_CFG);
+	writel(DSI_HOST_PCKHDL_VALUE, dsi->host + DSI_HOST_PCKHDL_CFG);
+	writel(DSI_HOST_CLKMGR_VALUE, dsi->host + DSI_HOST_CLKMGR_CFG);
+	writel(0, dsi->host + DSI_HOST_TO_CNT_CFG);
+	writel(0, dsi->host + DSI_HOST_HS_RD_TO_CNT);
+	writel(0, dsi->host + DSI_HOST_LP_RD_TO_CNT);
+	writel(0, dsi->host + DSI_HOST_HS_WR_TO_CNT);
+	writel(0, dsi->host + DSI_HOST_LP_WR_TO_CNT);
+	writel(0, dsi->host + DSI_HOST_BTA_TO_CNT);
+	writel(6000, dsi->host + DSI_HOST_PHY_TMR_RD_CFG);
+	writel(DSI_HOST_PHY_IF_TWO_LANES,
+	       dsi->host + DSI_HOST_PHY_IF_CFG);
+	writel(0, dsi->host + DSI_HOST_GEN_VCID);
+	writel(DSI_HOST_CMD_MODE_DBI_LP,
+	       dsi->host + DSI_HOST_CMD_MODE_CFG);
+	if (!micronux_cold_dsi_matches(dsi))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=native-dsi state=READY idf=v6.0.1 ref=pll-f20m lane-mbps=1500 lanes=2 pll-m=150 pll-n=2 range=3c host=command dbi=lp cmd-ack=requested lpclk=00000003 phy=locked-stopped bridge=disabled dpi-clock=off gdma-reset=asserted gdma-clocks=off irq=unregistered\n");
+	return 0;
+}
