+				 status & BIT(0), 10,
+				 MICRONUX_DISPLAY_COLD_PHY_TIMEOUT_US);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(dsi->host + DSI_HOST_PHY_STATUS, status,
+				 (status & lanes) == lanes, 10,
+				 MICRONUX_DISPLAY_COLD_PHY_TIMEOUT_US);
