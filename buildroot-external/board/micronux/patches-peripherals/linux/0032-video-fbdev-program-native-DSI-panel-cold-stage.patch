 #define GPIO_PIN_PAD_DRIVER		BIT(2)
@@ -485,7 +554,9 @@ enum micronux_display_state {
 	MICRONUX_DISPLAY_STATE_PROBED_QUIESCENT,
 	MICRONUX_DISPLAY_STATE_COLD_INITIALIZING,
 	MICRONUX_DISPLAY_STATE_LDO_READY,
