+static int
+micronux_cold_program_panel(struct micronux_dsi *dsi,
+			    const struct micronux_panel_firmware *panel)
+{
+	const u8 *cursor = panel->payload;
+	const u8 *end = panel->payload + panel->payload_bytes;
+	u16 index;
+	int ret;
+
+	ret = micronux_cold_dcs_write(dsi, 0x01, NULL, 0);
+	if (ret)
+		return ret;
+	msleep(MICRONUX_DISPLAY_COLD_SWRESET_MS);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=software-reset state=COMPLETE packet=dcs-short-zero command=0x01 parameters=0 delay-ms=120 status=no-latched-errors ack-result=unclaimed\n");
+	for (index = 0; index < panel->record_count; index++) {
+		u16 delay = get_unaligned_le16(cursor + 2);
+		u8 command = cursor[0];
+		u8 parameters = cursor[1];
+
+		cursor += 4;
+		ret = micronux_cold_dcs_write(dsi, command, cursor, parameters);
+		if (ret) {
+			dev_err(dsi->dev,
+				"panel firmware record %u command 0x%02x failed: %d\n",
+				index, command, ret);
+			return ret;
+		}
+		cursor += parameters;
+		if (delay)
+			msleep(delay);
+	}
+	if (cursor != end)
+		return -EINVAL;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=panel-commands state=COMPLETE records=204 packets=204 payload-crc=cea07f9b status=no-latched-errors ack-result=unclaimed\n");
+	return 0;
+}
