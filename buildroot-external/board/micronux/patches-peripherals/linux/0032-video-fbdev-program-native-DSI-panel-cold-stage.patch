+static bool micronux_cold_stage_c_matches(struct micronux_dsi *dsi)
+{
+	return dsi->cold_dsi_active &&
+	       micronux_cold_ldo_matches(dsi) &&
+	       micronux_cold_i2c_released(dsi) &&
+	       micronux_cold_dsi_matches(dsi);
+}
