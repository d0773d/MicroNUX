+static bool micronux_cold_dsi_disable(struct micronux_dsi *dsi)
+{
+	bool disable_ref20 = dsi->cold_ref20_enabled_by_linux;
+	bool ref20_off = true;
+	u32 peri03, ref2, reset, value;
+
+	value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	if ((value & HP_CLKRST_DSI_SYS_CLK_EN) &&
+	    !(reset & HP_CLKRST_DSI_BRIDGE_RESET)) {
+		writel(0, dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+		writel(0, dsi->bridge + DSI_BRG_EN);
+		writel(0, dsi->bridge + DSI_BRG_INT_ENA);
+		writel(~0U, dsi->bridge + DSI_BRG_INT_CLR);
+		writel(0, dsi->host + DSI_HOST_PHY_RSTZ);
+		writel(0, dsi->host + DSI_HOST_PWR_UP);
+		writel(0, dsi->bridge + DSI_BRG_CLK_EN);
+	}
+	writel(reset | HP_CLKRST_DSI_BRIDGE_RESET,
+	       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	writel(peri03 & ~(HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+			  HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+			  HP_CLKRST_DSI_DPI_CLK_EN),
+	       dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	writel(value & ~HP_CLKRST_DSI_SYS_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	if (disable_ref20) {
+		ref2 = readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2);
+		writel(ref2 & ~HP_CLKRST_REF20_CLK_EN,
+		       dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2);
+		ref20_off = !(readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2) &
+			      HP_CLKRST_REF20_CLK_EN);
+		dsi->cold_ref20_enabled_by_linux = !ref20_off;
+	}
+	dsi->cold_dsi_active = false;
+	return ref20_off && micronux_cold_display_blocks_quiescent(dsi);
+}
