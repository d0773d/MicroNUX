+static int micronux_cold_dsi_enable(struct micronux_dsi *dsi)
+{
+	u32 lanes = DSI_HOST_PHY_READY_MASK & ~BIT(0);
+	u32 peri02, peri03, ref2, reset, status, value;
+	int ret;
+
+	ref2 = readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2);
+	if (!(ref2 & HP_CLKRST_REF20_CLK_EN)) {
+		writel(ref2 | HP_CLKRST_REF20_CLK_EN,
+		       dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2);
+		dsi->cold_ref20_enabled_by_linux = true;
+	}
+	peri02 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL02);
+	peri02 &= ~HP_CLKRST_DSI_DPHY_CLK_SRC;
+	writel(peri02, dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL02);
+	value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	writel(value | HP_CLKRST_DSI_SYS_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	dsi->cold_dsi_active = true;
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	writel(reset | HP_CLKRST_DSI_BRIDGE_RESET,
+	       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	writel(reset & ~HP_CLKRST_DSI_BRIDGE_RESET,
+	       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	peri03 &= ~(HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+		    HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+		    HP_CLKRST_DSI_DPI_CLK_EN);
+	peri03 |= HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+		  HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN;
+	writel(peri03, dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+
+	if (!(readl(dsi->hp_clkrst + HP_CLKRST_REF_CLK_CTRL2) &
+	      HP_CLKRST_REF20_CLK_EN) ||
+	    FIELD_GET(HP_CLKRST_DSI_DPHY_CLK_SRC,
+		      readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL02)) ||
+	    !(readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1) &
+	      HP_CLKRST_DSI_SYS_CLK_EN) ||
+	    (readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0) &
+	     HP_CLKRST_DSI_BRIDGE_RESET) ||
+	    (readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03) &
+	     (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+	      HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+	      HP_CLKRST_DSI_DPI_CLK_EN)) !=
+	     (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+	      HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN))
+		return -EIO;
+
+	writel(0, dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+	writel(0, dsi->bridge + DSI_BRG_EN);
+	writel(0, dsi->bridge + DSI_BRG_CLK_EN);
+	writel(0, dsi->bridge + DSI_BRG_INT_ENA);
+	writel(~0U, dsi->bridge + DSI_BRG_INT_CLR);
+	writel(DSI_HOST_INT_STATUS0_VALID,
+	       dsi->host + DSI_HOST_INT_MASK0);
+	writel(DSI_HOST_INT_STATUS1_VALID,
+	       dsi->host + DSI_HOST_INT_MASK1);
+	micronux_discard_host_status(dsi);
+
+	/* Exact ESP-IDF v6.0.1 two-lane host and D-PHY power-up order. */
+	writel(1, dsi->host + DSI_HOST_PHY_IF_CFG);
+	writel(1, dsi->host + DSI_HOST_PWR_UP);
+	writel(BIT(0), dsi->host + DSI_HOST_PHY_RSTZ);
+	writel(BIT(0) | BIT(1), dsi->host + DSI_HOST_PHY_RSTZ);
+	writel(BIT(0) | BIT(1) | BIT(2), dsi->host + DSI_HOST_PHY_RSTZ);
+	writel(DSI_HOST_PHY_RSTZ_READY, dsi->host + DSI_HOST_PHY_RSTZ);
+
+	/* PLL_F20M at 20 MHz, 1500 Mbps: M=150, N=2, range selector 0x3c. */
+	micronux_cold_phy_write(dsi, 0x44, 0x78);
+	micronux_cold_phy_write(dsi, 0x19, 0x30);
+	micronux_cold_phy_write(dsi, 0x17, 0x01);
+	micronux_cold_phy_write(dsi, 0x18, 0x15);
+	micronux_cold_phy_write(dsi, 0x18, 0x84);
