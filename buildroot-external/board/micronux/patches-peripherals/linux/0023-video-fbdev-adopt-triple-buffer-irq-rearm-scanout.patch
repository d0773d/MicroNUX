+static int micronux_validate_display_pool(struct device_node *node)
+{
+	struct device_node *pool;
+	struct resource resource;
+	int ret;
+
+	pool = of_parse_phandle(node, "memory-region", 0);
+	if (!pool)
+		return -EINVAL;
+	ret = of_address_to_resource(pool, 0, &resource);
+	of_node_put(pool);
+	if (ret)
+		return ret;
+	if (resource.start != ESP32P4_DISPLAY_POOL_START ||
+	    resource_size(&resource) !=
+		ESP32P4_DISPLAY_POOL_END - ESP32P4_DISPLAY_POOL_START)
+		return -EINVAL;
+	return 0;
+}
