+static void micronux_initialize_pool_guards(struct micronux_dsi *dsi)
+{
+	u32 guard_size = ESP32P4_DISPLAY_SLOT_SIZE -
+			 dsi->handoff.framebuffer_size;
+	u8 index;
+
+	for (index = 1; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++)
+		memset_io(dsi->framebuffer[index] +
+			  dsi->handoff.framebuffer_size,
+			  ESP32P4_DISPLAY_GUARD_PATTERN, guard_size);
+}
+
+static bool micronux_pool_guards_valid(struct micronux_dsi *dsi, bool full)
+{
+	u32 guard_size = ESP32P4_DISPLAY_SLOT_SIZE -
+			 dsi->handoff.framebuffer_size;
+	u32 offset;
+	u8 index;
+
+	for (index = 1; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
+		void __iomem *guard = dsi->framebuffer[index] +
+				      dsi->handoff.framebuffer_size;
+
+		if (readl(guard) != ESP32P4_DISPLAY_GUARD_WORD ||
+		    readl(guard + guard_size - sizeof(u32)) !=
+			    ESP32P4_DISPLAY_GUARD_WORD)
+			return false;
+		if (!full)
+			continue;
+		for (offset = sizeof(u32); offset < guard_size - sizeof(u32);
+		     offset += sizeof(u32))
+			if (readl(guard + offset) != ESP32P4_DISPLAY_GUARD_WORD)
+				return false;
+	}
+	return true;
+}
