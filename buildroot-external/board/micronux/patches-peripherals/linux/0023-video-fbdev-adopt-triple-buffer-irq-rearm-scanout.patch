+
+static void micronux_copy_frame(struct micronux_dsi *dsi, u8 destination,
+				u8 source)
+{
+	u8 __iomem *dst = dsi->framebuffer[destination];
+	u8 __iomem *src = dsi->framebuffer[source];
+	u32 offset = 0;
+
+	while (offset < dsi->handoff.framebuffer_size) {
+		u32 chunk = min_t(u32, MICRONUX_FB_WRITE_CHUNK,
+				  dsi->handoff.framebuffer_size - offset);
+
+		fb_memcpy_toio(dst + offset,
+			       (const void __force *)(src + offset), chunk);
+		offset += chunk;
+		if (offset < dsi->handoff.framebuffer_size)
+			udelay(MICRONUX_FB_WRITE_GAP_US);
+	}
+}
+
+/* Caller holds render_lock; the source stays front or queued while copied. */
+static void micronux_prepare_render_locked(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+	u8 destination, source;
+
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	if (!dsi->render_needs_sync) {
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+		return;
+	}
+	destination = dsi->render_index;
+	source = dsi->queued_index >= 0 ? dsi->queued_index :
+		 dsi->front_index;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+
+	micronux_copy_frame(dsi, destination, source);
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	dsi->render_needs_sync = false;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+}
+
+static u8 micronux_free_buffer_locked(struct micronux_dsi *dsi,
+				      u8 front, s8 queued)
+{
+	u8 index;
+
+	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++)
+		if (index != front && index != queued)
+			return index;
+	return dsi->render_index;
+}
+
+/* Publish a complete back buffer; the IRQ selects it at a frame boundary. */
+static void micronux_queue_render_locked(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+	u8 rendered = dsi->render_index;
+	u8 front;
+	s8 queued;
+
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	if (READ_ONCE(dsi->fault_bits)) {
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+		return;
+	}
+	if (!dsi->scanout_active) {
+		if (dsi->queued_index != rendered)
+			dsi->flip_requests++;
+		dsi->queued_index = rendered;
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+		return;
+	}
+	dsi->queued_index = rendered;
+	dsi->flip_requests++;
+	front = dsi->front_index;
+	queued = dsi->queued_index;
+	dsi->render_index = micronux_free_buffer_locked(dsi, front, queued);
+	dsi->render_needs_sync = true;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+	micronux_set_render_mapping_locked(dsi);
+}
+
+static void micronux_commit_render_locked(struct micronux_dsi *dsi)
+{
+	if (!dsi->render_dirty)
+		return;
+	dsi->render_dirty = false;
+	micronux_queue_render_locked(dsi);
+}
+
+static void micronux_render_work(struct work_struct *work)
+{
+	struct micronux_dsi *dsi = container_of(to_delayed_work(work),
+						 struct micronux_dsi, render_work);
+
+	mutex_lock(&dsi->render_lock);
+	micronux_commit_render_locked(dsi);
+	mutex_unlock(&dsi->render_lock);
+}
+
+/* Batch fbcon primitives into one complete page flip per display interval. */
+static void micronux_mark_render_dirty_locked(struct micronux_dsi *dsi)
