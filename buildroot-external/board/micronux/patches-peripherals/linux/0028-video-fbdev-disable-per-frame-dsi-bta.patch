From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MicroNUX <micronux@example.invalid>
Date: Wed, 12 Aug 2026 00:00:00 -0700
Subject: [PATCH 28/47] video: fbdev: disable per-frame DSI BTA

The JD9365 compatibility profile repeatedly fills both DSI host pixel
payload FIFOs while the D-PHY data lanes are parked.  The host reports
DPI_PLD_WR_ERR after two clean four-frame DMA qualification windows even
though GDMA progresses and the bridge reports no underrun.

Stop requesting a bus-turnaround acknowledgment after every video frame.
Keep automatic clock-lane control, low-power blanking, burst video, and the
strict host-error gate unchanged.  This isolates the observed unbounded
frame-ack wait without masking the resulting FIFO-corruption status.

Signed-off-by: MicroNUX <micronux@example.invalid>
---
 drivers/video/fbdev/esp32p4-dsi.c | 31 ++++++++++++++++---------------
 1 file changed, 16 insertions(+), 15 deletions(-)

diff --git a/drivers/video/fbdev/esp32p4-dsi.c b/drivers/video/fbdev/esp32p4-dsi.c
index e95f0917abef..7c038da2eaa9 100644
--- a/drivers/video/fbdev/esp32p4-dsi.c
+++ b/drivers/video/fbdev/esp32p4-dsi.c
@@ -1320,8 +1320,8 @@ static void micronux_select_framebuffer(struct micronux_dsi *dsi)
 
 	lpclk &= ~DSI_HOST_PHY_TXREQUESTCLKHS;
 	lpclk |= DSI_HOST_AUTO_CLKLANE_CTRL;
-	host &= ~DSI_HOST_VPG_MASK;
-	host |= DSI_HOST_FRAME_BTA_ACK_EN | DSI_HOST_LP_VIDEO_EN_MASK;
+	host &= ~(DSI_HOST_VPG_MASK | DSI_HOST_FRAME_BTA_ACK_EN);
+	host |= DSI_HOST_LP_VIDEO_EN_MASK;
 	writel(lpclk, dsi->host + DSI_HOST_LPCLK_CTRL);
 	writel(host, dsi->host + DSI_HOST_VID_MODE_CFG);
 	writel(bridge | DSI_BRG_DPI_EN,
@@ -1343,9 +1343,9 @@ static bool micronux_source_policy_valid(struct micronux_dsi *dsi,
 	return (host & DSI_HOST_VID_MODE_TYPE_MASK) ==
 		DSI_HOST_VID_MODE_BURST &&
 	       (host & DSI_HOST_VPG_MASK) == expected_vpg &&
-	       (host & (DSI_HOST_FRAME_BTA_ACK_EN |
-			DSI_HOST_LP_VIDEO_EN_MASK)) ==
-		(DSI_HOST_FRAME_BTA_ACK_EN | DSI_HOST_LP_VIDEO_EN_MASK) &&
+	       !(host & DSI_HOST_FRAME_BTA_ACK_EN) &&
+	       (host & DSI_HOST_LP_VIDEO_EN_MASK) ==
+		DSI_HOST_LP_VIDEO_EN_MASK &&
 	       (lpclk & (DSI_HOST_PHY_TXREQUESTCLKHS |
 			 DSI_HOST_AUTO_CLKLANE_CTRL)) ==
 	       DSI_HOST_AUTO_CLKLANE_CTRL &&
@@ -1667,6 +1667,6 @@ static ssize_t boot_ready_store(struct device *dev,
 	}
 	dev_info(dsi->dev,
-		 "MICRONUX:M9.2:SCANOUT state=running handoff=blanked-restart stable-frames=%u qualification-windows=2 buffers=3 dma=irq-rearm backlight=restored reveal=userspace-ready frame-ack=enabled clock=auto lp=enabled backlight-gate=enabled\n",
+		 "MICRONUX:M9.2:SCANOUT state=running handoff=blanked-restart stable-frames=%u qualification-windows=2 buffers=3 dma=irq-rearm backlight=restored reveal=userspace-ready frame-ack=disabled clock=auto lp=enabled backlight-gate=enabled\n",
 		 MICRONUX_SCANOUT_STABLE_FRAMES);
 out:
 	mutex_unlock(&dsi->backlight->ops_lock);
@@ -1907,7 +1907,7 @@ static ssize_t scanout_show(struct device *dev,
 			    struct device_attribute *attribute, char *buf)
 {
 	struct micronux_dsi *dsi = dev_get_drvdata(dev);
-	bool clock_forced_hs, frame_ack_disabled, lp_disabled;
+	bool clock_auto, frame_ack_disabled, lp_enabled;
 	bool guards_valid;
 	unsigned long faults, flags;
 	u32 active, before, after, error, channel_enable, host, lpclk, underruns;
@@ -1941,24 +1941,25 @@ static ssize_t scanout_show(struct device *dev,
 	spin_unlock_irqrestore(&dsi->state_lock, flags);
 	frame_ack_disabled = !(host & DSI_HOST_FRAME_BTA_ACK_EN) &&
 			     !(active & DSI_HOST_FRAME_BTA_ACK_EN_ACT);
-	clock_forced_hs = (lpclk & (DSI_HOST_PHY_TXREQUESTCLKHS |
-				       DSI_HOST_AUTO_CLKLANE_CTRL)) ==
-			  DSI_HOST_PHY_TXREQUESTCLKHS;
-	lp_disabled = !(host & DSI_HOST_LP_VIDEO_EN_MASK) &&
-		      !(active & DSI_HOST_LP_VIDEO_EN_ACT_MASK);
+	clock_auto = (lpclk & (DSI_HOST_PHY_TXREQUESTCLKHS |
+				  DSI_HOST_AUTO_CLKLANE_CTRL)) ==
+		     DSI_HOST_AUTO_CLKLANE_CTRL;
+	lp_enabled = (host & DSI_HOST_LP_VIDEO_EN_MASK) ==
+		     DSI_HOST_LP_VIDEO_EN_MASK &&
+		     !(active & DSI_HOST_LP_VIDEO_EN_ACT_MASK);
 
 	return sysfs_emit(buf,
 			  "%s frames=%u->%u error=%08x underruns=%u chen=%u faults=%lx host-errors=%08x:%08x frame-ack=%s clock=%s lp=%s backlight-gate=%s buffers=3 front=%u queued=%d back=%u rearm=%u/%u flips=%u/%u generation=%u guards=%s guard-errors=%u\n",
 			  after != before && !error && !underruns && !faults &&
 			  !host_error0 && !host_error1 &&
 			  guards_valid &&
-			  !frame_ack_disabled && !clock_forced_hs && !lp_disabled ?
+			  frame_ack_disabled && clock_auto && lp_enabled ?
 			  "running" : "stalled",
 			  before, after, error, underruns, !!channel_enable,
 			  faults, host_error0, host_error1,
 			  frame_ack_disabled ? "off" : "on",
-			  clock_forced_hs ? "forced-hs" : "auto",
-			  lp_disabled ? "disabled" : "enabled",
+			  clock_auto ? "auto" : "invalid",
+			  lp_enabled ? "enabled" : "invalid",
 			  READ_ONCE(dsi->backlight_gate_enabled) ? "on" : "off",
 			  front, queued, render, rearm_attempts,
 			  rearm_failures, flip_requests, flip_completions,
-- 
2.47.0
