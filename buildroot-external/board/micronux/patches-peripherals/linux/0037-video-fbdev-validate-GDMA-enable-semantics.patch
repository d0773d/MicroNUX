From 39e452858f8e9ba130bf9594b75836527833d3e4 Mon Sep 17 00:00:00 2001
From: d0773d <dottedquad@gmail.com>
Date: Wed, 12 Aug 2026 04:39:32 -0700
Subject: [PATCH 37/48] video: fbdev: validate GDMA enable semantics

ESP32-P4 rev 1.3 returns one for undefined bits in the DW-GDMA
interrupt-enable registers. Compare every documented hw_ver1 field while
ignoring only undefined positions so valid native scanout is accepted.

Apply the same semantic check during setup, runtime health validation, and
teardown containment. Keep all programming and fail-dark diagnostics
unchanged.

Signed-off-by: d0773d <dottedquad@gmail.com>
---
 drivers/video/fbdev/esp32p4-dsi.c | 73 +++++++++++++++++++++----------
 1 file changed, 50 insertions(+), 23 deletions(-)

diff --git a/drivers/video/fbdev/esp32p4-dsi.c b/drivers/video/fbdev/esp32p4-dsi.c
index 8e16257..520b502 100644
--- a/drivers/video/fbdev/esp32p4-dsi.c
+++ b/drivers/video/fbdev/esp32p4-dsi.c
@@ -333,9 +333,16 @@
 #define DW_GDMA_INT_NATIVE_SCANOUT_MASK \
 	(DW_GDMA_INT_DMA_TFR_DONE | DW_GDMA_INT_ERROR_MASK)
 #define DW_GDMA_INT_STATUS0_RO_MASK	BIT(25)
+/* P4 rev 1.3 uses IDF's hw_ver1 view; compare every documented bit. */
+/* Undefined positions are reserved read-as-one fields on this silicon. */
+#define DW_GDMA_INT_STATUS0_DEFINED_MASK \
+	(GENMASK(1, 0) | GENMASK(14, 3) | GENMASK(21, 16) | BIT(25) | \
+	 GENMASK(31, 27))
 #define DW_GDMA_INT_ECC_ERROR_MASK	GENMASK(3, 0)
+#define DW_GDMA_INT_STATUS1_DEFINED_MASK	GENMASK(3, 0)
 #define DW_GDMA_INT_COMMON_VALID_MASK	0x001fff8f
 #define DW_GDMA_INT_COMMON_RO_MASK	0x001ffe80
+#define DW_GDMA_INT_COMMON_DEFINED_MASK	DW_GDMA_INT_COMMON_VALID_MASK
 #define DW_GDMA_INT_TOP_CHANNEL0	BIT(0)
 #define DW_GDMA_INT_TOP_INACTIVE	GENMASK(3, 1)
 #define DW_GDMA_INT_TOP_COMMON		BIT(16)
@@ -5437,14 +5444,20 @@ static int micronux_native_configure_gdma(struct micronux_dsi *dsi)
 	if (cfg != 1 ||
 	    cfg_lo != MICRONUX_DMA_CHANNEL_CFG_LO ||
 	    cfg_hi != MICRONUX_DMA_CHANNEL_CFG_HI ||
-	    st_ena0 != (DW_GDMA_INT_NATIVE_SCANOUT_MASK |
-			DW_GDMA_INT_STATUS0_RO_MASK) ||
-	    st_ena1 != DW_GDMA_INT_ECC_ERROR_MASK ||
-	    sig_ena0 != (DW_GDMA_INT_NATIVE_SCANOUT_MASK |
-			 DW_GDMA_INT_STATUS0_RO_MASK) ||
-	    sig_ena1 != DW_GDMA_INT_ECC_ERROR_MASK ||
-	    common_st_ena != DW_GDMA_INT_COMMON_VALID_MASK ||
-	    common_sig_ena != DW_GDMA_INT_COMMON_VALID_MASK ||
+	    (st_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) !=
+		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
+		 DW_GDMA_INT_STATUS0_RO_MASK) ||
+	    (st_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) !=
+		DW_GDMA_INT_ECC_ERROR_MASK ||
+	    (sig_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) !=
+		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
+		 DW_GDMA_INT_STATUS0_RO_MASK) ||
+	    (sig_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) !=
+		DW_GDMA_INT_ECC_ERROR_MASK ||
+	    (common_st_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) !=
+		DW_GDMA_INT_COMMON_VALID_MASK ||
+	    (common_sig_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) !=
+		DW_GDMA_INT_COMMON_VALID_MASK ||
 	    (chen & GENMASK(3, 0))) {
 		dev_err(dsi->dev,
 			"MICRONUX:M9.2:COLD-INIT stage=gdma-irq reason=register-readback cfg=%08x cfglo=%08x cfghi=%08x stena0=%08x stena1=%08x sigena0=%08x sigena1=%08x common-stena=%08x common-sigena=%08x chen=%08x expected=00000001:0000000f:0a020001:023f7fe2:0000000f:023f7fe2:0000000f:001fff8f:001fff8f:chen[3:0]=0\n",
@@ -5519,7 +5532,8 @@ static bool micronux_native_i2c_policy_valid(struct micronux_dsi *dsi)
 
 static bool micronux_native_runtime_policy_valid(struct micronux_dsi *dsi)
 {
-	u32 clocks0, clocks1, index, peri03, reset, sar;
+	u32 clocks0, clocks1, common_sig_ena, common_st_ena, index, peri03;
+	u32 reset, sar, sig_ena0, sig_ena1, st_ena0, st_ena1;
 	bool source_valid = false;
 
 	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
@@ -5527,6 +5541,12 @@ static bool micronux_native_runtime_policy_valid(struct micronux_dsi *dsi)
 	clocks1 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
 	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
 	sar = readl(dsi->channel + DW_GDMA_CH_SAR);
+	st_ena0 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA);
+	st_ena1 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1);
+	sig_ena0 = readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+	sig_ena1 = readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1);
+	common_st_ena = readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA);
+	common_sig_ena = readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
 	for (index = 0; index < MICRONUX_DISPLAY_BUFFER_COUNT; index++) {
 		u32 start = dsi->handoff.framebuffer_address[index];
 
@@ -5598,19 +5618,19 @@ static bool micronux_native_runtime_policy_valid(struct micronux_dsi *dsi)
 		MICRONUX_DMA_CHANNEL_CFG_LO &&
 	       readl(dsi->channel + DW_GDMA_CH_CFG_HI) ==
 		MICRONUX_DMA_CHANNEL_CFG_HI &&
-	       readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA) ==
+	       (st_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) ==
 		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
 		 DW_GDMA_INT_STATUS0_RO_MASK) &&
-	       readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1) ==
+	       (st_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) ==
 		DW_GDMA_INT_ECC_ERROR_MASK &&
-	       readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA) ==
+	       (sig_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) ==
 		(DW_GDMA_INT_NATIVE_SCANOUT_MASK |
 		 DW_GDMA_INT_STATUS0_RO_MASK) &&
-	       readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1) ==
+	       (sig_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) ==
 		DW_GDMA_INT_ECC_ERROR_MASK &&
-	       readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA) ==
+	       (common_st_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) ==
 		DW_GDMA_INT_COMMON_VALID_MASK &&
-	       readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA) ==
+	       (common_sig_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) ==
 		DW_GDMA_INT_COMMON_VALID_MASK &&
 	       source_valid &&
 	       micronux_pool_guards_valid(dsi, false);
@@ -5767,7 +5787,8 @@ micronux_native_requalify_front(struct micronux_dsi *dsi, u64 target)
 
 static bool micronux_cold_runtime_teardown(struct micronux_dsi *dsi)
 {
-	u32 abort_mask, channel, peri03, reset, state, value;
+	u32 abort_mask, channel, common_sig_ena, common_st_ena, peri03, reset;
+	u32 sig_ena0, sig_ena1, st_ena0, st_ena1, state, value;
 	bool registers_contained = true, stopped = true;
 
 	WRITE_ONCE(dsi->render_enabled, false);
@@ -5848,19 +5869,25 @@ static bool micronux_cold_runtime_teardown(struct micronux_dsi *dsi)
 		writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
 		writel(DW_GDMA_INT_COMMON_VALID_MASK,
 		       dsi->gdma + DW_GDMA_INT_CLEAR);
-		/* P4 hw_ver3 retains the documented RO-one interrupt residues. */
+		st_ena0 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA);
+		st_ena1 = readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1);
+		sig_ena0 = readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		sig_ena1 = readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1);
+		common_st_ena = readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA);
+		common_sig_ena = readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA);
+		/* The documented hw_ver1 RO-one fields remain after disable. */
 		registers_contained =
-			readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA) ==
+			(st_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) ==
 				DW_GDMA_INT_STATUS0_RO_MASK &&
-			readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA1) ==
+			(st_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) ==
 				DW_GDMA_INT_ECC_ERROR_MASK &&
-			readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA) ==
+			(sig_ena0 & DW_GDMA_INT_STATUS0_DEFINED_MASK) ==
 				DW_GDMA_INT_STATUS0_RO_MASK &&
-			readl(dsi->channel + DW_GDMA_CH_INT_SIGNAL_ENA1) ==
+			(sig_ena1 & DW_GDMA_INT_STATUS1_DEFINED_MASK) ==
 				DW_GDMA_INT_ECC_ERROR_MASK &&
-			readl(dsi->gdma + DW_GDMA_INT_STATUS_ENA) ==
+			(common_st_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) ==
 				DW_GDMA_INT_COMMON_RO_MASK &&
-			readl(dsi->gdma + DW_GDMA_INT_SIGNAL_ENA) ==
+			(common_sig_ena & DW_GDMA_INT_COMMON_DEFINED_MASK) ==
 				DW_GDMA_INT_COMMON_RO_MASK &&
 			!readl(dsi->gdma + DW_GDMA_CFG) &&
 			!(readl(dsi->gdma + DW_GDMA_CHEN) & GENMASK(3, 0));
-- 
2.54.0.windows.1
