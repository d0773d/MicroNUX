+static ssize_t cold_init_store(struct device *dev,
+			       struct device_attribute *attribute,
+			       const char *buf, size_t count)
+{
+	struct micronux_dsi *dsi = dev_get_drvdata(dev);
+	bool start;
+	int ret;
+
+	ret = kstrtobool(buf, &start);
+	if (ret)
+		return ret;
+	if (!start)
+		return -EINVAL;
+
+	mutex_lock(&dsi->mode_lock);
+	if (dsi->display_state !=
+	    MICRONUX_DISPLAY_STATE_PROBED_QUIESCENT) {
+		ret = -EALREADY;
+		goto unlock;
+	}
+	dsi->display_state = MICRONUX_DISPLAY_STATE_COLD_INITIALIZING;
+	ret = micronux_cold_initialize_ldo_stage(dsi);
+unlock:
+	mutex_unlock(&dsi->mode_lock);
+	return ret ? ret : count;
+}
