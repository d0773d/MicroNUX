@@ -289,6 +327,39 @@
 #define I2C_TX_FIFO_RST			BIT(13)
 #define I2C_COMMAND_DONE		BIT(31)
 #define I2C_ERROR_MASK			(BIT(5) | BIT(8) | BIT(10))
+#define I2C_TIMEOUT_VALUE		GENMASK(4, 0)
+#define I2C_TIMEOUT_ENABLE		BIT(5)
+#define I2C_NONFIFO_ENABLE		BIT(10)
+#define I2C_TIMING_9BIT		GENMASK(8, 0)
