+static int micronux_cold_i2c_calculate_timing(struct micronux_i2c_timing *timing)
+{
+	u32 half_cycle, source_clock, source_per_us;
+
+	source_clock = MICRONUX_DISPLAY_COLD_I2C_SOURCE_HZ;
+	timing->clkm_div = source_clock /
+		(MICRONUX_DISPLAY_COLD_I2C_RATE_HZ * 1024) + 1;
+	if (!timing->clkm_div)
+		return -EINVAL;
+	half_cycle = source_clock / timing->clkm_div /
+		MICRONUX_DISPLAY_COLD_I2C_RATE_HZ / 2;
+	if (half_cycle < 4)
+		return -EINVAL;
+
+	timing->scl_low = half_cycle;
+	timing->scl_wait_high = half_cycle / 2 - 2;
+	timing->scl_high = half_cycle - timing->scl_wait_high;
+	timing->sda_hold = half_cycle / 4;
+	timing->sda_sample = half_cycle / 2;
+	timing->setup = half_cycle;
+	timing->hold = half_cycle;
+	timing->bus_timeout = fls(5 * half_cycle) + 2;
+	source_per_us = source_clock / 1000000;
+	timing->device_timeout = fls(source_per_us *
+		MICRONUX_DISPLAY_COLD_I2C_TIMEOUT_US);
+
+	if (timing->scl_wait_high >= timing->sda_sample ||
+	    timing->sda_sample >= timing->scl_high ||
+	    timing->clkm_div > 256 ||
+	    timing->scl_low > 512 || timing->scl_high > 511 ||
+	    timing->scl_wait_high > 127 ||
+	    timing->device_timeout > FIELD_MAX(I2C_TIMEOUT_VALUE))
+		return -EINVAL;
+	return 0;
+}
+
+static void micronux_cold_i2c_pin(struct micronux_dsi *dsi, u32 gpio,
+				  u32 signal)
+{
+	u32 value;
+
+	/* This is the exact HP-I2C pin order used by ESP-IDF v6.0.1. */
+	writel(BIT(gpio), dsi->gpio + GPIO_OUT_W1TS);
+	value = readl(dsi->iomux + IOMUX_GPIO(gpio));
+	value &= ~(IOMUX_PULLDOWN_ENABLE | IOMUX_FUNCTION);
+	value |= IOMUX_PULLUP_ENABLE | IOMUX_INPUT_ENABLE |
+		 FIELD_PREP(IOMUX_FUNCTION, IOMUX_FUNCTION_GPIO);
+	writel(value, dsi->iomux + IOMUX_GPIO(gpio));
+
+	value = readl(dsi->gpio + GPIO_PIN(gpio));
+	writel(value | GPIO_PIN_PAD_DRIVER,
+	       dsi->gpio + GPIO_PIN(gpio));
+
+	value = readl(dsi->gpio + GPIO_FUNC_OUT_SEL(gpio));
+	value &= ~(GPIO_FUNC_OUT_SOURCE | GPIO_FUNC_OUT_INVERT |
+		   GPIO_FUNC_OUT_OEN_GPIO | GPIO_FUNC_OUT_OEN_INVERT);
+	value |= FIELD_PREP(GPIO_FUNC_OUT_SOURCE, signal);
+	writel(value, dsi->gpio + GPIO_FUNC_OUT_SEL(gpio));
+
+	value = readl(dsi->gpio + GPIO_FUNC_IN_SEL(signal));
+	value &= ~(GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT |
+		   GPIO_FUNC_IN_MATRIX);
+	value |= FIELD_PREP(GPIO_FUNC_IN_SOURCE, gpio) |
+		 GPIO_FUNC_IN_MATRIX;
+	writel(value, dsi->gpio + GPIO_FUNC_IN_SEL(signal));
+}
+
+static void micronux_cold_i2c_release_pins(struct micronux_dsi *dsi)
+{
+	u32 value;
+
+	value = readl(dsi->gpio + GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO));
+	writel(value & ~GPIO_PIN_PAD_DRIVER,
+	       dsi->gpio + GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO));
+	value = readl(dsi->gpio + GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO));
+	writel(value & ~GPIO_PIN_PAD_DRIVER,
+	       dsi->gpio + GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO));
+	writel(BIT(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO) |
+	       BIT(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO),
+	       dsi->gpio + GPIO_ENABLE_W1TC);
+
+	value = readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SDA_SIGNAL));
+	value &= ~(GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT);
+	value |= FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+			    GPIO_MATRIX_CONST_ZERO_INPUT) |
+		 GPIO_FUNC_IN_MATRIX;
+	writel(value, dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SDA_SIGNAL));
+	value = readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SCL_SIGNAL));
+	value &= ~(GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT);
+	value |= FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+			    GPIO_MATRIX_CONST_ZERO_INPUT) |
+		 GPIO_FUNC_IN_MATRIX;
+	writel(value, dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SCL_SIGNAL));
+}
+
+static bool micronux_i2c_matches(struct micronux_dsi *dsi,
+				 const struct micronux_i2c_timing *timing)
+{
+	u32 peri, value;
+
+	if (!(readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2) &
+	      HP_CLKRST_I2C0_APB_CLK_EN) ||
+	    (readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN1) &
+	     HP_CLKRST_I2C0_RESET))
+		return false;
+	peri = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+	if ((peri & (HP_CLKRST_I2C0_CLK_SRC_RC_FAST |
+		     HP_CLKRST_I2C0_CLK_EN |
+		     HP_CLKRST_I2C0_CLK_DIV_NUM |
+		     HP_CLKRST_I2C0_CLK_DIV_NUMERATOR |
+		     HP_CLKRST_I2C0_CLK_DIV_DENOMINATOR)) !=
+	    (HP_CLKRST_I2C0_CLK_EN |
+	     FIELD_PREP(HP_CLKRST_I2C0_CLK_DIV_NUM,
+			timing->clkm_div - 1)))
+		return false;
+
+	value = readl(dsi->iomux +
+		      IOMUX_GPIO(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO));
+	if ((value & (IOMUX_PULLDOWN_ENABLE | IOMUX_PULLUP_ENABLE |
+		      IOMUX_INPUT_ENABLE | IOMUX_FUNCTION)) !=
+	    (IOMUX_PULLUP_ENABLE | IOMUX_INPUT_ENABLE |
+	     FIELD_PREP(IOMUX_FUNCTION, IOMUX_FUNCTION_GPIO)))
+		return false;
+	value = readl(dsi->iomux +
+		      IOMUX_GPIO(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO));
+	if ((value & (IOMUX_PULLDOWN_ENABLE | IOMUX_PULLUP_ENABLE |
+		      IOMUX_INPUT_ENABLE | IOMUX_FUNCTION)) !=
+	    (IOMUX_PULLUP_ENABLE | IOMUX_INPUT_ENABLE |
+	     FIELD_PREP(IOMUX_FUNCTION, IOMUX_FUNCTION_GPIO)))
+		return false;
+	if (!(readl(dsi->gpio +
+		    GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO)) &
+	      GPIO_PIN_PAD_DRIVER) ||
+	    !(readl(dsi->gpio +
+		    GPIO_PIN(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO)) &
+	      GPIO_PIN_PAD_DRIVER))
+		return false;
+	value = readl(dsi->gpio +
+		      GPIO_FUNC_OUT_SEL(MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO));
+	if ((value & (GPIO_FUNC_OUT_SOURCE | GPIO_FUNC_OUT_INVERT |
+		      GPIO_FUNC_OUT_OEN_GPIO | GPIO_FUNC_OUT_OEN_INVERT)) !=
+	    FIELD_PREP(GPIO_FUNC_OUT_SOURCE, GPIO_I2C0_SDA_SIGNAL))
+		return false;
+	value = readl(dsi->gpio +
+		      GPIO_FUNC_OUT_SEL(MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO));
+	if ((value & (GPIO_FUNC_OUT_SOURCE | GPIO_FUNC_OUT_INVERT |
+		      GPIO_FUNC_OUT_OEN_GPIO | GPIO_FUNC_OUT_OEN_INVERT)) !=
+	    FIELD_PREP(GPIO_FUNC_OUT_SOURCE, GPIO_I2C0_SCL_SIGNAL))
+		return false;
+	if ((readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SDA_SIGNAL)) &
+	     (GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT |
+	      GPIO_FUNC_IN_MATRIX)) !=
+	    (FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+			MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO) |
+	     GPIO_FUNC_IN_MATRIX) ||
+	    (readl(dsi->gpio + GPIO_FUNC_IN_SEL(GPIO_I2C0_SCL_SIGNAL)) &
+	     (GPIO_FUNC_IN_SOURCE | GPIO_FUNC_IN_INVERT |
+	      GPIO_FUNC_IN_MATRIX)) !=
+	    (FIELD_PREP(GPIO_FUNC_IN_SOURCE,
+			MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO) |
+	     GPIO_FUNC_IN_MATRIX))
+		return false;
+
+	if ((readl(dsi->i2c + I2C_CTR) &
+	     (BIT(0) | BIT(1) | BIT(3) | I2C_MS_MODE | BIT(6) | BIT(7) |
+	      BIT(9))) != I2C_MS_MODE ||
+	    (readl(dsi->i2c + I2C_FIFO_CONF) & I2C_NONFIFO_ENABLE))
+		return false;
+	if ((readl(dsi->i2c + I2C_SCL_LOW_PERIOD) & I2C_TIMING_9BIT) !=
+	    timing->scl_low - 1 ||
+	    (readl(dsi->i2c + I2C_SCL_HIGH_PERIOD) &
+	     (I2C_TIMING_9BIT | I2C_SCL_WAIT_HIGH)) !=
+	    (timing->scl_high |
+	     FIELD_PREP(I2C_SCL_WAIT_HIGH, timing->scl_wait_high)) ||
+	    (readl(dsi->i2c + I2C_SDA_HOLD) & I2C_TIMING_9BIT) !=
+	    timing->sda_hold - 1 ||
+	    (readl(dsi->i2c + I2C_SDA_SAMPLE) & I2C_TIMING_9BIT) !=
+	    timing->sda_sample - 1 ||
+	    (readl(dsi->i2c + I2C_SCL_RSTART_SETUP) & I2C_TIMING_9BIT) !=
+	    timing->setup - 1 ||
+	    (readl(dsi->i2c + I2C_SCL_STOP_SETUP) & I2C_TIMING_9BIT) !=
+	    timing->setup - 1 ||
+	    (readl(dsi->i2c + I2C_SCL_START_HOLD) & I2C_TIMING_9BIT) !=
+	    timing->hold - 1 ||
+	    (readl(dsi->i2c + I2C_SCL_STOP_HOLD) & I2C_TIMING_9BIT) !=
+	    timing->hold - 1)
+		return false;
+	if ((readl(dsi->i2c + I2C_TO) &
+	     (I2C_TIMEOUT_VALUE | I2C_TIMEOUT_ENABLE)) !=
+	    (FIELD_PREP(I2C_TIMEOUT_VALUE, timing->device_timeout) |
+	     I2C_TIMEOUT_ENABLE) ||
+	    (readl(dsi->i2c + I2C_FILTER_CFG) &
+	     (I2C_FILTER_SCL_THRESHOLD | I2C_FILTER_SDA_THRESHOLD |
+	      I2C_FILTER_SCL_ENABLE | I2C_FILTER_SDA_ENABLE)) !=
+	    (FIELD_PREP(I2C_FILTER_SCL_THRESHOLD,
+			MICRONUX_DISPLAY_COLD_I2C_FILTER) |
+	     FIELD_PREP(I2C_FILTER_SDA_THRESHOLD,
+			MICRONUX_DISPLAY_COLD_I2C_FILTER) |
+	     I2C_FILTER_SCL_ENABLE | I2C_FILTER_SDA_ENABLE))
+		return false;
+	return true;
+}
+
+static int micronux_cold_i2c_initialize(struct micronux_dsi *dsi)
+{
+	struct micronux_i2c_timing timing = { };
+	u32 ctr, fifo, peri, reset, value;
+	int ret;
+
+	ret = micronux_cold_i2c_calculate_timing(&timing);
+	if (ret)
+		return ret;
+
+	value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2);
+	writel(value | HP_CLKRST_I2C0_APB_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2);
+	dsi->cold_i2c_active = true;
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN1);
+	writel(reset | HP_CLKRST_I2C0_RESET,
+	       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN1);
+	writel(reset & ~HP_CLKRST_I2C0_RESET,
+	       dsi->hp_clkrst + HP_CLKRST_HP_RST_EN1);
+	peri = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+	writel(peri | HP_CLKRST_I2C0_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+
+	micronux_cold_i2c_pin(dsi, MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO,
+			      GPIO_I2C0_SDA_SIGNAL);
+	micronux_cold_i2c_pin(dsi, MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO,
+			      GPIO_I2C0_SCL_SIGNAL);
+
+	ctr = readl(dsi->i2c + I2C_CTR);
+	ctr &= ~(BIT(0) | BIT(1) | BIT(3) | BIT(6) | BIT(7) | BIT(9));
+	ctr |= I2C_MS_MODE;
+	writel(ctr, dsi->i2c + I2C_CTR);
+	fifo = readl(dsi->i2c + I2C_FIFO_CONF) & ~I2C_NONFIFO_ENABLE;
+	writel(fifo | I2C_RX_FIFO_RST | I2C_TX_FIFO_RST,
+	       dsi->i2c + I2C_FIFO_CONF);
+	writel(fifo & ~(I2C_RX_FIFO_RST | I2C_TX_FIFO_RST),
+	       dsi->i2c + I2C_FIFO_CONF);
+	writel(ctr | I2C_CONF_UPGATE, dsi->i2c + I2C_CTR);
+
+	peri = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+	peri &= ~(HP_CLKRST_I2C0_CLK_SRC_RC_FAST |
+		  HP_CLKRST_I2C0_CLK_DIV_NUM |
+		  HP_CLKRST_I2C0_CLK_DIV_NUMERATOR |
+		  HP_CLKRST_I2C0_CLK_DIV_DENOMINATOR);
+	peri |= HP_CLKRST_I2C0_CLK_EN |
+		FIELD_PREP(HP_CLKRST_I2C0_CLK_DIV_NUM,
+			   timing.clkm_div - 1);
+	writel(peri, dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+
+	writel(timing.scl_low - 1, dsi->i2c + I2C_SCL_LOW_PERIOD);
+	writel(timing.scl_high |
+	       FIELD_PREP(I2C_SCL_WAIT_HIGH, timing.scl_wait_high),
+	       dsi->i2c + I2C_SCL_HIGH_PERIOD);
+	writel(timing.sda_hold - 1, dsi->i2c + I2C_SDA_HOLD);
+	writel(timing.sda_sample - 1, dsi->i2c + I2C_SDA_SAMPLE);
+	writel(timing.setup - 1, dsi->i2c + I2C_SCL_RSTART_SETUP);
+	writel(timing.setup - 1, dsi->i2c + I2C_SCL_STOP_SETUP);
+	writel(timing.hold - 1, dsi->i2c + I2C_SCL_START_HOLD);
+	writel(timing.hold - 1, dsi->i2c + I2C_SCL_STOP_HOLD);
+	/* ESP-IDF writes the bus timeout, then the device's 2000-us timeout. */
+	writel(FIELD_PREP(I2C_TIMEOUT_VALUE, timing.bus_timeout) |
+	       I2C_TIMEOUT_ENABLE, dsi->i2c + I2C_TO);
+	writel(FIELD_PREP(I2C_FILTER_SCL_THRESHOLD,
+			  MICRONUX_DISPLAY_COLD_I2C_FILTER) |
+	       FIELD_PREP(I2C_FILTER_SDA_THRESHOLD,
+			  MICRONUX_DISPLAY_COLD_I2C_FILTER) |
+	       I2C_FILTER_SCL_ENABLE | I2C_FILTER_SDA_ENABLE,
+	       dsi->i2c + I2C_FILTER_CFG);
+	writel(FIELD_PREP(I2C_TIMEOUT_VALUE, timing.device_timeout) |
+	       I2C_TIMEOUT_ENABLE, dsi->i2c + I2C_TO);
+	writel(0, dsi->i2c + I2C_INT_ENA);
+	writel(~0U, dsi->i2c + I2C_INT_CLR);
+	writel(readl(dsi->i2c + I2C_CTR) | I2C_CONF_UPGATE,
+	       dsi->i2c + I2C_CTR);
+
+	if (!micronux_i2c_matches(dsi, &timing))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=i2c0 state=READY idf=v6.0.1 source=xtal-40000000 bus-hz=100000 sda=7 scl=8 filter=7 timeout-us=2000 irq=unused\n");
+	return 0;
+}
+
+static bool micronux_cold_i2c_gate(struct micronux_dsi *dsi)
+{
+	bool gated;
+	u32 value;
+
+	value = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+	writel(value & ~HP_CLKRST_I2C0_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10);
+	value = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2);
+	writel(value & ~HP_CLKRST_I2C0_APB_CLK_EN,
+	       dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2);
+	gated = !(readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL10) &
+		  HP_CLKRST_I2C0_CLK_EN) &&
+		!(readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2) &
+		  HP_CLKRST_I2C0_APB_CLK_EN);
+	if (!gated)
+		return false;
+	if (dsi->cold_i2c_active)
+		micronux_cold_i2c_release_pins(dsi);
+	dsi->cold_i2c_active = false;
+	return true;
+}
+
+static void micronux_cold_ldo_calculate(struct micronux_dsi *dsi,
+					struct micronux_ldo_calibration *cal)
+{
+	u32 efuse, sys2;
+	u8 efuse_c = 0, efuse_k = 0, efuse_vos = 0;
+	u8 dref, mul;
+	int min_diff = 400000000;
+
+	sys2 = readl(dsi->efuse + EFUSE_RD_MAC_SYS_2);
+	cal->block_version =
+		FIELD_GET(EFUSE_BLOCK_VERSION_MAJOR, sys2) * 100 +
+		FIELD_GET(EFUSE_BLOCK_VERSION_MINOR, sys2);
+	cal->k_1000 = 1000;
+	cal->vos_1000 = 0;
+	cal->c_1000 = 1000;
+	if (cal->block_version >= 1) {
+		efuse = readl(dsi->efuse + EFUSE_RD_MAC_SYS_3);
+		efuse_k = FIELD_GET(EFUSE_LDO_VO3_K, efuse);
+		efuse_vos = FIELD_GET(EFUSE_LDO_VO3_VOS, efuse);
+		efuse_c = FIELD_GET(EFUSE_LDO_VO3_C, efuse);
+		if (efuse_k)
+			cal->k_1000 = efuse_k & 0x80 ?
+				-1 * (efuse_k & 0x7f) + 975 :
+				efuse_k + 975;
+		if (efuse_vos)
+			cal->vos_1000 = efuse_vos & 0x20 ?
+				-1 * (efuse_vos & 0x1f) - 3 :
+				efuse_vos - 3;
+		if (efuse_c)
+			cal->c_1000 = efuse_c & 0x20 ?
+				-1 * (efuse_c & 0x1f) + 990 :
+				efuse_c + 990;
+	}
+
+	cal->dref = 0;
+	cal->mul = 0;
+	for (dref = 0; dref < 16; dref++) {
+		int vref_20 = dref < 9 ? 10 + dref : 20 + (dref - 9) * 2;
+
+		for (mul = 0; mul < 8; mul++) {
+			int diff, vout_80000000;
+
+			vout_80000000 =
+				(vref_20 * cal->k_1000 + 20 * cal->vos_1000) *
+				(4000 + mul * cal->c_1000);
+			diff = MICRONUX_DISPLAY_COLD_LDO_MV * 80000 -
+				vout_80000000;
+			if (diff < 0)
+				diff = -diff;
+			if (diff < min_diff) {
+				min_diff = diff;
+				cal->dref = dref;
+				cal->mul = mul;
+			}
+		}
+	}
+}
+
+static bool micronux_cold_ldo_disable(struct micronux_dsi *dsi)
+{
+	u32 value;
+
+	value = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	writel(value & ~PMU_EXT_LDO_XPD,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	dsi->cold_ldo_enabled = false;
+	return !(readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A) & PMU_EXT_LDO_XPD);
+}
+
+static int micronux_cold_ldo_enable(struct micronux_dsi *dsi,
+				    struct micronux_ldo_calibration *cal)
+{
+	u32 ana, control;
+
+	if (MICRONUX_DISPLAY_COLD_LDO_CHANNEL != 3 ||
+	    MICRONUX_DISPLAY_COLD_LDO_UNIT != 2)
+		return -EINVAL;
+	micronux_cold_ldo_calculate(dsi, cal);
+
+	/*
+	 * ESP-IDF v6.0.1 maps channel VO3 (unit 2) to ext_ldo[1]. Apply
+	 * ldo_ll_adjust_voltage(), ldo_ll_set_owner(), ripple suppression,
+	 * then ldo_ll_enable() in the same order as esp_ldo_acquire_channel().
+	 */
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	writel(control & ~PMU_EXT_LDO_TIEH,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	ana = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	ana &= ~PMU_EXT_LDO_DREF;
+	ana |= FIELD_PREP(PMU_EXT_LDO_DREF, cal->dref);
+	writel(ana, dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	ana = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	ana &= ~PMU_EXT_LDO_MUL;
+	ana |= FIELD_PREP(PMU_EXT_LDO_MUL, cal->mul);
+	writel(ana, dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	writel(control | PMU_EXT_LDO_FORCE_TIEH_SEL,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	writel(control & ~PMU_EXT_LDO_TIEH_SEL,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	ana = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	writel(ana | PMU_EXT_LDO_EN_VDET,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	writel(control | PMU_EXT_LDO_XPD,
+	       dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	dsi->cold_ldo_enabled = true;
+
+	control = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A);
+	ana = readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A_ANA);
+	if ((control & (PMU_EXT_LDO_FORCE_TIEH_SEL | PMU_EXT_LDO_XPD |
+			PMU_EXT_LDO_TIEH_SEL | PMU_EXT_LDO_TIEH)) !=
+	    (PMU_EXT_LDO_FORCE_TIEH_SEL | PMU_EXT_LDO_XPD) ||
+	    (ana & (PMU_EXT_LDO_DREF | PMU_EXT_LDO_MUL |
+		    PMU_EXT_LDO_EN_VDET)) !=
+	    (FIELD_PREP(PMU_EXT_LDO_DREF, cal->dref) |
+	     FIELD_PREP(PMU_EXT_LDO_MUL, cal->mul) |
+	     PMU_EXT_LDO_EN_VDET))
+		return -EIO;
+	return 0;
+}
+
+static bool micronux_cold_display_blocks_quiescent(struct micronux_dsi *dsi)
+{
+	u32 clocks0, clocks1, peri03, reset;
+
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	clocks0 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+	clocks1 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	return (reset & (HP_CLKRST_GDMA_RESET |
+			 HP_CLKRST_DSI_BRIDGE_RESET)) ==
+		       (HP_CLKRST_GDMA_RESET | HP_CLKRST_DSI_BRIDGE_RESET) &&
+	       !(clocks0 & HP_CLKRST_GDMA_CPU_CLK_EN) &&
+	       !(clocks1 & (HP_CLKRST_GDMA_SYS_CLK_EN |
+			     HP_CLKRST_DSI_SYS_CLK_EN)) &&
+	       !(peri03 & (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+			    HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+			    HP_CLKRST_DSI_DPI_CLK_EN));
+}
+
+static int micronux_cold_reissue_quiescent_commands(struct micronux_dsi *dsi)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	int ret;
+
+	ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+				      handoff->backlight_register, 0);
+	if (ret)
+		return ret;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=pwm-zero state=ACKED value=0\n");
+	ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+				      handoff->display_control_register,
+				      handoff->display_control_reset_prepare_command);
+	if (ret)
+		return ret;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=reset-prepare state=ACKED command=0x13\n");
+	msleep(handoff->pwm_zero_settle_ms);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=pwm-zero-settle state=ELAPSED duration-ms=100\n");
+	ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+				      handoff->display_control_register,
+				      handoff->display_control_reset_assert_command);
+	if (ret)
+		return ret;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=reset-assert state=ACKED command=0x11 physical-state=unobserved\n");
+	msleep(handoff->reset_hold_ms);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT stage=reset-hold state=ELAPSED duration-ms=10\n");
+	return 0;
+}
