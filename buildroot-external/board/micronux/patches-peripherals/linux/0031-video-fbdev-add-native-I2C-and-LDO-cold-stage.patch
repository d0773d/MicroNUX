+static void micronux_cold_fail_quiescent(struct micronux_dsi *dsi,
+					 const char *stage, int error)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	bool display_blocks, i2c_gated, ldo_off;
+	int pwm_ret = -ENODEV, reset_ret = -ENODEV;
+	u8 address = handoff->i2c_address;
+	u8 control = handoff->display_control_register;
+	u8 pwm = handoff->backlight_register;
+	u8 reset = handoff->display_control_reset_assert_command;
+
+	if (dsi->cold_i2c_active) {
+		pwm_ret = micronux_i2c_write_reg8(dsi, address, pwm, 0);
+		reset_ret = micronux_i2c_write_reg8(dsi, address, control, reset);
+		if (!reset_ret)
+			msleep(handoff->reset_hold_ms);
+	}
+	ldo_off = micronux_cold_ldo_disable(dsi);
+	i2c_gated = micronux_cold_i2c_gate(dsi);
+	display_blocks = micronux_cold_display_blocks_quiescent(dsi);
+	dsi->display_state = MICRONUX_DISPLAY_STATE_FAILED_QUIESCENT;
+	dev_err(dsi->dev,
+		"MICRONUX:M9.2:COLD-INIT state=FAILED_QUIESCENT stage=%s error=%d pwm-zero-command=%s reset-assert-command=%s ldo3-xpd=%s i2c0=%s dsi-gdma=%s retry=reboot-only optical-state=unobserved fb=unregistered irq=unregistered\n",
+		stage, error, pwm_ret ? "failed" : "acked",
+		reset_ret ? "failed" : "acked", ldo_off ? "clear" : "error",
+		i2c_gated ? "gated" : "gate-error",
+		display_blocks ? "reset-off" : "state-error");
+}
+
+static int micronux_cold_initialize_ldo_stage(struct micronux_dsi *dsi)
+{
+	struct micronux_ldo_calibration cal = { };
+	int ret;
+
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT state=START trigger=sysfs stage=i2c0-ldo3 writes=authorized-once\n");
+	ret = micronux_cold_i2c_initialize(dsi);
+	if (ret) {
+		micronux_cold_fail_quiescent(dsi, "i2c0", ret);
+		return ret;
+	}
+	ret = micronux_cold_reissue_quiescent_commands(dsi);
+	if (ret) {
+		micronux_cold_fail_quiescent(dsi, "safe-commands", ret);
+		return ret;
+	}
+	ret = micronux_cold_ldo_enable(dsi, &cal);
+	if (ret) {
+		micronux_cold_fail_quiescent(dsi, "ldo3", ret);
+		return ret;
+	}
+	if (!micronux_cold_display_blocks_quiescent(dsi)) {
+		ret = -EIO;
+		micronux_cold_fail_quiescent(dsi, "display-block-state", ret);
+		return ret;
+	}
+	if (!micronux_cold_i2c_gate(dsi)) {
+		ret = -EIO;
+		micronux_cold_fail_quiescent(dsi, "i2c0-release", ret);
+		return ret;
+	}
+	dsi->display_state = MICRONUX_DISPLAY_STATE_LDO_READY;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:COLD-INIT state=LDO_READY ldo-channel=3 ldo-unit=2 voltage-mv=2500 efuse-block=%u k1000=%d vos1000=%d c1000=%d dref=%u mul=%u i2c0=released-gated pwm-zero-command=acked reset-prepare-command=acked reset-assert-command=acked physical-panel-state=unobserved dsi-module-reset=asserted dphy-clocks=off gdma-reset=asserted clocks=off fb=unregistered irq=unregistered next=native-dsi\n",
+		 cal.block_version, cal.k_1000, cal.vos_1000, cal.c_1000,
+		 cal.dref, cal.mul);
+	return 0;
+}
