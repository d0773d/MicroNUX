From f90b556392933844432e972f8f0126ce86f733ae Mon Sep 17 00:00:00 2001
From: MicroNUX contributors <micronux@users.noreply.github.com>
Date: Sat, 8 Aug 2026 16:20:00 -0700
Subject: [PATCH 10/22] mmc: dw: poll ESP32-P4 SDIO interrupts

The ESP32-P4 physical MMC interrupt is deliberately parked while the NOMMU
CLIC port is stabilized.  Command and data requests are already serviced by
synchronous polling, but SDIO function interrupts arrive while no request is
active and therefore never reached the MMC core.

Poll the DesignWare masked interrupt status once per tick for the ESP32-P4
quirk.  The normal DesignWare handler still acknowledges the slot interrupt,
masks it, and hands it to sdio_irq_work; the MMC core re-enables it after the
function handler completes.  This preserves the standard SDIO IRQ contract
without allowing the unreliable physical CLIC route into Linux.

Signed-off-by: MicroNUX contributors <micronux@users.noreply.github.com>
---
 drivers/mmc/host/dw_mmc.c | 17 +++++++++++++++++
 drivers/mmc/host/dw_mmc.h |  1 +
 2 files changed, 18 insertions(+)

diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
index e2e62abe27d3..186e67a948cd 100644
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -69,6 +69,15 @@
 
 static irqreturn_t dw_mci_interrupt(int irq, void *dev_id);
 
+static void dw_mci_esp32p4_poll_timer(struct timer_list *timer)
+{
+	struct dw_mci *host = from_timer(host, timer,
+					     esp32p4_poll_timer);
+
+	dw_mci_interrupt(host->irq, host);
+	mod_timer(&host->esp32p4_poll_timer, jiffies + 1);
+}
+
 struct idmac_desc_64addr {
 	u32		des0;	/* Control Descriptor */
 #define IDMAC_OWN_CLR64(x) \
@@ -3719,6 +3728,11 @@ int dw_mci_probe(struct dw_mci *host)
 	/* Now that slots are all setup, we can enable card detect */
 	dw_mci_enable_cd(host);
 
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+		timer_setup(&host->esp32p4_poll_timer,
+			    dw_mci_esp32p4_poll_timer, 0);
+		mod_timer(&host->esp32p4_poll_timer, jiffies + 1);
+	}
 	return 0;
 
 err_dmaunmap:
@@ -3741,6 +3755,9 @@ EXPORT_SYMBOL(dw_mci_probe);
 
 void dw_mci_remove(struct dw_mci *host)
 {
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC)
+		del_timer_sync(&host->esp32p4_poll_timer);
+
 	dev_dbg(host->dev, "remove slot\n");
 	if (host->slot)
 		dw_mci_cleanup_slot(host->slot);
diff --git a/drivers/mmc/host/dw_mmc.h b/drivers/mmc/host/dw_mmc.h
index 10896d4bbac8..9e453ad33e16 100644
--- a/drivers/mmc/host/dw_mmc.h
+++ b/drivers/mmc/host/dw_mmc.h
@@ -237,6 +237,7 @@ struct dw_mci {
 	struct timer_list       cmd11_timer;
 	struct timer_list       cto_timer;
 	struct timer_list       dto_timer;
+	struct timer_list       esp32p4_poll_timer;
 
 #ifdef CONFIG_FAULT_INJECTION
 	struct fault_attr	fail_data_crc;
-- 
