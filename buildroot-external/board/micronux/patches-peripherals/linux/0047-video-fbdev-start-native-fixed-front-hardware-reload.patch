+	writel(~0U, dsi->channel + DW_GDMA_CH_INT_CLEAR1);
+	writel(DW_GDMA_INT_COMMON_VALID_MASK,
+	       dsi->gdma + DW_GDMA_INT_CLEAR);
+
+	front_address = dsi->handoff.framebuffer_address[front];
+	writel(front_address, dsi->channel + DW_GDMA_CH_SAR);
+	writel(dsi->handoff.dsi_fifo_address,
+	       dsi->channel + DW_GDMA_CH_DAR);
+	writel(MICRONUX_DMA_BLOCK_TRANSFER_SIZE,
+	       dsi->channel + DW_GDMA_CH_BLOCK_TS);
+	writel(MICRONUX_DMA_DESCRIPTOR_CTRL_LO,
+	       dsi->channel + DW_GDMA_CH_CTL_LO);
+	writel(MICRONUX_NATIVE_DMA_RELOAD_CTRL_HI,
+	       dsi->channel + DW_GDMA_CH_CTL_HI);
+	writel(MICRONUX_DMA_CHANNEL_RELOAD_CFG_LO,
+	       dsi->channel + DW_GDMA_CH_CFG_LO);
+	writel(MICRONUX_DMA_CHANNEL_CFG_HI,
+	       dsi->channel + DW_GDMA_CH_CFG_HI);
