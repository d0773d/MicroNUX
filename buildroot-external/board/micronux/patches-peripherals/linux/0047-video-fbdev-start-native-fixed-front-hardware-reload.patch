+static int micronux_native_start_continuous_fixed_front(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+	u64 deadline;
+	u32 abort_mask, channel, chen, common, ctrl_hi, front_address;
+	u32 previous_sar, sar, sig_ena0, state, status0, status1, st_ena0;
+	u32 top, wraps = 0;
+	u8 front;
