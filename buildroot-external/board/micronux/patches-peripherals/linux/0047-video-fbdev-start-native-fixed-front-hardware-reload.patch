+	channel = BIT(dsi->handoff.dma_channel);
+	abort_mask = channel | (channel << 8);
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	if (dsi->queued_index >= 0 ||
+	    dsi->front_index != dsi->presented_index ||
+	    dsi->front_commit_sequence != dsi->presented_commit_sequence) {
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+		return -ESTALE;
+	}
+	front = dsi->front_index;
+	dsi->scanout_active = false;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+
+	/* Drain a completion that observed the old one-shot mode, then stop it. */
+	synchronize_irq(dsi->irq);
+	writel(channel << 8, dsi->gdma + DW_GDMA_CHEN);
+	if (readl_poll_timeout_atomic(dsi->gdma + DW_GDMA_CHEN, state,
+				      !(state & channel), 1, 1000)) {
+		writel(abort_mask, dsi->gdma + DW_GDMA_CHABORT);
+		if (readl_poll_timeout_atomic(dsi->gdma + DW_GDMA_CHABORT,
+					      state, !(state & abort_mask),
+					      1, 1000) ||
+		    (readl(dsi->gdma + DW_GDMA_CHEN) & channel))
+			return -ETIMEDOUT;
+	}
+	/* Drain a completion raised between the first drain and confirmed stop. */
+	synchronize_irq(dsi->irq);
