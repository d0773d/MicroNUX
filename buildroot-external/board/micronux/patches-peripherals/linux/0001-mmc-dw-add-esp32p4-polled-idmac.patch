From 8a5f3d53cc030834927c4633331a87963f54aa65 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sat, 8 Aug 2026 03:15:00 -0700
Subject: [PATCH 01/46] mmc: dw: add ESP32-P4 polled IDMAC mode

ESP32-P4 integrates a Synopsys DesignWare Mobile Storage Host Controller,
but the initial MicroNUX NOMMU port keeps normal block-layer buffers in
cached external PSRAM and does not yet have architecture-wide non-coherent
DMA operations.

Keep the coherency contract local to this controller.  Use an 8 KiB internal
SRAM region reserved by the loader: one page for IDMAC descriptors and one
page as a data bounce buffer.  The controller uses the cacheable/bus alias
while Linux accesses the same SRAM through its uncached alias.  Bound each
request to 4 KiB and copy at the DMA ownership boundaries.

The ESP32-P4 revision 1.3 hardware gate also showed that later command and
data events in one request are not delivered reliably through the current
CLIC port.  Disable the external line and synchronously drain the controller
status for each active command and data transfer.  This deliberately trades
throughput and CPU time for a deterministic, kernel-contained storage path.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 drivers/mmc/host/dw_mmc-pltfm.c | 11 +++++
 drivers/mmc/host/dw_mmc.c       | 99 ++++++++++++++++++++++++++++++++---------
 drivers/mmc/host/dw_mmc.h       |  2 +
 3 files changed, 91 insertions(+), 21 deletions(-)

diff --git a/drivers/mmc/host/dw_mmc-pltfm.c b/drivers/mmc/host/dw_mmc-pltfm.c
--- a/drivers/mmc/host/dw_mmc-pltfm.c
+++ b/drivers/mmc/host/dw_mmc-pltfm.c
@@ -100,8 +100,19 @@ static const struct dw_mci_drv_data socfpga_drv_data = {
 	.init		= dw_mci_socfpga_priv_init,
 };
 
+static int dw_mci_esp32p4_parse_dt(struct dw_mci *host)
+{
+	host->quirks |= DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC;
+	return 0;
+}
+
+static const struct dw_mci_drv_data esp32p4_drv_data = {
+	.parse_dt	= dw_mci_esp32p4_parse_dt,
+};
+
 static const struct of_device_id dw_mci_pltfm_match[] = {
 	{ .compatible = "snps,dw-mshc", },
+	{ .compatible = "espressif,esp32p4-dw-mshc", .data = &esp32p4_drv_data, },
 	{ .compatible = "altr,socfpga-dw-mshc", .data = &socfpga_drv_data, },
 	{ .compatible = "img,pistachio-dw-mshc", },
 	{},
diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -61,6 +61,14 @@
 
 #define DESC_RING_BUF_SZ	PAGE_SIZE
 
+#define ESP32P4_IDMAC_DESC_DMA_ADDR	0x4ff80000UL
+#define ESP32P4_IDMAC_DESC_CPU_ADDR	0x8ff80000UL
+#define ESP32P4_IDMAC_DATA_DMA_ADDR	0x4ff81000UL
+#define ESP32P4_IDMAC_DATA_CPU_ADDR	0x8ff81000UL
+#define ESP32P4_IDMAC_BOUNCE_SIZE	PAGE_SIZE
+
+static irqreturn_t dw_mci_interrupt(int irq, void *dev_id);
+
 struct idmac_desc_64addr {
 	u32		des0;	/* Control Descriptor */
 #define IDMAC_OWN_CLR64(x) \
@@ -411,6 +419,21 @@ static void dw_mci_start_command(struct dw_mci *host,
 	/* response expected command only */
 	if (cmd_flags & SDMMC_CMD_RESP_EXP)
 		dw_mci_set_cto(host);
+
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+		unsigned int attempts;
+
+		for (attempts = 0; attempts < 1000; attempts++) {
+			dw_mci_interrupt(host->irq, host);
+			if (test_bit(EVENT_CMD_COMPLETE,
+				     &host->pending_events))
+				break;
+			udelay(100);
+		}
+		if (attempts == 1000)
+			dev_warn_ratelimited(host->dev,
+				"ESP32-P4 command poll exceeded 100 ms\n");
+	}
 }
 
 static inline void send_stop_abort(struct dw_mci *host, struct mmc_data *data)
@@ -420,6 +443,42 @@ static inline void send_stop_abort(struct dw_mci *host, struct mmc_data *data)
 	dw_mci_start_command(host, stop, host->stop_cmdr);
 }
 
+static int dw_mci_esp32p4_prepare_bounce(struct dw_mci *host)
+{
+	struct mmc_data *data = host->data;
+	size_t length;
+
+	if (!(host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC))
+		return 0;
+	if (!data || data->sg_len != 1 || host->dma_64bit_address)
+		return -EINVAL;
+
+	length = (size_t)data->blocks * data->blksz;
+	if (!length || length > ESP32P4_IDMAC_BOUNCE_SIZE ||
+	    length > data->sg->length)
+		return -EINVAL;
+
+	if (data->flags & MMC_DATA_WRITE)
+		memcpy((void *)ESP32P4_IDMAC_DATA_CPU_ADDR,
+		       sg_virt(data->sg), length);
+
+	return 0;
+}
+
+static void dw_mci_esp32p4_complete_bounce(struct dw_mci *host,
+					   struct mmc_data *data)
+{
+	size_t length;
+
+	if (!(host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) || !data ||
+	    !(data->flags & MMC_DATA_READ))
+		return;
+
+	length = (size_t)data->blocks * data->blksz;
+	rmb();
+	memcpy(sg_virt(data->sg), (void *)ESP32P4_IDMAC_DATA_CPU_ADDR, length);
+}
+
 /* DMA interface functions */
 static void dw_mci_stop_dma(struct dw_mci *host)
 {
@@ -477,6 +536,8 @@ static void dw_mci_dmac_complete_dma(void *arg)
 
 	dev_vdbg(host->dev, "DMA complete\n");
 
+	dw_mci_esp32p4_complete_bounce(host, data);
+
 	if ((host->use_dma == TRANS_MODE_EDMAC) &&
 	    data && (data->flags & MMC_DATA_READ))
 		/* Invalidate cache after read */
@@ -725,6 +786,10 @@ static int dw_mci_idmac_start_dma(struct dw_mci *host, unsigned int sg_len)
 	u32 temp;
 	int ret;
 
+	ret = dw_mci_esp32p4_prepare_bounce(host);
+	if (ret)
+		goto out;
+
 	if (host->dma_64bit_address == 1)
 		ret = dw_mci_prepare_desc64(host, host->data, sg_len);
 	else
@@ -733,6 +798,10 @@ static int dw_mci_idmac_start_dma(struct dw_mci *host, unsigned int sg_len)
 	if (ret)
 		goto out;
 
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC)
+		((struct idmac_desc *)host->sg_cpu)->des2 =
+			cpu_to_le32(ESP32P4_IDMAC_DATA_DMA_ADDR);
+
 	/* drain writebuffer */
 	wmb();
 
@@ -1350,6 +1419,24 @@ static void __dw_mci_start_request(struct dw_mci *host,
 	}
 
 	dw_mci_start_command(host, cmd, cmdflags);
+	if (data && (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC)) {
+		unsigned int attempts;
+
+		for (attempts = 0; attempts < 1000; attempts++) {
+			dw_mci_interrupt(host->irq, host);
+			if (test_bit(EVENT_DATA_COMPLETE,
+				     &host->pending_events) &&
+			    (test_bit(EVENT_XFER_COMPLETE,
+				      &host->pending_events) ||
+			     test_bit(EVENT_DATA_ERROR,
+				      &host->pending_events)))
+				break;
+			udelay(100);
+		}
+		if (attempts == 1000)
+			dev_warn_ratelimited(host->dev,
+				"ESP32-P4 data poll exceeded 100 ms\n");
+	}
 
 	if (cmd->opcode == SD_SWITCH_VOLTAGE) {
 		unsigned long irqflags;
@@ -3061,6 +3148,15 @@ static int dw_mci_init_slot(struct dw_mci *host)
 				    mmc->max_blk_count;
 		mmc->max_seg_size = mmc->max_req_size;
 	}
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+		mmc->max_segs = 1;
+		mmc->max_blk_size = PAGE_SIZE;
+		mmc->max_blk_count = PAGE_SIZE / 512;
+		mmc->max_req_size = PAGE_SIZE;
+		mmc->max_seg_size = PAGE_SIZE;
+		dev_info(host->dev,
+			 "ESP32-P4 IDMAC internal-SRAM bounce: 4 KiB requests\n");
+	}
 
 	dw_mci_get_cd(mmc);
 
@@ -3137,9 +3233,16 @@ static void dw_mci_init_dma(struct dw_mci *host)
 		}
 
 		/* Alloc memory for sg translation */
-		host->sg_cpu = dmam_alloc_coherent(host->dev,
-						   DESC_RING_BUF_SZ,
-						   &host->sg_dma, GFP_KERNEL);
+		if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+			host->sg_cpu = (void *)ESP32P4_IDMAC_DESC_CPU_ADDR;
+			host->sg_dma = ESP32P4_IDMAC_DESC_DMA_ADDR;
+			memset(host->sg_cpu, 0, DESC_RING_BUF_SZ);
+		} else {
+			host->sg_cpu = dmam_alloc_coherent(host->dev,
+							   DESC_RING_BUF_SZ,
+							   &host->sg_dma,
+							   GFP_KERNEL);
+		}
 		if (!host->sg_cpu) {
 			dev_err(host->dev,
 				"%s: could not alloc DMA memory\n",
@@ -3544,6 +3647,8 @@ int dw_mci_probe(struct dw_mci *host)
 			       host->irq_flags, "dw-mci", host);
 	if (ret)
 		goto err_dmaunmap;
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC)
+		disable_irq(host->irq);
 
 	/*
 	 * Enable interrupts for command done, data over, data empty,
@@ -3554,6 +3659,10 @@ int dw_mci_probe(struct dw_mci *host)
 		   DW_MCI_ERROR_FLAGS);
 	/* Enable mci interrupt */
 	mci_writel(host, CTRL, SDMMC_CTRL_INT_ENABLE);
+	if (host->quirks & DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC) {
+		dev_info(host->dev,
+			 "ESP32-P4 synchronous-polled I/O enabled\n");
+	}
 
 	dev_info(host->dev,
 		 "DW MMC controller at irq %d,%d bit host data width,%u deep fifo\n",
diff --git a/drivers/mmc/host/dw_mmc.h b/drivers/mmc/host/dw_mmc.h
--- a/drivers/mmc/host/dw_mmc.h
+++ b/drivers/mmc/host/dw_mmc.h
@@ -283,6 +283,8 @@ struct dw_mci_board {
 #define DW_MMC_QUIRK_EXTENDED_TMOUT            BIT(0)
 /* Force 32-bit access to the FIFO */
 #define DW_MMC_QUIRK_FIFO64_32                 BIT(1)
+/* Use the ESP32-P4 reserved SRAM bounce buffers and poll controller events */
+#define DW_MMC_QUIRK_ESP32P4_POLLED_IDMAC      BIT(2)
 
 #define DW_MMC_240A		0x240a
 #define DW_MMC_280A		0x280a
-- 
2.43.0
