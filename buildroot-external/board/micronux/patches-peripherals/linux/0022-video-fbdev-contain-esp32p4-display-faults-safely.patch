 {
+	bool host_status_seen, transition_status_seen;
 	u32 bridge_status, frame, initial_frame;
 	int ret;
 
-	initial_frame = READ_ONCE(dsi->scanout_frames);
+	if (READ_ONCE(dsi->applied_brightness))
+		return -EBUSY;
 	micronux_select_framebuffer(dsi);
+	/* Complete the source writes before starting the framebuffer gate. */
+	readl(dsi->bridge + DSI_BRG_DPI_MISC_CONFIG);
+	if (!micronux_source_policy_valid(dsi, false)) {
+		(void)micronux_sample_host_status(dsi, 0);
+		return -EIO;
+	}
+	/* Clear immediate DPI-input residue from the intentional dark switch. */
+	transition_status_seen = micronux_sample_host_status(dsi, DSI_HOST_INT_STATUS1_DPI_PATH);
+	writel(DSI_BRG_INT_UNDERRUN, dsi->bridge + DSI_BRG_INT_CLR);
