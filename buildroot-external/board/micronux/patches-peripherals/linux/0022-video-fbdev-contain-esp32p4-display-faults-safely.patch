+static void micronux_latch_fault(struct micronux_dsi *dsi, int fault)
+{
+	if (!test_and_set_bit(fault, &dsi->fault_bits))
+		schedule_work(&dsi->fault_work);
+}
+
+/* INT_ST0/1 are read-to-clear; serialize every runtime read. */
+static void micronux_discard_host_status(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dsi->host_status_lock, flags);
+	readl(dsi->host + DSI_HOST_INT_STATUS0);
+	readl(dsi->host + DSI_HOST_INT_STATUS1);
+	spin_unlock_irqrestore(&dsi->host_status_lock, flags);
+}
+
+static bool micronux_sample_host_status(struct micronux_dsi *dsi)
+{
+	unsigned long flags;
+	u32 status0, status1;
+
+	spin_lock_irqsave(&dsi->host_status_lock, flags);
+	status0 = readl(dsi->host + DSI_HOST_INT_STATUS0) &
+		  DSI_HOST_INT_STATUS0_VALID;
+	status1 = readl(dsi->host + DSI_HOST_INT_STATUS1) &
+		  DSI_HOST_INT_STATUS1_VALID;
+
+	if (status0)
+		WRITE_ONCE(dsi->host_error0,
+			   READ_ONCE(dsi->host_error0) | status0);
+	if (status1)
+		WRITE_ONCE(dsi->host_error1,
+			   READ_ONCE(dsi->host_error1) | status1);
+	spin_unlock_irqrestore(&dsi->host_status_lock, flags);
+	if (status1 & DSI_HOST_INT_STATUS1_FATAL)
+		micronux_latch_fault(dsi, MICRONUX_FAULT_DSI_HOST);
+	return status0 || status1;
+}
+
+static bool micronux_host_status_clean(struct micronux_dsi *dsi)
+{
+	return !READ_ONCE(dsi->host_error0) &&
+	       !READ_ONCE(dsi->host_error1);
+}
+
+static bool micronux_source_policy_valid(struct micronux_dsi *dsi,
+					 bool vpg);
+
+static bool micronux_visible_source_valid(struct micronux_dsi *dsi)
+{
+	unsigned long last_frame;
+	bool vpg;
+
+	if (!READ_ONCE(dsi->scanout_ready))
+		return false;
+	vpg = READ_ONCE(dsi->vpg_test_active);
+	if (!vpg)
+		(void)micronux_sample_host_status(dsi);
+	if (!READ_ONCE(dsi->boot_display_ready) ||
+	    !READ_ONCE(dsi->scanout_active) ||
+	    READ_ONCE(dsi->fault_bits) ||
+	    READ_ONCE(dsi->last_dma_error) ||
+	    (readl(dsi->bridge + DSI_BRG_INT_RAW) & DSI_BRG_INT_UNDERRUN))
+		return false;
+
+	if (!micronux_source_policy_valid(dsi, vpg))
+		return false;
+	if (vpg)
+		return true;
+
+	last_frame = READ_ONCE(dsi->last_frame_jiffies);
+	return last_frame &&
+	       !time_after(jiffies,
+			   last_frame +
+			   msecs_to_jiffies(MICRONUX_FRAME_REVEAL_RECENT_MS));
+}
