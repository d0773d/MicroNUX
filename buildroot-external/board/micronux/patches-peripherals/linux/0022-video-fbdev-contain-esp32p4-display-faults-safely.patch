 					       scanout_timer);
-	u32 bridge_status;
+	u32 bridge_status, frames, sar;
+	bool monitor;
 
 	bridge_status = readl(dsi->bridge + DSI_BRG_INT_RAW);
 	if (bridge_status & DSI_BRG_INT_UNDERRUN) {
@@ -705,8 +891,24 @@ static enum hrtimer_restart micronux_dma_poll(struct hrtimer *timer)
 		       dsi->bridge + DSI_BRG_INT_CLR);
 		WRITE_ONCE(dsi->bridge_underruns,
 			   READ_ONCE(dsi->bridge_underruns) + 1);
+		micronux_latch_fault(dsi, MICRONUX_FAULT_UNDERRUN);
