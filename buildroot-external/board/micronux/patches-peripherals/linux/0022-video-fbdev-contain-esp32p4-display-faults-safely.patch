-	hrtimer_forward_now(timer, ns_to_ktime(MICRONUX_DMA_POLL_NS));
+	(void)micronux_sample_host_status(dsi, 0);
+	frames = READ_ONCE(dsi->scanout_frames);
+	sar = readl(dsi->channel + DW_GDMA_CH_SAR);
+	monitor = READ_ONCE(dsi->scanout_ready) &&
+		  READ_ONCE(dsi->boot_display_ready) &&
+		  READ_ONCE(dsi->scanout_active) &&
+		  !READ_ONCE(dsi->vpg_test_active) &&
+		  !READ_ONCE(dsi->fault_bits);
+	if (!monitor || frames != dsi->watchdog_frames ||
+	    sar != dsi->watchdog_sar) {
+		micronux_watchdog_seed_progress(dsi);
+	} else if (++dsi->watchdog_stale_polls >=
+		   MICRONUX_STALE_POLL_LIMIT) {
+		micronux_latch_fault(dsi, MICRONUX_FAULT_STALE_FRAME);
+	}
+	hrtimer_forward_now(timer, ms_to_ktime(MICRONUX_HEALTH_POLL_MS));
 	return HRTIMER_RESTART;
 }
 
