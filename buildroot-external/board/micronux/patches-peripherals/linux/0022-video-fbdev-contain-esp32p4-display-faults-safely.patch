+static u32 micronux_read_soc_register(phys_addr_t address)
+{
+	void __iomem *register_address;
+	u32 value = ~0U;
+
+	register_address = ioremap(address, sizeof(value));
+	if (!register_address)
+		return value;
+	value = readl(register_address);
+	iounmap(register_address);
+	return value;
+}
+
+static void micronux_log_scanout_start_failure(struct micronux_dsi *dsi,
+					       u32 initial_frame)
+{
+	u32 frame_before, frame_after, sar_before, sar_after;
+
+	frame_before = READ_ONCE(dsi->scanout_frames);
+	sar_before = readl(dsi->channel + DW_GDMA_CH_SAR);
+	usleep_range(1000, 1100);
+	frame_after = READ_ONCE(dsi->scanout_frames);
+	sar_after = readl(dsi->channel + DW_GDMA_CH_SAR);
+	(void)micronux_sample_host_status(dsi, 0);
+
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=frames initial=%u current=%u after=%u target=%u\n",
+		initial_frame, frame_before, frame_after,
+		MICRONUX_SCANOUT_STABLE_FRAMES);
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=gdma chen=%08x abort=%08x sar=%08x->%08x\n",
+		readl(dsi->gdma + DW_GDMA_CHEN),
+		readl(dsi->gdma + DW_GDMA_CHABORT), sar_before, sar_after);
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=gdma-state llp=%08x status=%08x int=%08x ena=%08x error=%08x\n",
+		readl(dsi->channel + DW_GDMA_CH_LLP),
+		readl(dsi->channel + DW_GDMA_CH_STATUS),
+		readl(dsi->channel + DW_GDMA_CH_INT_STATUS),
+		readl(dsi->channel + DW_GDMA_CH_INT_STATUS_ENA),
+		READ_ONCE(dsi->last_dma_error));
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=bridge config=%08x raw=%08x\n",
+		readl(dsi->bridge + DSI_BRG_DPI_MISC_CONFIG),
+		readl(dsi->bridge + DSI_BRG_INT_RAW));
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=host mode=%08x active=%08x lpclk=%08x int=%08x:%08x\n",
+		readl(dsi->host + DSI_HOST_VID_MODE_CFG),
+		readl(dsi->host + DSI_HOST_VID_MODE_CFG_ACT),
+		readl(dsi->host + DSI_HOST_LPCLK_CTRL),
+		READ_ONCE(dsi->host_error0), READ_ONCE(dsi->host_error1));
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=link phy=%08x packet=%08x\n",
+		readl(dsi->host + DSI_HOST_PHY_STATUS),
+		readl(dsi->host + DSI_HOST_VID_PKT_STATUS));
+	dev_err(dsi->dev,
+		"MICRONUX:M9:SCANOUT-START-DIAG part=clock dpi=%08x apll=%08x\n",
+		micronux_read_soc_register(ESP32P4_DPI_CLOCK_CTRL_ADDRESS),
+		micronux_read_soc_register(ESP32P4_APLL_CLOCK_CTRL_ADDRESS));
+}
