 {
-	return backlight->props.brightness;
+	struct micronux_dsi *dsi = bl_get_data(backlight);
+
+	return READ_ONCE(dsi->applied_brightness);
+}
+
+static int micronux_backlight_set_power(struct micronux_dsi *dsi, int power)
+{
+	int old_power = dsi->backlight->props.power;
+	int ret;
+
+	dsi->backlight->props.power = power;
+	ret = backlight_update_status(dsi->backlight);
+	if (ret)
+		dsi->backlight->props.power = old_power;
+	return ret;
+}
+
+static void micronux_fault_work(struct work_struct *work)
+{
+	struct micronux_dsi *dsi = container_of(work, struct micronux_dsi,
+						 fault_work);
+	unsigned long faults;
+	int ret;
+
+	mutex_lock(&dsi->mode_lock);
+	mutex_lock(&dsi->backlight->ops_lock);
+	faults = READ_ONCE(dsi->fault_bits);
+	if (!READ_ONCE(dsi->scanout_ready) || !faults)
+		goto out;
+
+	WRITE_ONCE(dsi->boot_display_ready, false);
+	ret = micronux_backlight_set_power(dsi, FB_BLANK_POWERDOWN);
+	if (ret) {
+		dev_err(dsi->dev,
+			"MICRONUX:M9:DISPLAY-FAULT state=containment-failed faults=%lx host=%08x:%08x backlight=unknown source=preserved off_error=%d reboot=required\n",
+			faults, READ_ONCE(dsi->host_error0),
+			READ_ONCE(dsi->host_error1), ret);
+		goto out;
+	}
+	msleep(MICRONUX_BACKLIGHT_OFF_SETTLE_MS);
+	dev_err(dsi->dev,
+		"MICRONUX:M9:DISPLAY-FAULT state=contained faults=%lx host=%08x:%08x backlight=off source=preserved reboot=required\n",
+		faults, READ_ONCE(dsi->host_error0),
+		READ_ONCE(dsi->host_error1));
+out:
+	mutex_unlock(&dsi->backlight->ops_lock);
+	mutex_unlock(&dsi->mode_lock);
 }
 
