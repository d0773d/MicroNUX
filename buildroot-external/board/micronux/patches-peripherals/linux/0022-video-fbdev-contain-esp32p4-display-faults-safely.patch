+static void micronux_watchdog_seed_progress(struct micronux_dsi *dsi)
+{
+	dsi->watchdog_frames = READ_ONCE(dsi->scanout_frames);
+	dsi->watchdog_sar = readl(dsi->channel + DW_GDMA_CH_SAR);
+	dsi->watchdog_stale_polls = 0;
+}
