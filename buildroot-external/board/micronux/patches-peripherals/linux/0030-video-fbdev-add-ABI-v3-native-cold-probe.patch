 #define ESP32P4_INTERNAL_SRAM_START	0x4ff00000
-#define ESP32P4_INTERNAL_SRAM_END	0x50000000
+#define ESP32P4_INTERNAL_SRAM_END	0x4ffc0000
+#define ESP32P4_SD_DMA_RESERVE_START	0x4ff80000
+#define ESP32P4_SD_DMA_RESERVE_END	0x4ff82000
 #define ESP32P4_DSI_FIFO_ADDRESS		0x50105000
+#define ESP32P4_DSI_FIFO_WINDOW_END	0x50106000
 #define ESP32P4_DPI_CLOCK_CTRL_ADDRESS	0x500e603c
