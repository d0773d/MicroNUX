+
 #define ESP32P4_LOADER_PSRAM_START	0x48000000
 #define ESP32P4_LOADER_PSRAM_END		0x48400000
 #define ESP32P4_DISPLAY_POOL_START	0x49300000
@@ -69,12 +93,40 @@
 #define ESP32P4_DISPLAY_SLOT_SIZE	0x00200000
 #define ESP32P4_DISPLAY_GUARD_PATTERN	0xa5
 #define ESP32P4_DISPLAY_GUARD_WORD	0xa5a5a5a5
+#define ESP32P4_DISPLAY_HANDOFF_ADDRESS	0x49f00000
