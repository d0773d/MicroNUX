+#define MICRONUX_DISPLAY_COLD_RESET_HOLD_MS	10
+#define MICRONUX_DISPLAY_COLD_PWM_ZERO_SETTLE_MS	100
+#define MICRONUX_DISPLAY_COLD_PANEL_PAYLOAD_CRC32	0xcea07f9b
