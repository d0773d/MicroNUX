+static int micronux_validate_handoff_v3(struct micronux_dsi *dsi, u32 address)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	void __iomem *source;
+	u64 end[MICRONUX_DISPLAY_BUFFER_COUNT];
+	u64 descriptor_page_end;
+	u32 crc, expected_size, i, j;
+
+	source = (void __iomem *)(uintptr_t)(address + dsi->uncached_offset);
+	memcpy_fromio(handoff, source, sizeof(*handoff));
+	crc = crc32_le(~0U, (u8 *)handoff,
+		       offsetof(struct micronux_display_handoff_v3, crc32)) ^ ~0U;
+	if (handoff->magic != MICRONUX_DISPLAY_MAGIC)
+		return micronux_cold_reject(dsi, "magic");
+	if (handoff->abi_version != MICRONUX_DISPLAY_ABI_VERSION_V3 ||
+	    handoff->abi_version != dsi->required_handoff_abi)
+		return micronux_cold_reject(dsi, "abi-version");
+	if (handoff->struct_size != sizeof(*handoff))
+		return micronux_cold_reject(dsi, "structure-size");
+	if (crc != handoff->crc32)
+		return micronux_cold_reject(dsi, "crc32");
+	if (handoff->flags != MICRONUX_DISPLAY_V3_REQUIRED_FLAGS)
+		return micronux_cold_reject(dsi, "flags");
+
+	if (handoff->boot_mode != MICRONUX_DISPLAY_COLD_BOOT_MODE ||
+	    handoff->ownership_state != MICRONUX_DISPLAY_OWNER_LINUX_PENDING ||
+	    handoff->silicon_revision != dsi->required_silicon_revision ||
+	    handoff->panel_profile_id !=
+		    MICRONUX_DISPLAY_PANEL_PROFILE_JD9365 ||
+	    handoff->width != 800 || handoff->height != 1280 ||
+	    handoff->stride != 1600 ||
+	    handoff->pixel_format != MICRONUX_DISPLAY_PIXEL_FORMAT_RGB565_LE ||
+	    handoff->pixel_clock_hz != 80000000 ||
+	    handoff->lane_bit_rate_mbps != 1500 ||
+	    handoff->data_lanes != 2 ||
+	    handoff->buffer_count != MICRONUX_DISPLAY_BUFFER_COUNT ||
+	    handoff->hsync_pulse_width != MICRONUX_DISPLAY_HSYNC_PULSE ||
+	    handoff->hsync_back_porch != MICRONUX_DISPLAY_HSYNC_BACK_PORCH ||
+	    handoff->hsync_front_porch != MICRONUX_DISPLAY_HSYNC_FRONT_PORCH ||
+	    handoff->vsync_pulse_width != MICRONUX_DISPLAY_VSYNC_PULSE ||
+	    handoff->vsync_back_porch != MICRONUX_DISPLAY_VSYNC_BACK_PORCH ||
+	    handoff->vsync_front_porch != MICRONUX_DISPLAY_VSYNC_FRONT_PORCH)
+		return micronux_cold_reject(dsi, "panel-profile");
+
+	if (handoff->height > U32_MAX / handoff->stride)
+		return micronux_cold_reject(dsi, "frame-size-overflow");
+	expected_size = handoff->height * handoff->stride;
+	if (expected_size != 2048000 ||
+	    handoff->framebuffer_size != expected_size)
+		return micronux_cold_reject(dsi, "frame-size");
+	for (i = 0; i < MICRONUX_DISPLAY_BUFFER_COUNT; i++) {
+		end[i] = (u64)handoff->framebuffer_address[i] +
+			 handoff->framebuffer_size;
+		if (end[i] > U32_MAX ||
+		    !IS_ALIGNED(handoff->framebuffer_address[i],
+				MICRONUX_COLD_PAGE_SIZE))
+			return micronux_cold_reject(dsi, "framebuffer-bounds");
+	}
+	if (handoff->framebuffer_address[0] < ESP32P4_LOADER_PSRAM_START ||
+	    end[0] > ESP32P4_LOADER_PSRAM_END)
+		return micronux_cold_reject(dsi, "loader-front-bounds");
+	if (handoff->framebuffer_address[1] != ESP32P4_DISPLAY_BACK_ADDRESS ||
+	    handoff->framebuffer_address[2] != ESP32P4_DISPLAY_SPARE_ADDRESS)
+		return micronux_cold_reject(dsi, "display-pool-layout");
+	for (i = 1; i < MICRONUX_DISPLAY_BUFFER_COUNT; i++) {
+		if (handoff->framebuffer_address[i] <
+				ESP32P4_DISPLAY_POOL_START ||
+		    end[i] > ESP32P4_DISPLAY_POOL_END ||
+		    end[i] > handoff->framebuffer_address[i] +
+			     ESP32P4_DISPLAY_SLOT_SIZE)
+			return micronux_cold_reject(dsi, "display-pool-bounds");
+	}
+	for (i = 0; i < MICRONUX_DISPLAY_BUFFER_COUNT; i++) {
+		for (j = i + 1; j < MICRONUX_DISPLAY_BUFFER_COUNT; j++) {
+			if (handoff->framebuffer_address[i] < end[j] &&
+			    handoff->framebuffer_address[j] < end[i])
+				return micronux_cold_reject(dsi,
+						     "framebuffer-overlap");
+		}
+	}
+
+	descriptor_page_end = (u64)handoff->dma_descriptor_address +
+			      MICRONUX_COLD_PAGE_SIZE;
+	if (descriptor_page_end > U32_MAX)
+		return micronux_cold_reject(dsi, "descriptor-overflow");
+	if (handoff->dma_descriptor_address < ESP32P4_INTERNAL_SRAM_START ||
+	    descriptor_page_end > ESP32P4_INTERNAL_SRAM_END ||
+	    !IS_ALIGNED(handoff->dma_descriptor_address,
+			MICRONUX_COLD_PAGE_SIZE) ||
+	    handoff->dma_descriptor_size != MICRONUX_DMA_DESCRIPTOR_SIZE *
+					 MICRONUX_DMA_DESCRIPTOR_COUNT ||
+	    handoff->dma_descriptor_count != MICRONUX_DMA_DESCRIPTOR_COUNT)
+		return micronux_cold_reject(dsi, "descriptor-bounds");
+	if (handoff->dma_descriptor_address < ESP32P4_SD_DMA_RESERVE_END &&
+	    descriptor_page_end > ESP32P4_SD_DMA_RESERVE_START)
+		return micronux_cold_reject(dsi, "descriptor-sd-dma-overlap");
+
+	if (handoff->dma_channel != 0 ||
+	    handoff->dsi_fifo_address != ESP32P4_DSI_FIFO_ADDRESS ||
+	    handoff->gdma_irq_source != MICRONUX_DISPLAY_COLD_GDMA_IRQ_SOURCE ||
+	    handoff->gdma_clic_irq != MICRONUX_DISPLAY_COLD_GDMA_CLIC_IRQ ||
+	    handoff->gdma_clic_irq != dsi->irq ||
+	    handoff->i2c_port != MICRONUX_DISPLAY_COLD_I2C_PORT ||
+	    handoff->i2c_sda_gpio != MICRONUX_DISPLAY_COLD_I2C_SDA_GPIO ||
+	    handoff->i2c_scl_gpio != MICRONUX_DISPLAY_COLD_I2C_SCL_GPIO ||
+	    handoff->i2c_rate_hz != MICRONUX_DISPLAY_COLD_I2C_RATE_HZ ||
+	    handoff->i2c_address != 0x45 ||
+	    handoff->display_control_register != 0x95 ||
+	    handoff->backlight_register != 0x96 ||
+	    handoff->display_control_reset_assert_command !=
+		    MICRONUX_DISPLAY_COLD_RESET_ASSERT_COMMAND ||
+	    handoff->display_control_reset_prepare_command !=
+		    MICRONUX_DISPLAY_COLD_RESET_PREPARE_COMMAND ||
+	    handoff->display_control_reveal_command !=
+		    MICRONUX_DISPLAY_COLD_REVEAL_COMMAND ||
+	    handoff->backlight_brightness != MICRONUX_DISPLAY_COLD_BRIGHTNESS ||
+	    handoff->reset_hold_ms != MICRONUX_DISPLAY_COLD_RESET_HOLD_MS ||
+	    handoff->pwm_zero_settle_ms !=
+		    MICRONUX_DISPLAY_COLD_PWM_ZERO_SETTLE_MS ||
+	    handoff->panel_payload_crc32 !=
+		    MICRONUX_DISPLAY_COLD_PANEL_PAYLOAD_CRC32 ||
+	    handoff->quiesce_sequence_id != MICRONUX_DISPLAY_COLD_SEQUENCE_ID)
+		return micronux_cold_reject(dsi, "peripheral-contract");
+
+	return micronux_validate_cold_hardware(dsi);
+}
