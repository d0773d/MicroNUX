+#define ESP32P4_DSI_HOST_ADDRESS		0x500a0000
+#define ESP32P4_DSI_HOST_SIZE		0x00000800
+#define ESP32P4_DSI_BRIDGE_ADDRESS	0x500a0800
+#define ESP32P4_DSI_BRIDGE_SIZE		0x00000104
+#define ESP32P4_DMA_PMS_ADDRESS		0x500a6000
+#define ESP32P4_DMA_PMS_SIZE		0x00001000
+#define ESP32P4_GDMA_ADDRESS		0x50081000
+#define ESP32P4_GDMA_SIZE		0x00001000
+#define ESP32P4_I2C_ADDRESS		0x500c4000
+#define ESP32P4_I2C_SIZE		0x00001000
+#define ESP32P4_INTR_MATRIX_ADDRESS	0x500d6000
+#define ESP32P4_INTR_MATRIX_SIZE	0x00001000
+#define ESP32P4_GPIO_ADDRESS		0x500e0000
+#define ESP32P4_GPIO_SIZE		0x00001000
+#define ESP32P4_IOMUX_ADDRESS		0x500e1000
+#define ESP32P4_IOMUX_SIZE		0x00001000
+#define ESP32P4_HP_CLKRST_ADDRESS	0x500e6000
+#define ESP32P4_HP_CLKRST_SIZE		0x00001000
+#define ESP32P4_PMU_ADDRESS		0x50115000
+#define ESP32P4_PMU_SIZE		0x00001000
+#define ESP32P4_EFUSE_ADDRESS		0x5012d000
+#define ESP32P4_EFUSE_SIZE		0x00001000
+
 #define DSI_HOST_VID_MODE_CFG		0x38
 #define DSI_HOST_TO_CNT_CFG		0x78
 #define DSI_HOST_HS_RD_TO_CNT		0x7c
@@ -166,6 +218,42 @@
 #define MICRONUX_VPG_TEST_MIN_MS	250
 #define MICRONUX_VPG_TEST_MAX_MS	10000
 
+#define DMA_PMS_REGION_LOW(index)	(0x08 + (index) * 8)
+#define DMA_PMS_REGION_HIGH(index)	(0x0c + (index) * 8)
+#define DMA_PMS_GDMA_CH0_R		0x108
+#define DMA_PMS_GDMA_CH0_W		0x10c
+#define DMA_PMS_REGION_ADDRESS_MASK	GENMASK(31, 12)
+#define DMA_PMS_REGION1_MASK		BIT(1)
+#define DMA_PMS_REGION2_MASK		BIT(2)
+#define DMA_PMS_REGION3_MASK		BIT(3)
+#define DMA_PMS_REGION4_MASK		BIT(4)
+
+#define INTR_MATRIX_ROUTE(source)	((source) * sizeof(u32))
+#define INTR_MATRIX_ROUTE_MASK		GENMASK(5, 0)
+
+#define HP_CLKRST_SOC_CLK_CTRL0		0x14
+#define HP_CLKRST_SOC_CLK_CTRL1		0x18
+#define HP_CLKRST_SOC_CLK_CTRL2		0x1c
+#define HP_CLKRST_PERI_CLK_CTRL03	0x3c
+#define HP_CLKRST_HP_RST_EN0		0xc0
+#define HP_CLKRST_GDMA_CPU_CLK_EN	BIT(13)
+#define HP_CLKRST_GDMA_SYS_CLK_EN	BIT(5)
+#define HP_CLKRST_DSI_SYS_CLK_EN	BIT(12)
+#define HP_CLKRST_I2C0_APB_CLK_EN	BIT(12)
+#define HP_CLKRST_DSI_DPHY_CFG_CLK_EN	BIT(0)
+#define HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN BIT(1)
+#define HP_CLKRST_DSI_DPI_CLK_EN	BIT(7)
+#define HP_CLKRST_GDMA_RESET		BIT(21)
+#define HP_CLKRST_DSI_BRIDGE_RESET	BIT(26)
+
+#define PMU_EXT_LDO_P0_0P2A		0x1c0
+#define PMU_EXT_LDO_XPD		BIT(8)
+
+#define EFUSE_RD_MAC_SYS_2		0x4c
+#define EFUSE_WAFER_MINOR_MASK		GENMASK(3, 0)
+#define EFUSE_WAFER_MAJOR_LO_MASK	GENMASK(5, 4)
+#define EFUSE_WAFER_MAJOR_HI		BIT(23)
+
 #define MICRONUX_FAULT_DMA		0
 #define MICRONUX_FAULT_UNDERRUN		1
 #define MICRONUX_FAULT_STALE_FRAME	2
@@ -223,6 +311,7 @@
 #define DMA_LLI_VALID			BIT(31)
 #define MICRONUX_DMA_DESCRIPTOR_SIZE	64
 #define MICRONUX_FRAMEBUFFER_ALIGNMENT	8
+#define MICRONUX_COLD_PAGE_SIZE		0x1000
 #define MICRONUX_DMA_DESCRIPTOR_COUNT	MICRONUX_DISPLAY_BUFFER_COUNT
 
 struct micronux_display_handoff_v2 {
@@ -258,12 +347,87 @@ struct micronux_display_handoff_v2 {
 	u32 crc32;
 };
 
+struct micronux_display_handoff_v3 {
+	u32 magic;
+	u16 abi_version;
+	u16 struct_size;
+	u32 flags;
+	u32 boot_mode;
+	u32 ownership_state;
+	u32 silicon_revision;
+	u32 panel_profile_id;
+	u32 width;
+	u32 height;
+	u32 stride;
+	u32 pixel_format;
+	u32 pixel_clock_hz;
+	u32 lane_bit_rate_mbps;
+	u32 data_lanes;
+	u32 buffer_count;
+	u32 hsync_pulse_width;
+	u32 hsync_back_porch;
+	u32 hsync_front_porch;
+	u32 vsync_pulse_width;
+	u32 vsync_back_porch;
+	u32 vsync_front_porch;
+	u32 framebuffer_address[MICRONUX_DISPLAY_BUFFER_COUNT];
+	u32 framebuffer_size;
+	u32 dma_descriptor_address;
+	u32 dma_descriptor_size;
+	u32 dma_descriptor_count;
+	u32 dma_channel;
+	u32 dsi_fifo_address;
+	u32 gdma_irq_source;
+	u32 gdma_clic_irq;
+	u32 i2c_port;
+	u32 i2c_sda_gpio;
+	u32 i2c_scl_gpio;
+	u32 i2c_rate_hz;
+	u32 i2c_address;
+	u32 display_control_register;
+	u32 backlight_register;
+	u32 display_control_reset_assert_command;
+	u32 display_control_reset_prepare_command;
+	u32 display_control_reveal_command;
+	u32 backlight_brightness;
+	u32 reset_hold_ms;
+	u32 pwm_zero_settle_ms;
+	u32 panel_payload_crc32;
+	u32 quiesce_sequence_id;
+	u32 crc32;
+};
+
+static_assert(sizeof(struct micronux_display_handoff_v3) ==
+	      MICRONUX_DISPLAY_HANDOFF_V3_SIZE);
+static_assert(offsetof(struct micronux_display_handoff_v3,
+		       framebuffer_address) == 0x54);
+static_assert(offsetof(struct micronux_display_handoff_v3,
+		       gdma_irq_source) == 0x78);
+static_assert(offsetof(struct micronux_display_handoff_v3,
+		       panel_payload_crc32) == 0xb4);
+static_assert(offsetof(struct micronux_display_handoff_v3,
+		       quiesce_sequence_id) == 0xb8);
+static_assert(offsetof(struct micronux_display_handoff_v3, crc32) == 0xbc);
+
+enum micronux_display_state {
+	MICRONUX_DISPLAY_STATE_UNBOUND,
+	MICRONUX_DISPLAY_STATE_PROBED_QUIESCENT,
+	MICRONUX_DISPLAY_STATE_RUNTIME_READY,
+};
+
 struct micronux_dsi {
 	struct device *dev;
 	void __iomem *host;
 	void __iomem *bridge;
+	void __iomem *dma_pms;
 	void __iomem *gdma;
 	void __iomem *i2c;
+	void __iomem *intr_matrix;
+	void __iomem *gpio;
+	void __iomem *iomux;
+	void __iomem *hp_clkrst;
+	void __iomem *pmu;
+	void __iomem *efuse;
 	void __iomem *channel;
 	void __iomem *descriptor[MICRONUX_DISPLAY_BUFFER_COUNT];
 	void __iomem *framebuffer[MICRONUX_DISPLAY_BUFFER_COUNT];
@@ -282,6 +446,10 @@ struct micronux_dsi {
 	/* Serializes the read-to-clear DSI host status registers. */
 	spinlock_t host_status_lock;
 	struct micronux_display_handoff_v2 handoff;
+	struct micronux_display_handoff_v3 cold_handoff;
+	enum micronux_display_state display_state;
+	u32 required_handoff_abi;
+	u32 required_silicon_revision;
 	u32 uncached_offset;
 	u32 palette[16];
 	u32 scanout_frames;
@@ -2104,7 +2272,85 @@ static struct attribute *micronux_display_attrs[] = {
 };
 ATTRIBUTE_GROUPS(micronux_display);
 
-static int micronux_validate_handoff(struct micronux_dsi *dsi, u32 address)
+static ssize_t native_state_show(struct device *dev,
+				 struct device_attribute *attribute, char *buf)
+{
+	struct micronux_dsi *dsi = dev_get_drvdata(dev);
+
+	if (dsi->display_state == MICRONUX_DISPLAY_STATE_PROBED_QUIESCENT)
+		return sysfs_emit(buf, "PROBED_QUIESCENT\n");
+	if (dsi->display_state == MICRONUX_DISPLAY_STATE_RUNTIME_READY)
+		return sysfs_emit(buf, "RUNTIME_READY\n");
+	return sysfs_emit(buf, "UNBOUND\n");
+}
+static DEVICE_ATTR_RO(native_state);
+
+static int micronux_map_exact_resource(struct platform_device *pdev,
+				       const char *name,
+				       resource_size_t start,
+				       resource_size_t size,
+				       void __iomem **base)
+{
+	struct resource *resource;
+
+	resource = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (!resource || resource->start != start ||
+	    resource_size(resource) != size) {
+		dev_err(&pdev->dev,
+			"invalid cold display MMIO resource: %s\n", name);
+		return -EINVAL;
+	}
+	*base = devm_ioremap_resource(&pdev->dev, resource);
+	return PTR_ERR_OR_ZERO(*base);
+}
+
+static int micronux_map_cold_resources(struct platform_device *pdev,
+				       struct micronux_dsi *dsi)
+{
+	struct {
+		const char *name;
+		resource_size_t start;
+		resource_size_t size;
+		void __iomem **base;
+	} resources[] = {
+		{ "dsi-host", ESP32P4_DSI_HOST_ADDRESS,
+		  ESP32P4_DSI_HOST_SIZE, &dsi->host },
+		{ "dsi-bridge", ESP32P4_DSI_BRIDGE_ADDRESS,
+		  ESP32P4_DSI_BRIDGE_SIZE, &dsi->bridge },
+		{ "dma-pms", ESP32P4_DMA_PMS_ADDRESS,
+		  ESP32P4_DMA_PMS_SIZE, &dsi->dma_pms },
+		{ "gdma", ESP32P4_GDMA_ADDRESS,
+		  ESP32P4_GDMA_SIZE, &dsi->gdma },
+		{ "i2c", ESP32P4_I2C_ADDRESS,
+		  ESP32P4_I2C_SIZE, &dsi->i2c },
+		{ "intr-matrix", ESP32P4_INTR_MATRIX_ADDRESS,
+		  ESP32P4_INTR_MATRIX_SIZE, &dsi->intr_matrix },
+		{ "gpio", ESP32P4_GPIO_ADDRESS,
+		  ESP32P4_GPIO_SIZE, &dsi->gpio },
+		{ "iomux", ESP32P4_IOMUX_ADDRESS,
+		  ESP32P4_IOMUX_SIZE, &dsi->iomux },
+		{ "hp-clkrst", ESP32P4_HP_CLKRST_ADDRESS,
+		  ESP32P4_HP_CLKRST_SIZE, &dsi->hp_clkrst },
+		{ "pmu", ESP32P4_PMU_ADDRESS,
+		  ESP32P4_PMU_SIZE, &dsi->pmu },
+		{ "efuse", ESP32P4_EFUSE_ADDRESS,
+		  ESP32P4_EFUSE_SIZE, &dsi->efuse },
+	};
+	u32 i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(resources); i++) {
+		ret = micronux_map_exact_resource(pdev, resources[i].name,
+						  resources[i].start,
+						  resources[i].size,
+						  resources[i].base);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int micronux_validate_handoff_v2(struct micronux_dsi *dsi, u32 address)
 {
 	struct micronux_display_handoff_v2 *handoff = &dsi->handoff;
 	void __iomem *channel;
@@ -2119,7 +2365,7 @@ static int micronux_validate_handoff(struct micronux_dsi *dsi, u32 address)
 	crc = crc32_le(~0U, (u8 *)handoff,
 		       offsetof(struct micronux_display_handoff_v2, crc32)) ^ ~0U;
 	if (handoff->magic != MICRONUX_DISPLAY_MAGIC ||
-	    handoff->abi_version != MICRONUX_DISPLAY_ABI_VERSION ||
+	    handoff->abi_version != MICRONUX_DISPLAY_ABI_VERSION_V2 ||
 	    handoff->struct_size != sizeof(*handoff) ||
 	    crc != handoff->crc32 ||
 	    (handoff->flags & MICRONUX_DISPLAY_REQUIRED_FLAGS) !=
@@ -2223,6 +2469,242 @@ static int micronux_validate_handoff(struct micronux_dsi *dsi, u32 address)
 	return 0;
 }
 
+static int micronux_cold_reject(struct micronux_dsi *dsi,
+				const char *reason)
+{
+	dev_err(dsi->dev,
+		"MICRONUX:M9.2:COLD-PROBE state=REJECTED_NO_WRITES reason=%s display-writes=0\n",
+		reason);
+	return -EINVAL;
+}
+
+static bool micronux_pms_region_matches(struct micronux_dsi *dsi,
+					u32 region, u32 low, u32 high)
+{
+	return readl(dsi->dma_pms + DMA_PMS_REGION_LOW(region)) ==
+		       (low & DMA_PMS_REGION_ADDRESS_MASK) &&
+	       readl(dsi->dma_pms + DMA_PMS_REGION_HIGH(region)) ==
+		       (high & DMA_PMS_REGION_ADDRESS_MASK);
+}
+
+static u32 micronux_cold_silicon_revision(struct micronux_dsi *dsi)
+{
+	u32 major, minor;
+	u32 value = readl(dsi->efuse + EFUSE_RD_MAC_SYS_2);
+
+	minor = value & EFUSE_WAFER_MINOR_MASK;
+	major = (value & EFUSE_WAFER_MAJOR_LO_MASK) >> 4;
+	if (value & EFUSE_WAFER_MAJOR_HI)
+		major |= BIT(2);
+	return major * 100 + minor;
+}
+
+static int micronux_validate_cold_hardware(struct micronux_dsi *dsi)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	void __iomem *descriptor;
+	u32 clocks0, clocks1, clocks2, peri03, reset;
+	u32 descriptor_end, descriptor_start, front_end, front_start;
+	u32 fifo_end = ESP32P4_DSI_FIFO_WINDOW_END;
+	u32 fifo_start = ESP32P4_DSI_FIFO_ADDRESS;
+	u32 pool_end = ESP32P4_DISPLAY_POOL_END;
+	u32 pool_start = ESP32P4_DISPLAY_POOL_START;
+	u32 route;
+	u32 i;
+
+	if (micronux_cold_silicon_revision(dsi) !=
+	    dsi->required_silicon_revision)
+		return micronux_cold_reject(dsi, "silicon-readback");
+
+	reset = readl(dsi->hp_clkrst + HP_CLKRST_HP_RST_EN0);
+	clocks0 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL0);
+	clocks1 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL1);
+	clocks2 = readl(dsi->hp_clkrst + HP_CLKRST_SOC_CLK_CTRL2);
+	peri03 = readl(dsi->hp_clkrst + HP_CLKRST_PERI_CLK_CTRL03);
+	if ((reset & (HP_CLKRST_GDMA_RESET |
+		      HP_CLKRST_DSI_BRIDGE_RESET)) !=
+		     (HP_CLKRST_GDMA_RESET | HP_CLKRST_DSI_BRIDGE_RESET) ||
+	    (clocks0 & HP_CLKRST_GDMA_CPU_CLK_EN) ||
+	    (clocks1 & (HP_CLKRST_GDMA_SYS_CLK_EN |
+			HP_CLKRST_DSI_SYS_CLK_EN)) ||
+	    (peri03 & (HP_CLKRST_DSI_DPHY_CFG_CLK_EN |
+		       HP_CLKRST_DSI_DPHY_PLL_REFCLK_EN |
+		       HP_CLKRST_DSI_DPI_CLK_EN)))
+		return micronux_cold_reject(dsi, "display-reset-clock-state");
+	if (readl(dsi->pmu + PMU_EXT_LDO_P0_0P2A) & PMU_EXT_LDO_XPD)
+		return micronux_cold_reject(dsi, "dphy-ldo-enabled");
+	if (clocks2 & HP_CLKRST_I2C0_APB_CLK_EN)
+		return micronux_cold_reject(dsi, "i2c-not-released");
+
+	route = readl(dsi->intr_matrix +
+		      INTR_MATRIX_ROUTE(handoff->gdma_irq_source));
+	if ((route & INTR_MATRIX_ROUTE_MASK) != handoff->gdma_clic_irq)
+		return micronux_cold_reject(dsi, "gdma-irq-route");
+
+	front_start = handoff->framebuffer_address[0];
+	front_end = front_start + handoff->framebuffer_size;
+	descriptor_start = handoff->dma_descriptor_address;
+	descriptor_end = descriptor_start + MICRONUX_COLD_PAGE_SIZE;
+	if (!micronux_pms_region_matches(dsi, 1, front_start, front_end) ||
+	    !micronux_pms_region_matches(dsi, 2, pool_start, pool_end) ||
+	    !micronux_pms_region_matches(dsi, 3, descriptor_start,
+					 descriptor_end) ||
+	    !micronux_pms_region_matches(dsi, 4, fifo_start, fifo_end) ||
+	    readl(dsi->dma_pms + DMA_PMS_GDMA_CH0_R) !=
+		    (DMA_PMS_REGION1_MASK | DMA_PMS_REGION2_MASK |
+		     DMA_PMS_REGION3_MASK) ||
+	    readl(dsi->dma_pms + DMA_PMS_GDMA_CH0_W) !=
+		    (DMA_PMS_REGION3_MASK | DMA_PMS_REGION4_MASK))
+		return micronux_cold_reject(dsi, "dma-pms-policy");
+
+	descriptor = (void __iomem *)(uintptr_t)
+		(handoff->dma_descriptor_address + dsi->uncached_offset);
+	for (i = 0; i < MICRONUX_COLD_PAGE_SIZE; i++) {
+		if (readb(descriptor + i))
+			return micronux_cold_reject(dsi,
+						     "descriptor-storage-not-zero");
+	}
+
+	/*
+	 * Host, bridge, and GDMA registers are not readable with their clocks off
+	 * and resets asserted.  Their stopped/no-pending state is bounded by those
+	 * raw clock/reset readbacks and the loader's exact ABI-v3 claims.  The
+	 * loader command history is contract-bound: ACKed PWM0=0, ACKed control
+	 * 0x13, the required settle, ACKed control 0x11, then the required hold
+	 * before I2C release.  This makes no physical register-state claim. Stage B
+	 * must initialize I2C and reissue that safe sequence before enabling the LDO
+	 * or changing any display state. No unproven readback is used.
+	 */
+	return 0;
+}
