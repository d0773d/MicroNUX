+
 #define MICRONUX_DISPLAY_HSYNC_PULSE	20
 #define MICRONUX_DISPLAY_HSYNC_BACK_PORCH 20
 #define MICRONUX_DISPLAY_HSYNC_FRONT_PORCH 40
@@ -60,6 +66,24 @@
 					 MICRONUX_DISPLAY_LOADER_FRONT_VALID | \
 					 MICRONUX_DISPLAY_HOST_VPG_ACTIVE)
 
+#define MICRONUX_DISPLAY_V3_REQUIRED_FLAGS	0x00003fff
+#define MICRONUX_DISPLAY_COLD_GDMA_IRQ_SOURCE	24
