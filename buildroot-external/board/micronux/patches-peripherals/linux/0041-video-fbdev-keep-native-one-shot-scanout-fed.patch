+		if (arm_to_irq_ns > MICRONUX_NATIVE_ARM_TO_IRQ_SLOW_NS)
+			dsi->native_arm_to_irq_over_20ms++;
+	}
+	dsi->native_fifo_irq_last = fifo_depth;
+	dsi->native_fifo_irq_min = min(dsi->native_fifo_irq_min, fifo_depth);
