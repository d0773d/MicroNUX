+		dsi->native_fifo_poll_last = fifo_depth;
+		dsi->native_fifo_poll_min =
+			min(dsi->native_fifo_poll_min, fifo_depth);
+		if (!fifo_depth)
+			dsi->native_fifo_poll_zero++;
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+	}
 	if (bridge_status & DSI_BRG_INT_UNDERRUN) {
 		writel(DSI_BRG_INT_UNDERRUN,
 		       dsi->bridge + DSI_BRG_INT_CLR);
@@ -3117,10 +3261,12 @@ static ssize_t scanout_show(struct device *dev,
