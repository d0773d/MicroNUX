+static int
+micronux_native_dma_rearm_frame_fast(struct micronux_dsi *dsi, u8 index,
+				     u64 irq_entry_ns)
+{
+	u32 channel = BIT(dsi->handoff.dma_channel);
+	u32 descriptor_address;
+	void __iomem *descriptor;
+	u64 arm_ns, rearm_ns;
+
+	if (index >= MICRONUX_DISPLAY_BUFFER_COUNT)
+		return -EINVAL;
+	descriptor_address = dsi->handoff.dma_descriptor_address +
+			     index * MICRONUX_DMA_DESCRIPTOR_SIZE;
+	descriptor = dsi->descriptor[index];
+	WRITE_ONCE(dsi->rearm_attempts,
+		   READ_ONCE(dsi->rearm_attempts) + 1);
+	/* The caller holds state_lock; keep the source-off window minimal. */
+	writel(MICRONUX_NATIVE_DMA_DESCRIPTOR_ARMED,
+	       descriptor + DMA_LLI_CTRL_HI);
+	writel(descriptor_address | DW_GDMA_LLP_MEMORY_PORT,
+	       dsi->channel + DW_GDMA_CH_LLP);
+	writel(0, dsi->channel + DW_GDMA_CH_LLP + sizeof(u32));
+	/* Publish the descriptor and link before enabling the channel. */
+	wmb();
+	writel(channel | (channel << 8), dsi->gdma + DW_GDMA_CHEN);
+	arm_ns = local_clock();
+	rearm_ns = arm_ns - irq_entry_ns;
+	dsi->native_rearm_last_ns = rearm_ns;
+	dsi->native_rearm_max_ns = max(dsi->native_rearm_max_ns, rearm_ns);
+	dsi->native_last_arm_ns = arm_ns;
+	return 0;
+}
