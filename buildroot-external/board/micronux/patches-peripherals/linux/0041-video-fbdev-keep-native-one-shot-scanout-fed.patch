 static int
 micronux_native_dma_arm_frame(struct micronux_dsi *dsi, u8 index,
 			      struct micronux_scanout_snapshot *failure_snapshot)
 {
+	unsigned long flags;
 	u32 channel = BIT(dsi->handoff.dma_channel);
 	u32 descriptor_address = dsi->handoff.dma_descriptor_address +
 				 index * MICRONUX_DMA_DESCRIPTOR_SIZE;
@@ -2233,6 +2320,9 @@ micronux_native_dma_arm_frame(struct micronux_dsi *dsi, u8 index,
 							  failure_snapshot, index, 0);
 		return -EIO;
 	}
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	dsi->native_last_arm_ns = local_clock();
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
 	return 0;
 }
 
