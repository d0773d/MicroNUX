+	micronux_native_unregister_runtime_objects(dsi);
+	runtime_off = micronux_cold_runtime_teardown(dsi);
+	i2c_released = micronux_cold_i2c_gate(dsi) &&
+		       micronux_cold_i2c_released(dsi);
+	dsi_off = micronux_cold_dsi_disable(dsi);
+	ldo_off = micronux_cold_ldo_disable(dsi);
+	contained = dark && runtime_off && i2c_released && dsi_off && ldo_off;
+	WRITE_ONCE(dsi->cold_runtime_unverified, !contained);
+	WRITE_ONCE(dsi->display_state,
+		   contained ? MICRONUX_DISPLAY_STATE_FAILED_QUIESCENT :
+		   MICRONUX_DISPLAY_STATE_FAILED_UNVERIFIED);
+	dev_err(dsi->dev,
+		"MICRONUX:M9.2:REVEAL state=%s stage=%s error=%d pwm-zero-command=%s reset-prepare-command=%s source=stopped dsi-gdma=%s i2c0=%s ldo3-xpd=%s darkness=%s physical-panel-state=unobserved retry=reboot-only\n",
+		contained ? "FAILED_QUIESCENT" : "FAILED_UNVERIFIED",
+		stage, error, pwm_ret ? "failed" : "acked",
+		control_ret ? "failed" : "acked",
+		runtime_off && dsi_off ? "resets-asserted-clocks-off" :
+		"state-error",
+		i2c_released ? "released-gated" : "state-error",
+		ldo_off ? "clear" : "error",
+		dark ? "commanded-not-observed" : "not-confirmed");
+}
