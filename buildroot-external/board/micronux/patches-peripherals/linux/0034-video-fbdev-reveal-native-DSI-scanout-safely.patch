From 3286f665d4a4751f2073e702cd8d7cbf1590b7b3 Mon Sep 17 00:00:00 2001
From: d0773d <dottedquad@gmail.com>
Date: Wed, 12 Aug 2026 02:33:10 -0700
Subject: [PATCH 34/46] video: fbdev: reveal native DSI scanout safely

Expose the ABI-v3 boot_ready gate only after the qualified native
framebuffer is live. Bind its one-shot request to a completed userspace
commit and four additional clean same-front completions before
reacquiring I2C.

Keep the external adapter at PWM zero and control 0x13 throughout dark
qualification, then issue the ACKed boot reveal as control 0x17 followed
by PWM 63. Register the backlight at that boundary, publish truthful
ABI-v3 runtime diagnostics, and defer touch registration until after
reveal.

Continue native health monitoring through reveal and runtime. On any
scanout, host, bridge, GDMA, pool, I2C, or backlight-control fault,
command PWM zero and control 0x13 before teardown; preserve the current
source when darkness cannot be confirmed. Make remove off-first but
always release kernel resources, and leave ABI-v2 behavior unchanged.

Signed-off-by: d0773d <dottedquad@gmail.com>
---
 drivers/video/fbdev/esp32p4-dsi.c | 918 ++++++++++++++++++++++++++++--
 1 file changed, 881 insertions(+), 37 deletions(-)

diff --git a/drivers/video/fbdev/esp32p4-dsi.c b/drivers/video/fbdev/esp32p4-dsi.c
index 81ed0de..8948d4a 100644
--- a/drivers/video/fbdev/esp32p4-dsi.c
+++ b/drivers/video/fbdev/esp32p4-dsi.c
@@ -32,6 +32,7 @@
 #include <linux/spinlock.h>
 #include <linux/uaccess.h>
 #include <linux/unaligned.h>
+#include <linux/wait.h>
 #include <linux/workqueue.h>
 
 #define MICRONUX_DISPLAY_MAGIC		0x4d4e5844
@@ -335,9 +336,11 @@
 #define DW_GDMA_INT_COMMON_VALID_MASK	0x001fff8f
 #define DW_GDMA_INT_COMMON_RO_MASK	0x001ffe80
 #define DW_GDMA_INT_TOP_CHANNEL0	BIT(0)
+#define DW_GDMA_INT_TOP_INACTIVE	GENMASK(3, 1)
 #define DW_GDMA_INT_TOP_COMMON		BIT(16)
 #define DW_GDMA_INT_TOP_ALLOWED		(DW_GDMA_INT_TOP_CHANNEL0 | \
 					 DW_GDMA_INT_TOP_COMMON)
+#define DW_GDMA_CHANNEL_COUNT		4
 #define DW_GDMA_LLP_MEMORY_PORT		BIT(0)
 #define MICRONUX_DMA_BLOCK_TRANSFER_SIZE 0x0003e7ff
 #define MICRONUX_DMA_DESCRIPTOR_CTRL_LO	0x001e1b41
@@ -353,11 +356,16 @@
 #define MICRONUX_SCANOUT_START_TIMEOUT_MS 500
 #define MICRONUX_SCANOUT_STABLE_FRAMES	4
 #define MICRONUX_NATIVE_QUALIFICATION_WINDOWS	2
+#define MICRONUX_NATIVE_REVEAL_TIMEOUT_MS	500
+#define MICRONUX_NATIVE_I2C_TRANSITION_MS	100
 #define MICRONUX_FRAME_REVEAL_RECENT_MS	250
 #define MICRONUX_BACKLIGHT_OFF_SETTLE_MS 100
 #define MICRONUX_DISPLAY_BACKLIGHT_DISABLED 0x13
 #define MICRONUX_DISPLAY_BACKLIGHT_ENABLED 0x17
 #define MICRONUX_VPG_SOURCE_SETTLE_MS	250
+
+static const char native_no_completion[] =
+	"MICRONUX:M9.2:REVEAL source-rearm=UNVERIFIED no-completion darkness=unconfirmed\n";
 #define MICRONUX_VPG_TEST_MIN_MS	250
 #define MICRONUX_VPG_TEST_MAX_MS	10000
 
@@ -435,6 +443,7 @@
 #define MICRONUX_FAULT_STALE_FRAME	2
 #define MICRONUX_FAULT_DSI_HOST		3
 #define MICRONUX_FAULT_POOL_GUARD	4
+#define MICRONUX_FAULT_BACKLIGHT_CONTROL 5
 #define MICRONUX_STALE_POLL_LIMIT	6
 
 #define MICRONUX_TOUCH_ADDRESS_PRIMARY	0x5d
@@ -637,12 +646,20 @@ enum micronux_display_state {
 	MICRONUX_DISPLAY_STATE_PANEL_PROGRAMMED_QUIESCENT,
 	MICRONUX_DISPLAY_STATE_SCANOUT_INITIALIZING,
 	MICRONUX_DISPLAY_STATE_SCANOUT_QUALIFIED_QUIESCENT,
+	MICRONUX_DISPLAY_STATE_REVEALING,
+	MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED,
 	MICRONUX_DISPLAY_STATE_REMOVING,
 	MICRONUX_DISPLAY_STATE_FAILED_QUIESCENT,
 	MICRONUX_DISPLAY_STATE_FAILED_UNVERIFIED,
 	MICRONUX_DISPLAY_STATE_RUNTIME_READY,
 };
 
+enum micronux_native_i2c_state {
+	MICRONUX_NATIVE_I2C_RELEASED,
+	MICRONUX_NATIVE_I2C_TRANSITION,
+	MICRONUX_NATIVE_I2C_ACTIVE_SERIALIZED,
+};
+
 struct micronux_i2c_timing {
 	u32 clkm_div;
 	u32 scl_low;
@@ -698,10 +715,12 @@ struct micronux_dsi {
 	/* Serializes fbdev writes and back-buffer preparation. */
 	struct mutex render_lock;
 	struct delayed_work render_work;
+	struct work_struct touch_register_work;
 	/* Protects front, queued, and render buffer roles from the DMA IRQ. */
 	spinlock_t state_lock;
 	/* Serializes the read-to-clear DSI host status registers. */
 	spinlock_t host_status_lock;
+	wait_queue_head_t frame_wait;
 	struct micronux_display_handoff_v2 handoff;
 	struct micronux_display_handoff_v3 cold_handoff;
 	enum micronux_display_state display_state;
@@ -721,6 +740,11 @@ struct micronux_dsi {
 	u32 host_error0;
 	u32 host_error1;
 	u32 vpg_dpi_status1;
+	u64 next_commit_sequence;
+	u64 buffer_commit_sequence[MICRONUX_DISPLAY_BUFFER_COUNT];
+	u64 front_commit_sequence;
+	u64 presented_commit_sequence;
+	u64 dark_baseline_commit_sequence;
 	u32 watchdog_frames;
 	u32 watchdog_sar;
 	unsigned long fault_bits;
@@ -729,6 +753,7 @@ struct micronux_dsi {
 	u8 applied_brightness;
 	bool backlight_gate_enabled;
 	u8 front_index;
+	u8 presented_index;
 	u8 render_index;
 	s8 queued_index;
 	bool render_needs_sync;
@@ -756,6 +781,17 @@ struct micronux_dsi {
 	bool cold_timer_initialized;
 	bool cold_runtime_unverified;
 	bool render_enabled;
+	bool boot_ready_consumed;
+	bool boot_ready_file_created;
+	bool native_runtime_group_created;
+	bool native_backlight_registered;
+	bool touch_registration_complete;
+	bool native_preserve_source;
+	bool native_dark_confirmed;
+	bool native_reveal_may_be_lit;
+	bool native_source_rearm_unverified;
+	enum micronux_native_i2c_state native_i2c_state;
+	unsigned long native_i2c_transition_deadline;
 	struct hrtimer scanout_timer;
 	struct work_struct fault_work;
 };
@@ -991,6 +1027,16 @@ static bool micronux_pool_guards_valid(struct micronux_dsi *dsi, bool full)
 
 static bool micronux_source_policy_valid(struct micronux_dsi *dsi,
 					 bool vpg);
+static bool micronux_native_runtime_policy_valid(struct micronux_dsi *dsi);
+
+static bool micronux_native_scanout_live_state(struct micronux_dsi *dsi)
+{
+	enum micronux_display_state state = READ_ONCE(dsi->display_state);
+
+	return state == MICRONUX_DISPLAY_STATE_SCANOUT_QUALIFIED_QUIESCENT ||
+	       state == MICRONUX_DISPLAY_STATE_REVEALING ||
+	       state == MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED;
+}
 
 static bool micronux_visible_source_valid(struct micronux_dsi *dsi)
 {
@@ -999,6 +1045,28 @@ static bool micronux_visible_source_valid(struct micronux_dsi *dsi)
 
 	if (!READ_ONCE(dsi->scanout_ready))
 		return false;
+	if (dsi->required_handoff_abi ==
+	    MICRONUX_DISPLAY_ABI_VERSION_V3) {
+		if (micronux_sample_host_status(dsi, 0))
+			micronux_latch_fault(dsi, MICRONUX_FAULT_DSI_HOST);
+		if (READ_ONCE(dsi->display_state) !=
+			MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED ||
+		    !READ_ONCE(dsi->boot_display_ready) ||
+		    !READ_ONCE(dsi->scanout_active) ||
+		    READ_ONCE(dsi->fault_bits) ||
+		    !micronux_pool_guards_valid(dsi, false) ||
+		    !micronux_host_status_clean(dsi) ||
+		    READ_ONCE(dsi->last_dma_error) ||
+		    (readl(dsi->bridge + DSI_BRG_INT_RAW) &
+		     DSI_BRG_INT_UNDERRUN) ||
+		    !micronux_native_runtime_policy_valid(dsi))
+			return false;
+		last_frame = READ_ONCE(dsi->last_frame_jiffies);
+		return last_frame &&
+		       !time_after(jiffies,
+				   last_frame +
+				   msecs_to_jiffies(MICRONUX_FRAME_REVEAL_RECENT_MS));
+	}
 	vpg = READ_ONCE(dsi->vpg_test_active);
 	if (!vpg)
 		(void)micronux_sample_host_status(dsi, 0);
@@ -1044,6 +1112,118 @@ static int micronux_backlight_disable(struct micronux_dsi *dsi)
 	return 0;
 }
 
+static int micronux_native_write_pwm(struct micronux_dsi *dsi, u8 brightness)
+{
+	u8 address = dsi->cold_handoff.i2c_address;
+	u8 reg = dsi->cold_handoff.backlight_register;
+
+	return micronux_i2c_write_reg8(dsi, address, reg, brightness);
+}
+
+static int micronux_native_write_control(struct micronux_dsi *dsi, u8 command)
+{
+	u8 address = dsi->cold_handoff.i2c_address;
+	u8 reg = dsi->cold_handoff.display_control_register;
+
+	return micronux_i2c_write_reg8(dsi, address, reg, command);
+}
+
+static void micronux_native_latch_backlight_fault(struct micronux_dsi *dsi,
+						  int error)
+{
+	if (!error)
+		return;
+	set_bit(MICRONUX_FAULT_BACKLIGHT_CONTROL, &dsi->fault_bits);
+	/* The worker waits for any active backlight ops_lock owner. */
+	schedule_work(&dsi->fault_work);
+}
+
+static int micronux_native_backlight_disable(struct micronux_dsi *dsi)
+{
+	u8 command = dsi->cold_handoff.display_control_reset_prepare_command;
+	int control_ret, pwm_ret;
+
+	pwm_ret = micronux_native_write_pwm(dsi, 0);
+	if (!pwm_ret)
+		WRITE_ONCE(dsi->applied_brightness, 0);
+	control_ret = micronux_native_write_control(dsi, command);
+	if (!control_ret)
+		WRITE_ONCE(dsi->backlight_gate_enabled, false);
+	micronux_native_latch_backlight_fault(dsi, pwm_ret ? pwm_ret : control_ret);
+	return pwm_ret ? pwm_ret : control_ret;
+}
+
+static int
+micronux_native_backlight_update(struct backlight_device *backlight)
+{
+	struct micronux_dsi *dsi = bl_get_data(backlight);
+	u8 brightness = backlight_get_brightness(backlight);
+	u8 reveal_command = dsi->cold_handoff.display_control_reveal_command;
+	int control_ret = 0, off_ret, pwm_ret;
+
+	if (READ_ONCE(dsi->display_state) !=
+	    MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED)
+		return -EAGAIN;
+	if (backlight_is_blank(backlight))
+		brightness = 0;
+	if (!brightness)
+		return micronux_native_backlight_disable(dsi);
+	if (!micronux_visible_source_valid(dsi)) {
+		off_ret = micronux_native_backlight_disable(dsi);
+		backlight->props.brightness = 0;
+		backlight->props.power = FB_BLANK_POWERDOWN;
+		return off_ret ? off_ret : -EHOSTDOWN;
+	}
+
+	if (!READ_ONCE(dsi->backlight_gate_enabled)) {
+		pwm_ret = micronux_native_write_pwm(dsi, 0);
+		if (pwm_ret) {
+			micronux_native_latch_backlight_fault(dsi, pwm_ret);
+			goto rollback;
+		}
+		WRITE_ONCE(dsi->applied_brightness, 0);
+		control_ret = micronux_native_write_control(dsi, reveal_command);
+		if (control_ret) {
+			micronux_native_latch_backlight_fault(dsi, control_ret);
+			goto rollback;
+		}
+		WRITE_ONCE(dsi->backlight_gate_enabled, true);
+		pwm_ret = micronux_native_write_pwm(dsi, brightness);
+		if (pwm_ret) {
+			micronux_native_latch_backlight_fault(dsi, pwm_ret);
+			goto rollback;
+		}
+		WRITE_ONCE(dsi->applied_brightness, brightness);
+		if (!micronux_visible_source_valid(dsi)) {
+			pwm_ret = -EHOSTDOWN;
+			goto rollback;
+		}
+		return 0;
+	}
+	pwm_ret = micronux_native_write_pwm(dsi, brightness);
+	if (pwm_ret)
+		micronux_native_latch_backlight_fault(dsi, pwm_ret);
+	if (!pwm_ret) {
+		WRITE_ONCE(dsi->applied_brightness, brightness);
+		if (!micronux_visible_source_valid(dsi)) {
+			pwm_ret = -EHOSTDOWN;
+			goto rollback;
+		}
+		return 0;
+	}
+
+rollback:
+	off_ret = micronux_native_backlight_disable(dsi);
+	/* Do not leave a failed positive request armed for a later unblank. */
+	backlight->props.brightness = 0;
+	backlight->props.power = FB_BLANK_POWERDOWN;
+	if (off_ret)
+		dev_err(dsi->dev,
+			"native backlight rollback was not fully ACKed: %d\n",
+			off_ret);
+	return control_ret ? control_ret : pwm_ret;
+}
+
 static int micronux_backlight_update(struct backlight_device *backlight)
 {
 	struct micronux_dsi *dsi = bl_get_data(backlight);
@@ -1052,6 +1232,10 @@ static int micronux_backlight_update(struct backlight_device *backlight)
 	bool policy_valid, vpg;
 	int disable_ret, gate_ret, pwm_ret;
 
+	if (dsi->required_handoff_abi ==
+	    MICRONUX_DISPLAY_ABI_VERSION_V3)
+		return micronux_native_backlight_update(backlight);
+
 	if (backlight_is_blank(backlight))
 		brightness = 0;
 	if (!brightness)
@@ -1127,6 +1311,17 @@ static int micronux_backlight_set_power(struct micronux_dsi *dsi, int power)
 
 static void micronux_cold_runtime_fail_quiescent(struct micronux_dsi *dsi,
 						 const char *stage, int error);
+static void micronux_native_fail_reveal_locked(struct micronux_dsi *dsi,
+					       const char *stage, int error,
+					       bool force_teardown);
+static void micronux_commit_render_locked(struct micronux_dsi *dsi);
+static int micronux_cold_i2c_initialize(struct micronux_dsi *dsi);
+static int micronux_register_native_backlight(struct micronux_dsi *dsi);
+static int
+micronux_native_requalify_front(struct micronux_dsi *dsi, u64 target);
+static bool micronux_native_final_status_clean(struct micronux_dsi *dsi);
+static const struct attribute_group micronux_native_runtime_group;
+static void micronux_native_unregister_runtime_objects(struct micronux_dsi *dsi);
 
 static void micronux_fault_work(struct work_struct *work)
 {
@@ -1139,10 +1334,16 @@ static void micronux_fault_work(struct work_struct *work)
 	faults = READ_ONCE(dsi->fault_bits);
 	if (dsi->required_handoff_abi ==
 	    MICRONUX_DISPLAY_ABI_VERSION_V3) {
-		if (faults &&
-		    READ_ONCE(dsi->display_state) ==
-			MICRONUX_DISPLAY_STATE_SCANOUT_QUALIFIED_QUIESCENT)
-			micronux_cold_runtime_fail_quiescent(dsi, "runtime-fault", -EIO);
+		enum micronux_display_state state =
+			READ_ONCE(dsi->display_state);
+
+		if (faults && state ==
+		    MICRONUX_DISPLAY_STATE_SCANOUT_QUALIFIED_QUIESCENT)
+			micronux_cold_runtime_fail_quiescent(dsi, "runtime-fault-dark", -EIO);
+		else if (faults &&
+			 (state == MICRONUX_DISPLAY_STATE_REVEALING ||
+			  state == MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED))
+			micronux_native_fail_reveal_locked(dsi, "runtime-fault", -EIO, false);
 		mutex_unlock(&dsi->mode_lock);
 		return;
 	}
@@ -1169,6 +1370,156 @@ out:
 	mutex_unlock(&dsi->mode_lock);
 }
 
+static ssize_t micronux_native_boot_ready_store(struct micronux_dsi *dsi,
+						const char *buf, size_t count)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	unsigned long flags;
+	u64 target_commit;
+	u8 reveal_command = handoff->display_control_reveal_command;
+	bool backlight_locked = false, ready;
+	int ret;
+
+	ret = kstrtobool(buf, &ready);
+	if (ret)
+		return ret;
+	if (!ready)
+		return -EINVAL;
+
+	mutex_lock(&dsi->mode_lock);
+	if (READ_ONCE(dsi->boot_ready_consumed)) {
+		ret = -EALREADY;
+		goto unlock_mode;
+	}
+	if (READ_ONCE(dsi->display_state) !=
+	    MICRONUX_DISPLAY_STATE_SCANOUT_QUALIFIED_QUIESCENT) {
+		ret = -EAGAIN;
+		goto unlock_mode;
+	}
+	WRITE_ONCE(dsi->boot_ready_consumed, true);
+	WRITE_ONCE(dsi->native_dark_confirmed, false);
+	WRITE_ONCE(dsi->native_preserve_source, true);
+	/* A published lit-capable state always has preserve-until-dark armed. */
+	smp_wmb();
+	WRITE_ONCE(dsi->display_state, MICRONUX_DISPLAY_STATE_REVEALING);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:REVEAL state=REVEALING trigger=boot_ready source=framebuffer backlight=unregistered touch=unregistered i2c=released physical-panel-state=unobserved\n");
+
+	/* Do not hold render_lock while synchronously canceling its delayed user. */
+	cancel_delayed_work_sync(&dsi->render_work);
+	mutex_lock(&dsi->render_lock);
+	micronux_commit_render_locked(dsi);
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	target_commit = dsi->queued_index >= 0 ?
+		dsi->buffer_commit_sequence[dsi->queued_index] :
+		dsi->front_commit_sequence;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+	if (target_commit <= dsi->dark_baseline_commit_sequence) {
+		ret = -ENODATA;
+		goto fail_render;
+	}
+	ret = micronux_native_requalify_front(dsi, target_commit);
+	if (ret)
+		goto fail_render;
+
+	WRITE_ONCE(dsi->native_i2c_transition_deadline,
+		   jiffies +
+		   msecs_to_jiffies(MICRONUX_NATIVE_I2C_TRANSITION_MS));
+	/* Publish the deadline before the timer can observe TRANSITION. */
+	smp_wmb();
+	WRITE_ONCE(dsi->native_i2c_state,
+		   MICRONUX_NATIVE_I2C_TRANSITION);
+	ret = micronux_cold_i2c_initialize(dsi);
+	if (ret)
+		goto fail_render;
+	WRITE_ONCE(dsi->native_i2c_state,
+		   MICRONUX_NATIVE_I2C_ACTIVE_SERIALIZED);
+	if (!micronux_native_runtime_policy_valid(dsi)) {
+		ret = -EIO;
+		goto fail_render;
+	}
+	ret = micronux_register_native_backlight(dsi);
+	if (ret)
+		goto fail_render;
+	mutex_lock(&dsi->backlight->ops_lock);
+	backlight_locked = true;
+	/* Reject core blank/suspend state, then erase rejected cached writes. */
+	if (dsi->backlight->props.state) {
+		ret = -EBUSY;
+		goto fail_render;
+	}
+	dsi->backlight->props.brightness = handoff->backlight_brightness;
+	dsi->backlight->props.power = FB_BLANK_POWERDOWN;
+	if (!micronux_native_final_status_clean(dsi)) {
+		ret = -EIO;
+		goto fail_render;
+	}
+
+	/* PWM is still the ACKed zero from Stage B; reveal control comes first. */
+	WRITE_ONCE(dsi->native_reveal_may_be_lit, true);
+	/* Publish possible illumination before the external gate write. */
+	smp_wmb();
+	ret = micronux_native_write_control(dsi, reveal_command);
+	if (ret)
+		goto fail_render;
+	WRITE_ONCE(dsi->backlight_gate_enabled, true);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:REVEAL stage=control state=ACKED command=0x17 pwm=0 physical-panel-state=unobserved\n");
+	if (!micronux_native_final_status_clean(dsi)) {
+		ret = -EIO;
+		goto fail_render;
+	}
+	ret = micronux_native_write_pwm(dsi, handoff->backlight_brightness);
+	if (ret)
+		goto fail_render;
+	WRITE_ONCE(dsi->applied_brightness,
+		   handoff->backlight_brightness);
+	dsi->backlight->props.brightness = handoff->backlight_brightness;
+	dsi->backlight->props.power = FB_BLANK_UNBLANK;
+	if (!micronux_native_final_status_clean(dsi)) {
+		ret = -EIO;
+		goto fail_render;
+	}
+	ret = sysfs_create_group(&dsi->dev->kobj,
+				 &micronux_native_runtime_group);
+	if (ret)
+		goto fail_render;
+	dsi->native_runtime_group_created = true;
+	if (!micronux_native_final_status_clean(dsi)) {
+		ret = -EIO;
+		goto fail_render;
+	}
+	WRITE_ONCE(dsi->boot_display_ready, true);
+	WRITE_ONCE(dsi->render_enabled, true);
+	/* Publish ready/render gates before the terminal runtime state. */
+	smp_wmb();
+	WRITE_ONCE(dsi->display_state,
+		   MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED);
+	mutex_unlock(&dsi->backlight->ops_lock);
+	backlight_locked = false;
+	mutex_unlock(&dsi->render_lock);
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:REVEAL state=RUNTIME_REVEALED boot-ready=1 source=userspace-status commit=%llu frames=4 same-front=yes control-command=0x17-acked pwm-command=63-acked brightness=63 backlight=registered i2c=active-serialized touch=registering health=monitored physical-panel-state=unobserved\n",
+		 (unsigned long long)target_commit);
+	schedule_work(&dsi->touch_register_work);
+	mutex_unlock(&dsi->mode_lock);
+	return count;
+
+fail_render:
+	if (backlight_locked)
+		mutex_unlock(&dsi->backlight->ops_lock);
+	mutex_unlock(&dsi->render_lock);
+	if (READ_ONCE(dsi->native_reveal_may_be_lit)) {
+		micronux_native_fail_reveal_locked(dsi, "boot-ready", ret, false);
+	} else {
+		micronux_native_unregister_runtime_objects(dsi);
+		micronux_cold_runtime_fail_quiescent(dsi, "boot-ready-dark", ret);
+	}
+unlock_mode:
+	mutex_unlock(&dsi->mode_lock);
+	return ret;
+}
+
 static const struct backlight_ops micronux_backlight_ops = {
