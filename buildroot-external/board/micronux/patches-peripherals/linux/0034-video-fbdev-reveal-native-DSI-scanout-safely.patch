+	WRITE_ONCE(dsi->render_enabled, false);
+	WRITE_ONCE(dsi->boot_display_ready, false);
+	/* Revoke runtime callbacks before serializing the external off sequence. */
+	smp_wmb();
+	WRITE_ONCE(dsi->display_state, MICRONUX_DISPLAY_STATE_REVEALING);
+	dark = micronux_native_off_first(dsi, &pwm_ret, &control_ret);
+	if (!dark && !force_teardown) {
+		micronux_native_unregister_runtime_objects(dsi);
+		WRITE_ONCE(dsi->cold_runtime_unverified, true);
+		WRITE_ONCE(dsi->display_state,
+			   MICRONUX_DISPLAY_STATE_FAILED_UNVERIFIED);
+		dev_err(dsi->dev,
+			"MICRONUX:M9.2:REVEAL state=FAILED_UNVERIFIED stage=%s error=%d pwm-zero-command=%s reset-prepare-command=%s source=preserved scanout=%s darkness=not-confirmed physical-panel-state=unobserved retry=reboot-only\n",
+			stage, error, pwm_ret ? "failed" : "acked",
+			control_ret ? "failed" : "acked",
+			READ_ONCE(dsi->native_source_rearm_unverified) ?
+			"rearm-unverified" : "advancing");
+		return;
