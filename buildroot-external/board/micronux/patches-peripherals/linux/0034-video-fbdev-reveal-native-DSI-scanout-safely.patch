+		/* Keep channel zero signaling live while containing only the source. */
+		writel(0, channel + DW_GDMA_CH_INT_SIGNAL_ENA);
+		status0 = readl(channel + DW_GDMA_CH_INT_STATUS);
+		status1 = readl(channel + DW_GDMA_CH_INT_STATUS1);
+		writel(status0, channel + DW_GDMA_CH_INT_CLEAR);
+		writel(status1, channel + DW_GDMA_CH_INT_CLEAR1);
+		readl(channel + DW_GDMA_CH_INT_STATUS1);
+		if (readl(dsi->gdma + DW_GDMA_INT_STATUS) & BIT(index))
+			contained = false;
+	}
+	return contained;
+}
