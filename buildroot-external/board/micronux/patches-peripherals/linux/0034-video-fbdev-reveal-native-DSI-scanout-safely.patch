+static bool
+micronux_native_off_first(struct micronux_dsi *dsi, int *pwm_ret,
+			  int *control_ret)
+{
+	struct micronux_display_handoff_v3 *handoff = &dsi->cold_handoff;
+	struct backlight_device *backlight = dsi->backlight;
+	u8 command = handoff->display_control_reset_prepare_command;
+	bool locked = false;
+
+	*pwm_ret = -ENODEV;
+	*control_ret = -ENODEV;
+	if (READ_ONCE(dsi->native_i2c_state) !=
+	    MICRONUX_NATIVE_I2C_ACTIVE_SERIALIZED || !dsi->cold_i2c_active)
+		return false;
+	if (backlight) {
+		mutex_lock(&backlight->ops_lock);
+		locked = true;
+	}
+	*pwm_ret = micronux_i2c_write_reg8(dsi, handoff->i2c_address,
+					   handoff->backlight_register, 0);
+	if (!*pwm_ret)
+		WRITE_ONCE(dsi->applied_brightness, 0);
+	*control_ret = micronux_native_write_control(dsi, command);
+	if (!*control_ret)
+		WRITE_ONCE(dsi->backlight_gate_enabled, false);
+	if (backlight) {
+		backlight->props.brightness = 0;
+		backlight->props.power = FB_BLANK_POWERDOWN;
+	}
+	if (*pwm_ret || *control_ret) {
+		if (locked)
+			mutex_unlock(&backlight->ops_lock);
+		return false;
+	}
+	msleep(handoff->pwm_zero_settle_ms);
+	WRITE_ONCE(dsi->native_dark_confirmed, true);
+	/* The source may stop only after both external off writes and settle. */
+	smp_wmb();
+	WRITE_ONCE(dsi->native_preserve_source, false);
+	if (locked)
+		mutex_unlock(&backlight->ops_lock);
+	return true;
+}
