+		return i2c_state == MICRONUX_NATIVE_I2C_RELEASED &&
+		       micronux_cold_i2c_released(dsi);
+	if (display_state == MICRONUX_DISPLAY_STATE_REVEALING &&
+	    i2c_state == MICRONUX_NATIVE_I2C_RELEASED)
+		return micronux_cold_i2c_released(dsi);
+	if (display_state == MICRONUX_DISPLAY_STATE_REVEALING &&
+	    i2c_state == MICRONUX_NATIVE_I2C_TRANSITION)
+		return time_before_eq(jiffies,
+			READ_ONCE(dsi->native_i2c_transition_deadline));
+	if ((display_state == MICRONUX_DISPLAY_STATE_REVEALING ||
+	     display_state == MICRONUX_DISPLAY_STATE_RUNTIME_REVEALED) &&
+	    i2c_state == MICRONUX_NATIVE_I2C_ACTIVE_SERIALIZED) {
+		if (micronux_cold_i2c_calculate_timing(&timing))
+			return false;
+		return dsi->cold_i2c_active &&
+		       micronux_i2c_matches(dsi, &timing);
+	}
+	return false;
+}
