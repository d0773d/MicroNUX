+static void micronux_native_unregister_runtime_objects(struct micronux_dsi *dsi)
+{
+	if (dsi->native_runtime_group_created) {
+		sysfs_remove_group(&dsi->dev->kobj,
+				   &micronux_native_runtime_group);
+		dsi->native_runtime_group_created = false;
+	}
+	if (dsi->touch) {
+		input_unregister_device(dsi->touch);
+		dsi->touch = NULL;
+	}
+	if (dsi->native_backlight_registered && dsi->backlight) {
+		devm_backlight_device_unregister(dsi->dev, dsi->backlight);
+		dsi->backlight = NULL;
+		dsi->native_backlight_registered = false;
+	}
+}
