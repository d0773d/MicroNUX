+static void micronux_native_fail_reveal_locked(struct micronux_dsi *dsi,
+					       const char *stage, int error,
+					       bool force_teardown)
+{
+	bool contained = false, dark, dsi_off, i2c_released, ldo_off;
+	bool runtime_off;
+	int control_ret, pwm_ret;
