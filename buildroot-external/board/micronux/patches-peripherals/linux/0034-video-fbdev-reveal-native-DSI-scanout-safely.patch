+static int
+micronux_native_requalify_front(struct micronux_dsi *dsi, u64 target)
+{
+	unsigned long flags;
+	u64 presented_commit;
+	u32 base, generation;
+	unsigned long timeout;
+	u8 presented;
+	long waited;
+
+	timeout = msecs_to_jiffies(MICRONUX_NATIVE_REVEAL_TIMEOUT_MS);
+	waited = wait_event_timeout(dsi->frame_wait, native_target_ready(dsi, target), timeout);
+	if (!waited || READ_ONCE(dsi->fault_bits))
+		return waited ? -EIO : -ETIMEDOUT;
+
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	presented = dsi->presented_index;
+	presented_commit = dsi->presented_commit_sequence;
+	base = dsi->source_generation;
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+	if (presented_commit < target ||
+	    target <= dsi->dark_baseline_commit_sequence)
+		return -ESTALE;
+
+	waited = wait_event_timeout(dsi->frame_wait, native_window_ready(dsi, base), timeout);
+	if (!waited || READ_ONCE(dsi->fault_bits))
+		return waited ? -EIO : -ETIMEDOUT;
+
+	spin_lock_irqsave(&dsi->state_lock, flags);
+	generation = dsi->source_generation;
+	if (dsi->presented_index != presented ||
+	    dsi->presented_commit_sequence != presented_commit ||
+	    dsi->front_index != presented ||
+	    dsi->front_commit_sequence != presented_commit ||
+	    dsi->queued_index >= 0) {
+		spin_unlock_irqrestore(&dsi->state_lock, flags);
+		return -ESTALE;
+	}
+	spin_unlock_irqrestore(&dsi->state_lock, flags);
+	if (generation - base < MICRONUX_SCANOUT_STABLE_FRAMES ||
+	    !micronux_native_final_status_clean(dsi))
+		return -EIO;
+	dev_info(dsi->dev,
+		 "MICRONUX:M9.2:REVEAL state=QUALIFIED source=userspace-status commit=%llu front=%u frames=4 same-front=yes host-errors=0 gdma-errors=0 ecc-errors=0 common-errors=0 bridge-underruns=0 guards=verified external-command-history=pwm0-control13-acked physical-panel-state=unobserved\n",
+		 (unsigned long long)presented_commit, presented);
+	return 0;
+}
