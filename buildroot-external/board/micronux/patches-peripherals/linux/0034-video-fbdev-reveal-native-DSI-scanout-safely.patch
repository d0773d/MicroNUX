+static bool
+micronux_native_contain_inactive_irqs(struct micronux_dsi *dsi, u32 top)
+{
+	bool contained = !(top & ~(DW_GDMA_INT_TOP_ALLOWED |
+					 DW_GDMA_INT_TOP_INACTIVE));
