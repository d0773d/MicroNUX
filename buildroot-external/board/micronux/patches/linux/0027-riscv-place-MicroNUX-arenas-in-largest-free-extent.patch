From 0a16541d4d86907f1017c21ea59a76824304a96f Mon Sep 17 00:00:00 2001
From: MicroNUX <micronux@users.noreply.github.com>
Date: Sun, 9 Aug 2026 12:41:07 -0700
Subject: [PATCH] riscv: place MicroNUX arenas in largest free extent

Short-lived processes can leave small holes below the free tail of the
reserved user pool.  First-fit placement can put a new arena into one of
those holes and prevent it from growing even while most pool pages remain
free.

Choose the beginning of the largest free extent while holding the pool
lock.  This preserves the one-contiguous-arena invariant and gives a new
process the largest available grow-only range without exposing or reserving
unused pages.

Signed-off-by: MicroNUX <micronux@users.noreply.github.com>
---
 arch/riscv/mm/micronux_user_pool.c | 32 +++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/mm/micronux_user_pool.c b/arch/riscv/mm/micronux_user_pool.c
index 8e1694c..a882103 100644
--- a/arch/riscv/mm/micronux_user_pool.c
+++ b/arch/riscv/mm/micronux_user_pool.c
@@ -132,6 +132,34 @@ unsigned long micronux_user_pool_free_pages(void)
 	return free_pages;
 }
 
+static unsigned long micronux_user_largest_free_extent(unsigned long nr_pages)
+{
+	unsigned long best_pages = 0;
+	unsigned long best_start = micronux_user_pages;
+	unsigned long cursor = 0;
+
+	while (cursor < micronux_user_pages) {
+		unsigned long end;
+		unsigned long start;
+
+		start = find_next_zero_bit(micronux_user_reserved,
+					   micronux_user_pages, cursor);
+		if (start >= micronux_user_pages)
+			break;
+		end = find_next_bit(micronux_user_reserved,
+				    micronux_user_pages, start);
+		if (end - start > best_pages) {
+			best_pages = end - start;
+			best_start = start;
+		}
+		if (end >= micronux_user_pages)
+			break;
+		cursor = end + 1;
+	}
+
+	return best_pages >= nr_pages ? best_start : micronux_user_pages;
+}
+
 int micronux_user_arena_prepare(struct mm_struct *mm, unsigned long bytes)
 {
 	struct micronux_user_arena *arena;
@@ -161,9 +189,7 @@ int micronux_user_arena_prepare(struct mm_struct *mm, unsigned long bytes)
 		kfree(arena);
 		return -EBUSY;
 	}
-	index = bitmap_find_next_zero_area(micronux_user_reserved,
-					   micronux_user_pages, 0,
-					   nr_pages, 0);
+	index = micronux_user_largest_free_extent(nr_pages);
 	if (index >= micronux_user_pages ||
 	    nr_pages > micronux_user_pages - index) {
 		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
-- 
