From 87f548c848c46a2147b23a73ad9b612391526ce4 Mon Sep 17 00:00:00 2001
From: MicroNUX Project <micronux@example.invalid>
Date: Sun, 9 Aug 2026 09:00:00 -0700
Subject: [PATCH] riscv: add ESP32-P4 reserved user pool

The ESP32-P4 NOMMU kernel currently obtains userspace mappings from the same
buddy allocator as kernel data.  A PMP overlay cannot distinguish those pages
without also exposing adjacent kernel allocations.

Add an opt-in, single-core MicroNUX isolation profile and a deterministic
page-granularity allocator backed by the exact reserved-memory interval in the
M7 device tree.  The allocator never falls back to kernel RAM and zeroes a
range before returning it for userspace use.

Signed-off-by: MicroNUX Project <micronux@example.invalid>
---
 arch/riscv/Kconfig.socs                         |  14 +++
 arch/riscv/include/asm/micronux_user_pool.h     |  14 +++
 arch/riscv/mm/Makefile                          |   1 +
 arch/riscv/mm/micronux_user_pool.c              | 171 ++++++++++++++++++++++++
 4 files changed, 200 insertions(+)
 create mode 100644 arch/riscv/include/asm/micronux_user_pool.h
 create mode 100644 arch/riscv/mm/micronux_user_pool.c

diff --git a/arch/riscv/Kconfig.socs b/arch/riscv/Kconfig.socs
index 181835fa29af..b03822ee5318 100644
--- a/arch/riscv/Kconfig.socs
+++ b/arch/riscv/Kconfig.socs
@@ -26,6 +26,20 @@ config SOC_ESP32P4
 	  RISC-V core.  The implementation targets the revision 1.3 CLIC and
 	  CLINT register layout.
 
+config MICRONUX_ESP32P4_ISOLATION
+	bool "MicroNUX ESP32-P4 NOMMU user isolation"
+	depends on SOC_ESP32P4 && RISCV_M_MODE && !MMU && !SMP
+	depends on OF_RESERVED_MEM && BINFMT_FLAT
+	help
+	  Reserve a device-tree-defined PSRAM pool for every mapping visible to
+	  U-mode.  The pool is excluded from the kernel buddy allocator and is
+	  managed with a deterministic, page-granularity first-fit allocator.
+
+	  This option is only one part of the MicroNUX isolation contract.  It
+	  must be paired with the version-pinned ESP-IDF PMP baseline, the
+	  M-to-U return overlay, checked user pointers, and the physical fault
+	  tests.  Keep SMP disabled because PMP state is per hart.
+
 config ARCH_SIFIVE
 	bool "SiFive SoCs"
 	select ERRATA_SIFIVE if !XIP_KERNEL
diff --git a/arch/riscv/include/asm/micronux_user_pool.h b/arch/riscv/include/asm/micronux_user_pool.h
new file mode 100644
index 000000000000..bb43e572148e
--- /dev/null
+++ b/arch/riscv/include/asm/micronux_user_pool.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_MICRONUX_USER_POOL_H
+#define _ASM_RISCV_MICRONUX_USER_POOL_H
+
+#include <linux/types.h>
+
+void *micronux_user_pool_alloc(unsigned long nr_pages);
+bool micronux_user_pool_free(unsigned long start, unsigned long end);
+bool micronux_user_pool_contains(unsigned long start, unsigned long end);
+bool micronux_user_pool_ready(void);
+unsigned long micronux_user_pool_free_pages(void);
+void micronux_user_pool_bounds(unsigned long *start, unsigned long *end);
+
+#endif /* _ASM_RISCV_MICRONUX_USER_POOL_H */
diff --git a/arch/riscv/mm/Makefile b/arch/riscv/mm/Makefile
index cbe4d3a4b4ea..de9a380c1156 100644
--- a/arch/riscv/mm/Makefile
+++ b/arch/riscv/mm/Makefile
@@ -10,6 +10,7 @@ KCOV_INSTRUMENT_init.o := n
 
 obj-y += init.o
 obj-$(CONFIG_MMU) += extable.o fault.o pageattr.o pgtable.o tlbflush.o
+obj-$(CONFIG_MICRONUX_ESP32P4_ISOLATION) += micronux_user_pool.o
 obj-y += cacheflush.o
 obj-y += context.o
 obj-y += pmem.o
diff --git a/arch/riscv/mm/micronux_user_pool.c b/arch/riscv/mm/micronux_user_pool.c
new file mode 100644
index 000000000000..b17c63ebf2f4
--- /dev/null
+++ b/arch/riscv/mm/micronux_user_pool.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Dedicated U-mode mapping pool for the MicroNUX ESP32-P4 NOMMU profile. */
+
+#include <linux/bitmap.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/overflow.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#include <asm/page.h>
+#include <asm/micronux_user_pool.h>
+
+#define MICRONUX_USER_POOL_START	0x49700000UL
+#define MICRONUX_USER_POOL_SIZE		SZ_8M
+#define MICRONUX_USER_POOL_END		(MICRONUX_USER_POOL_START + \
+					 MICRONUX_USER_POOL_SIZE)
+#define MICRONUX_USER_POOL_MAX_PAGES	(MICRONUX_USER_POOL_SIZE / PAGE_SIZE)
+
+static DECLARE_BITMAP(micronux_user_bitmap,
+			      MICRONUX_USER_POOL_MAX_PAGES);
+static DEFINE_SPINLOCK(micronux_user_pool_lock);
+static unsigned long micronux_user_start;
+static unsigned long micronux_user_end;
+static unsigned long micronux_user_pages;
+static unsigned long micronux_user_used_pages;
+static bool micronux_pool_is_ready;
+
+static int __init micronux_user_pool_init(struct reserved_mem *rmem)
+{
+	phys_addr_t end;
+
+	if (check_add_overflow(rmem->base, rmem->size, &end) ||
+	    rmem->base != MICRONUX_USER_POOL_START ||
+	    rmem->size != MICRONUX_USER_POOL_SIZE ||
+	    end != MICRONUX_USER_POOL_END ||
+	    !IS_ALIGNED(rmem->base, PAGE_SIZE) ||
+	    !IS_ALIGNED(rmem->size, PAGE_SIZE)) {
+		pr_err("MICRONUX:M7:POOL state=fail base=%pa size=%pa\n",
+		       &rmem->base, &rmem->size);
+		return -EINVAL;
+	}
+
+	micronux_user_start = (unsigned long)rmem->base;
+	micronux_user_end = (unsigned long)end;
+	micronux_user_pages = rmem->size >> PAGE_SHIFT;
+	bitmap_zero(micronux_user_bitmap, MICRONUX_USER_POOL_MAX_PAGES);
+	micronux_pool_is_ready = true;
+
+	pr_info("MICRONUX:M7:POOL state=ready range=[%08lx,%08lx) pages=%lu zero=on-allocate\n",
+		micronux_user_start, micronux_user_end,
+		micronux_user_pages);
+	return 0;
+}
+RESERVEDMEM_OF_DECLARE(micronux_esp32p4_user_pool,
+			       "micronux,esp32p4-user-pool",
+			       micronux_user_pool_init);
+
+bool micronux_user_pool_ready(void)
+{
+	return READ_ONCE(micronux_pool_is_ready);
+}
+
+void micronux_user_pool_bounds(unsigned long *start, unsigned long *end)
+{
+	*start = READ_ONCE(micronux_user_start);
+	*end = READ_ONCE(micronux_user_end);
+}
+
+bool micronux_user_pool_contains(unsigned long start, unsigned long end)
+{
+	if (!micronux_user_pool_ready() || start > end)
+		return false;
+
+	return start >= READ_ONCE(micronux_user_start) &&
+	       end <= READ_ONCE(micronux_user_end);
+}
+
+unsigned long micronux_user_pool_free_pages(void)
+{
+	unsigned long flags;
+	unsigned long free_pages;
+
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	free_pages = micronux_user_pages - micronux_user_used_pages;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+	return free_pages;
+}
+
+void *micronux_user_pool_alloc(unsigned long nr_pages)
+{
+	unsigned long flags;
+	unsigned long index;
+	void *result;
+
+	if (!micronux_user_pool_ready() || !nr_pages ||
+	    nr_pages > micronux_user_pages)
+		return NULL;
+
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	index = bitmap_find_next_zero_area(micronux_user_bitmap,
+					  micronux_user_pages, 0,
+					  nr_pages, 0);
+	if (index >= micronux_user_pages ||
+	    nr_pages > micronux_user_pages - index) {
+		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+		return NULL;
+	}
+	bitmap_set(micronux_user_bitmap, index, nr_pages);
+	micronux_user_used_pages += nr_pages;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+
+	result = (void *)(micronux_user_start + (index << PAGE_SHIFT));
+	memset(result, 0, nr_pages << PAGE_SHIFT);
+	return result;
+}
+
+bool micronux_user_pool_free(unsigned long start, unsigned long end)
+{
+	unsigned long flags;
+	unsigned long first;
+	unsigned long nr_pages;
+	unsigned long clear;
+
+	if (!micronux_user_pool_contains(start, end) || start == end ||
+	    !IS_ALIGNED(start, PAGE_SIZE) || !IS_ALIGNED(end, PAGE_SIZE))
+		return false;
+
+	first = (start - micronux_user_start) >> PAGE_SHIFT;
+	nr_pages = (end - start) >> PAGE_SHIFT;
+
+	spin_lock_irqsave(&micronux_user_pool_lock, flags);
+	clear = find_next_zero_bit(micronux_user_bitmap,
+				   first + nr_pages, first);
+	if (clear < first + nr_pages ||
+	    nr_pages > micronux_user_used_pages) {
+		spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+		return false;
+	}
+	bitmap_clear(micronux_user_bitmap, first, nr_pages);
+	micronux_user_used_pages -= nr_pages;
+	spin_unlock_irqrestore(&micronux_user_pool_lock, flags);
+	return true;
+}
+
+static int micronux_user_pool_proc_show(struct seq_file *file, void *unused)
+{
+	unsigned long free_pages;
+
+	free_pages = micronux_user_pool_free_pages();
+	seq_printf(file,
+		   "MICRONUX:M7:POOL range=[%08lx,%08lx) pages=%lu used=%lu free=%lu\n",
+		   micronux_user_start, micronux_user_end, micronux_user_pages,
+		   micronux_user_pages - free_pages, free_pages);
+	return 0;
+}
+
+static int __init micronux_user_pool_proc_init(void)
+{
+	if (!micronux_user_pool_ready())
+		return -ENODEV;
+	if (!proc_create_single("micronux_user_pool", 0400, NULL,
+				micronux_user_pool_proc_show))
+		return -ENOMEM;
+	return 0;
+}
+fs_initcall(micronux_user_pool_proc_init);
-- 
