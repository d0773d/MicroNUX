From c65a9259ae97acad1b6095c57868f30b47ae53ca Mon Sep 17 00:00:00 2001
From: MicroNUX <micronux@example.invalid>
Date: Sun, 9 Aug 2026 09:48:00 -0700
Subject: [PATCH] riscv: bound MicroNUX user pointers

Replace NOMMU access_ok permissiveness with bounds stored in each mm context. Initialize those bounds fail-closed from the reserved pool contract and reject overflow or any pointer outside the currently authorized user interval.

Signed-off-by: MicroNUX <micronux@example.invalid>
---
 .../include/asm/micronux_user_isolation.h     | 16 ++++++++++++
 arch/riscv/include/asm/micronux_user_pool.h   |  2 ++
 arch/riscv/include/asm/mmu.h                  |  5 ++++
 arch/riscv/include/asm/mmu_context.h          | 17 ++++++++++++
 arch/riscv/include/asm/uaccess.h              |  5 ++++
 arch/riscv/mm/micronux_user_pool.c            | 26 +++++++++++++++----
 6 files changed, 66 insertions(+), 5 deletions(-)
 create mode 100644 arch/riscv/include/asm/micronux_user_isolation.h

diff --git a/arch/riscv/include/asm/micronux_user_isolation.h b/arch/riscv/include/asm/micronux_user_isolation.h
new file mode 100644
index 0000000..6dab28b
--- /dev/null
+++ b/arch/riscv/include/asm/micronux_user_isolation.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_MICRONUX_USER_ISOLATION_H
+#define _ASM_RISCV_MICRONUX_USER_ISOLATION_H
+
+#include <linux/types.h>
+
+#define MICRONUX_LINUX_START		0x48400000UL
+#define MICRONUX_USER_POOL_START	0x49700000UL
+#define MICRONUX_USER_POOL_END		0x49f00000UL
+#define MICRONUX_LINUX_END		MICRONUX_USER_POOL_END
+#define MICRONUX_PMP_GRANULARITY	128UL
+
+bool micronux_user_access_ok(unsigned long addr, unsigned long size);
+void micronux_user_pmp_prepare_return(void);
+
+#endif /* _ASM_RISCV_MICRONUX_USER_ISOLATION_H */
diff --git a/arch/riscv/include/asm/micronux_user_pool.h b/arch/riscv/include/asm/micronux_user_pool.h
index 0e628b1..269d663 100644
--- a/arch/riscv/include/asm/micronux_user_pool.h
+++ b/arch/riscv/include/asm/micronux_user_pool.h
@@ -4,6 +4,8 @@
 
 #include <linux/types.h>
 
+#include <asm/micronux_user_isolation.h>
+
 void *micronux_user_pool_alloc(unsigned long nr_pages);
 bool micronux_user_pool_free(unsigned long start, unsigned long end);
 bool micronux_user_pool_contains(unsigned long start, unsigned long end);
diff --git a/arch/riscv/include/asm/mmu.h b/arch/riscv/include/asm/mmu.h
index c9e03e9..dcff4c4 100644
--- a/arch/riscv/include/asm/mmu.h
+++ b/arch/riscv/include/asm/mmu.h
@@ -12,6 +12,11 @@
 typedef struct {
 #ifndef CONFIG_MMU
 	unsigned long	end_brk;
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	unsigned long	user_lo;
+	unsigned long	user_hi;
+	bool		user_bounds_valid;
+#endif
 #else
 	atomic_long_t id;
 #endif
diff --git a/arch/riscv/include/asm/mmu_context.h b/arch/riscv/include/asm/mmu_context.h
index 7030837..9bea559 100644
--- a/arch/riscv/include/asm/mmu_context.h
+++ b/arch/riscv/include/asm/mmu_context.h
@@ -13,6 +13,11 @@
 #include <linux/mm.h>
 #include <linux/sched.h>
 
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+#include <asm/micronux_user_isolation.h>
+#include <asm/micronux_user_pool.h>
+#endif
+
 void switch_mm(struct mm_struct *prev, struct mm_struct *next,
 	struct task_struct *task);
 
@@ -29,6 +34,18 @@ static inline int init_new_context(struct task_struct *tsk,
 {
 #ifdef CONFIG_MMU
 	atomic_long_set(&mm->context.id, 0);
+#endif
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+	mm->context.user_lo = 0;
+	mm->context.user_hi = 0;
+	mm->context.user_bounds_valid = false;
+	if (micronux_user_pool_ready()) {
+		micronux_user_pool_bounds(&mm->context.user_lo,
+					  &mm->context.user_hi);
+		mm->context.user_bounds_valid =
+			mm->context.user_lo == MICRONUX_USER_POOL_START &&
+			mm->context.user_hi == MICRONUX_USER_POOL_END;
+	}
 #endif
 	return 0;
 }
diff --git a/arch/riscv/include/asm/uaccess.h b/arch/riscv/include/asm/uaccess.h
index 72ec1d9..7ac96c9 100644
--- a/arch/riscv/include/asm/uaccess.h
+++ b/arch/riscv/include/asm/uaccess.h
@@ -336,6 +336,11 @@ do {									\
 } while (0)
 
 #else /* CONFIG_MMU */
+#ifdef CONFIG_MICRONUX_ESP32P4_ISOLATION
+#include <asm/micronux_user_isolation.h>
+#define __access_ok(ptr, size) \
+	micronux_user_access_ok((unsigned long)(ptr), (unsigned long)(size))
+#endif
 #include <asm-generic/uaccess.h>
 #endif /* CONFIG_MMU */
 #endif /* _ASM_RISCV_UACCESS_H */
diff --git a/arch/riscv/mm/micronux_user_pool.c b/arch/riscv/mm/micronux_user_pool.c
index 57e8a36..92b5d7a 100644
--- a/arch/riscv/mm/micronux_user_pool.c
+++ b/arch/riscv/mm/micronux_user_pool.c
@@ -7,18 +7,16 @@
 #include <linux/of_reserved_mem.h>
 #include <linux/overflow.h>
 #include <linux/proc_fs.h>
+#include <linux/sched.h>
 #include <linux/seq_file.h>
-#include <linux/sizes.h>
 #include <linux/spinlock.h>
 #include <linux/string.h>
 
 #include <asm/page.h>
 #include <asm/micronux_user_pool.h>
 
-#define MICRONUX_USER_POOL_START	0x49700000UL
-#define MICRONUX_USER_POOL_SIZE		SZ_8M
-#define MICRONUX_USER_POOL_END		(MICRONUX_USER_POOL_START + \
-					 MICRONUX_USER_POOL_SIZE)
+#define MICRONUX_USER_POOL_SIZE		(MICRONUX_USER_POOL_END - \
+					 MICRONUX_USER_POOL_START)
 #define MICRONUX_USER_POOL_MAX_PAGES	(MICRONUX_USER_POOL_SIZE / PAGE_SIZE)
 
 static DECLARE_BITMAP(micronux_user_bitmap,
@@ -80,6 +78,24 @@ bool micronux_user_pool_contains(unsigned long start, unsigned long end)
 	       end <= READ_ONCE(micronux_user_end);
 }
 
+bool micronux_user_access_ok(unsigned long addr, unsigned long size)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long lo;
+	unsigned long hi;
+
+	if (!mm || !READ_ONCE(mm->context.user_bounds_valid))
+		return false;
+	lo = READ_ONCE(mm->context.user_lo);
+	hi = READ_ONCE(mm->context.user_hi);
+	if (lo < MICRONUX_USER_POOL_START || hi > MICRONUX_USER_POOL_END ||
+	    lo >= hi || addr < lo || addr > hi)
+		return false;
+
+	/* addr == hi is valid only for an explicitly empty range. */
+	return size <= hi - addr;
+}
+
 unsigned long micronux_user_pool_free_pages(void)
 {
 	unsigned long flags;
-- 
2.43.0

