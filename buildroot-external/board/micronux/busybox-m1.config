# MicroNUX additions to Buildroot's Canaan K210 tiny NOMMU fragment.
# Keep only the services needed for a serial login and orderly shutdown.
CONFIG_LFS=y
# CONFIG_FEATURE_DEVPTS is not set
# CONFIG_FEATURE_UTMP is not set
# CONFIG_FEATURE_WTMP is not set
# CONFIG_FEATURE_SHOW_SCRIPT is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_SYSLOG is not set
# CONFIG_FLOAT_DURATION is not set
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set
# CONFIG_FEATURE_EDITING is not set
# CONFIG_FEATURE_PRESERVE_HARDLINKS is not set
# CONFIG_FEATURE_HUMAN_READABLE is not set

# Keep the M1 command set deliberately small. Shell builtins provide echo,
# printf, test, and true/false without separate applet execution.
# CONFIG_BASENAME is not set
# CONFIG_CAT is not set
# CONFIG_CHGRP is not set
# CONFIG_CHMOD is not set
# CONFIG_CHOWN is not set
# CONFIG_CHROOT is not set
# CONFIG_CRC32 is not set
# CONFIG_CP is not set
# CONFIG_CUT is not set
# CONFIG_DATE is not set
# CONFIG_DD is not set
# CONFIG_DF is not set
# CONFIG_DIRNAME is not set
# CONFIG_ECHO is not set
# CONFIG_ENV is not set
# CONFIG_EXPR is not set
# CONFIG_FALSE is not set
# CONFIG_HOSTID is not set
# CONFIG_ID is not set
# CONFIG_LN is not set
# CONFIG_LS is not set
# CONFIG_MKDIR is not set
# CONFIG_MKNOD is not set
# CONFIG_MV is not set
# CONFIG_NPROC is not set
# CONFIG_PRINTENV is not set
# CONFIG_PRINTF is not set
# CONFIG_PWD is not set
# CONFIG_READLINK is not set
# CONFIG_REALPATH is not set
# CONFIG_RM is not set
# CONFIG_RMDIR is not set
# CONFIG_SEQ is not set
# CONFIG_SLEEP is not set
# CONFIG_STTY is not set
# CONFIG_SYNC is not set
# CONFIG_TEST is not set
# CONFIG_TOUCH is not set
# CONFIG_TRUE is not set
# CONFIG_TRUNCATE is not set
# CONFIG_TSORT is not set
# CONFIG_TTY is not set
# CONFIG_UNLINK is not set
# CONFIG_USLEEP is not set

CONFIG_HALT=y
CONFIG_POWEROFF=y
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_FEATURE_INIT_SYSLOG is not set
# CONFIG_FEATURE_SHADOWPASSWDS is not set
# CONFIG_USE_BB_CRYPT is not set
# CONFIG_USE_BB_CRYPT_SHA is not set
# CONFIG_GETTY is not set
# CONFIG_LOGIN is not set
# CONFIG_MOUNT is not set
# CONFIG_UMOUNT is not set
# CONFIG_HOSTNAME is not set
# CONFIG_DMESG is not set
# CONFIG_MORE is not set
# CONFIG_ASCII is not set
# CONFIG_GETFATTR is not set
# CONFIG_SEEDRNG is not set
# CONFIG_TREE is not set
# CONFIG_KILL is not set
# CONFIG_PS is not set

# Preserve POSIX control flow used by Buildroot's init scripts, but omit
# interactive luxuries and bash-only language extensions.
CONFIG_BASH_IS_NONE=y
# CONFIG_BASH_IS_HUSH is not set
# CONFIG_HUSH_BASH_COMPAT is not set
# CONFIG_HUSH_LINENO_VAR is not set
# CONFIG_HUSH_JOB is not set
# CONFIG_HUSH_FUNCTIONS is not set
# CONFIG_HUSH_RANDOM_SUPPORT is not set
# CONFIG_HUSH_MODE_X is not set
# CONFIG_HUSH_HELP is not set
# CONFIG_HUSH_EXPORT_N is not set
# CONFIG_HUSH_READONLY is not set
# CONFIG_HUSH_TYPE is not set
# CONFIG_HUSH_TIMES is not set
# CONFIG_HUSH_ULIMIT is not set
# CONFIG_HUSH_GETOPTS is not set
# CONFIG_FEATURE_SH_MATH is not set

# M1 proves execution rather than providing an editor/search environment.
# CONFIG_VI is not set
# CONFIG_GREP is not set
