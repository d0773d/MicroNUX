CONFIG_BLK_DEV_INITRD=y
# CONFIG_MMU is not set
CONFIG_SOC_ESP32P4=y
CONFIG_MICRONUX_ESP32P4_ISOLATION=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_BINFMT_FLAT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SLOB=y
# CONFIG_SMP is not set
CONFIG_PRINTK_TIME=y
CONFIG_HZ_100=y
CONFIG_DEVTMPFS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_FB=y
CONFIG_FB_ESP32P4_MICRONUX_DSI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x16=y
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
# CONFIG_MODULES is not set
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_CFG80211=n
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_RFKILL=y
# CONFIG_BT is not set
CONFIG_ESP_HOSTED_FG=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEBUG_FS=y
# CONFIG_DEVMEM is not set
CONFIG_CMDLINE="earlycon=esp32p4usb,mmio,0x500d2000 console=ttyGS0,115200 loglevel=8 rdinit=/init panic=1 nohlt"
CONFIG_CMDLINE_FORCE=y
