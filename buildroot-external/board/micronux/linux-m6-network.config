CONFIG_BLK_DEV_INITRD=y
# CONFIG_MMU is not set
CONFIG_SOC_ESP32P4=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_BINFMT_FLAT=y
CONFIG_SLOB=y
# CONFIG_SMP is not set
CONFIG_PRINTK_TIME=y
CONFIG_HZ_100=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
# CONFIG_MODULES is not set
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_CFG80211=n
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_RFKILL=y
# CONFIG_BT is not set
CONFIG_ESP_HOSTED_FG=y
CONFIG_DEBUG_FS=y
CONFIG_CMDLINE="console=ttyGS0,115200 earlycon=esp32p4,0x500d2000,115200 keep_bootcon panic=1"
